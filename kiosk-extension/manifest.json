{
  "manifest_version": 3,
  "name": "MastersOS 考试扩展 / MastersOS Exam",
  "description": "锁定会话的「求助」「退出」菜单与按应用的模拟环境 / Get help and Exit menu and per-app mock environments for MastersOS locked sessions",
  "version": "1.5.0",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://*.nwea.org/*", "https://*.mapnwea.org/*"],
  "storage": { "managed_schema": "schema.json" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.nwea.org/*", "https://*.mapnwea.org/*"],
      "js": ["mock/nwea/page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.nwea.org/*", "https://*.mapnwea.org/*"],
      "js": ["mock/nwea/relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
