{
  "manifest_version": 3,
  "name": "MastersOS 考试扩展 / MastersOS Exam",
  "description": "锁定会话的「求助」「退出」菜单、ChromeOS 伪装与注入脚本的起始页 / Get help and Exit menu, ChromeOS disguise and inject start page for MastersOS locked sessions",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "scripting", "declarativeNetRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.nwea.org/*", "https://*.mapnwea.org/*"],
      "js": ["mock/nwea/page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.nwea.org/*", "https://*.mapnwea.org/*"],
      "js": ["mock/nwea/relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
