msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Gerit per %s"

msgid "Shut down"
msgstr "Atudar"

msgid "Browse as Guest"
msgstr "Navegar coma convidat"

msgid "Add person"
msgstr "Apondre una persona"

msgid "Apps"
msgstr "Aplicacions"

msgid "Cancel"
msgstr "Anullar"

msgid "Retry"
msgstr "Tornar ensajar"

msgid "Opening the sign-in page…"
msgstr "Dobertura de la pagina de connexion…"

msgid "The sign-in page could not be opened."
msgstr "Impossible de dobrir la pagina de connexion."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Impossible de contactar l'escòla. Connectatz-vos al Wi-Fi dempuèi la barra de dessús, puèi tornatz ensajar."

msgid "School email"
msgstr "Corrièr electronic de l'escòla"

msgid "IT local account"
msgstr "Compte local informatic"

msgid "Username"
msgstr "Nom d'utilizaire"

msgid "This account cannot sign in on this computer."
msgstr "Aqueste compte se pòt pas connectar a aqueste ordenador."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Aqueste compte se pòt pas connectar a aqueste ordenador. Utilizatz vòstre corrièr electronic de l'escòla (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Vos sètz connectat amb un autre compte. Connectatz-vos tornamai amb lo compte causit aicí."

msgid "Language"
msgstr "Lenga"

msgid "Keyboard"
msgstr "Clavièr"

msgid "Continue"
msgstr "Contunhar"

msgid "The setting could not be saved. Try again."
msgstr "Impossible d'enregistrar lo paramètre. Tornatz ensajar."

msgid "Your account is disabled. Contact your administrator."
msgstr "Vòstre compte es desactivat. Contactatz vòstre administrator."

msgid "This device is disabled. Contact your administrator."
msgstr "Aqueste aparelh es desactivat. Contactatz vòstre administrator."

msgid "Sign in with your school account."
msgstr "Connectatz-vos amb vòstre compte de l'escòla."

msgid "Could not sign in. Please try again."
msgstr "Connexion impossibla. Tornatz ensajar."

msgid "Authentication request cancelled"
msgstr "Demanda d'autentificacion anullada"

msgid "Maximum number of authentication attempts reached"
msgstr "Nombre maximal de temptativas d'autentificacion atench"

msgid "Error retrieving access token. Please try again."
msgstr "Error en recuperant lo geton d'accès. Tornatz ensajar."

msgid "Invalid user name"
msgstr "Nom d'utilizaire invalid"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Aqueste ordenador es verrolhat per l'escòla; contactatz lo servici informatic"

msgid "Guest sign-in is not allowed on this computer"
msgstr "La connexion en convidat es pas autorizada sus aqueste ordenador"

msgid "Local accounts cannot sign in on this computer"
msgstr "Los comptes locals se pòdon pas connectar a aqueste ordenador"

msgid "School accounts cannot sign in on this computer"
msgstr "Los comptes de l'escòla se pòdon pas connectar a aqueste ordenador"

msgid "This app can only be opened from the sign-in screen"
msgstr "Aquesta aplicacion se pòt dobrir sonque dempuèi l'ecran de connexion"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Aquesta aplicacion a besonh d'un malhum. Connectatz-vos al Wi-Fi dempuèi la barra de dessús, puèi tornatz ensajar."
