"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s tarafından idare etilir"

msgid "Shut down"
msgstr "Qapat"

msgid "Browse as Guest"
msgstr "Misafir olaraq közden keçir"

msgid "Apps"
msgstr "Programmalar"

msgid "Cancel"
msgstr "Ret et"

msgid "Retry"
msgstr "Yañıdan sına"

msgid "Opening the sign-in page…"
msgstr "Kirüv saifesi açıla…"

msgid "The sign-in page could not be opened."
msgstr "Kirüv saifesini açmaq mümkün olmadı."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Mektepke bağlanmaq mümkün degil. Üst panelden Wi-Fi ağına bağlanıñız, soñra yañıdan sınañız."

msgid "Local manager"
msgstr "Yerli idareci"

msgid "Username"
msgstr "Qullanıcı adı"

msgid "This account cannot sign in on this computer."
msgstr "Bu hesap bu kompyuterge kire bilmey."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Bu hesap bu kompyuterge kire bilmey. Mektep e-poçtañıznı (%s) qullanıñız."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Başqa bir hesap ile kirdiñiz. Mında saylağan hesabıñız ile yañıdan kiriñiz."

msgid "Language"
msgstr "Til"

msgid "Keyboard"
msgstr "Klaviatura"

msgid "Continue"
msgstr "Devam et"

msgid "The setting could not be saved. Try again."
msgstr "Sazlama saqlanamadı. Yañıdan sınañız."

msgid "Your account is disabled. Contact your administrator."
msgstr "Hesabıñız ögrenilgen. İdarecige müracaat etiñiz."

msgid "This device is disabled. Contact your administrator."
msgstr "Bu cihaz ögrenilgen. İdarecige müracaat etiñiz."

msgid "Sign in with your school account."
msgstr "Mektep hesabıñız ile kiriñiz."

msgid "Could not sign in. Please try again."
msgstr "Kirmek mümkün olmadı. Lütfen, yañıdan sınañız."

msgid "Authentication request cancelled"
msgstr "Tasdiqlev talebi ret etildi"

msgid "Maximum number of authentication attempts reached"
msgstr "Tasdiqlev areketleriniñ eñ çoq sanına yetildi"

msgid "Error retrieving access token. Please try again."
msgstr "Kirüv token'ini alğanda hata çıqtı. Lütfen, yañıdan sınañız."

msgid "Invalid user name"
msgstr "Yañlış qullanıcı adı"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Bu kompyuter mektep tarafından qulüplengen; lütfen, IT ile bağlanıñız"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Bu kompyuterde misafir olaraq kirmege izin yoq"

msgid "Local accounts cannot sign in on this computer"
msgstr "Yerli hesaplar bu kompyuterge kire bilmey"

msgid "School accounts cannot sign in on this computer"
msgstr "Mektep hesapları bu kompyuterge kire bilmey"

msgid "This app can only be opened from the sign-in screen"
msgstr "Bu programma yalnız kirüv ekranından açıla bile"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Bu uygulama bir ağğa muhtaçtır. Üst panelden Wi-Fi ağına bağlanıñız, soñra yañıdan sınañız."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Ağ yoq. Yuqarı sağdaki menüden Wi-Fi ağına bağlanıñız."

msgid "Waiting for school settings."
msgstr "Mektep ayarları beklene."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Veb-brauzer qurula. Kirip olasıñız; azır olğanda peyda olur."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Veb-brauzer daa qurulıp olamadı; yañıdan sınalacaq. Kirip olasıñız."

msgid "Name or school email"
msgstr "Ad ya da mektep e-poçtası"

msgid "Keep typing to narrow down"
msgstr "Cedvelni tarlatmaq içün yazmağa devam etiñiz"
