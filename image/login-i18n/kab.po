msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: kab\n"

msgid "Managed by %s"
msgstr "Yettwaḍbel sɣur %s"

msgid "Shut down"
msgstr "Sens"

msgid "Browse as Guest"
msgstr "Inig am anebgi"

msgid "Apps"
msgstr "Isnasen"

msgid "Cancel"
msgstr "Sefsex"

msgid "Retry"
msgstr "Ɛreḍ i tikelt-nniḍen"

msgid "Opening the sign-in page…"
msgstr "Tuldit n usebter n unekcum…"

msgid "The sign-in page could not be opened."
msgstr "Ur izmir ara ad yettwaldi usebter n unekcum."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ur izmir ara ad yaweḍ ɣer uɣerbaz. Qqen ɣer Wi-Fi seg ufeggag n ufella, sakin ɛreḍ i tikelt-nniḍen."

msgid "Local manager"
msgstr "Anedbal adigan"

msgid "Username"
msgstr "Isem n useqdac"

msgid "This account cannot sign in on this computer."
msgstr "Amiḍan-agi ur izmir ara ad yekcem ɣer uselkim-agi."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Amiḍan-agi ur izmir ara ad yekcem ɣer uselkim-agi. Seqdec imayl n uɣerbaz-ik (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Tekcmeḍ s umiḍan nniḍen. Kcem i tikelt-nniḍen s umiḍan i tferneḍ da."

msgid "Language"
msgstr "Tutlayt"

msgid "Keyboard"
msgstr "Anasiw"

msgid "Continue"
msgstr "Kemmel"

msgid "The setting could not be saved. Try again."
msgstr "Ur izmir ara ad yettwasekles usefrek. Ɛreḍ i tikelt-nniḍen."

msgid "Your account is disabled. Contact your administrator."
msgstr "Amiḍan-ik yettwasens. Nermes anedbal-ik."

msgid "This device is disabled. Contact your administrator."
msgstr "Ibenk-agi yettwasens. Nermes anedbal-ik."

msgid "Sign in with your school account."
msgstr "Kcem s umiḍan n uɣerbaz-ik."

msgid "Could not sign in. Please try again."
msgstr "Ur izmir ara ad yekcem. Ɛreḍ i tikelt-nniḍen, ma ulac aɣilif."

msgid "Authentication request cancelled"
msgstr "Asuter n usesteb yettwasefsex"

msgid "Maximum number of authentication attempts reached"
msgstr "Yewweḍ uḍḍun afellay n ɛraḍen n usesteb"

msgid "Error retrieving access token. Please try again."
msgstr "Tuccḍa deg wawway n token n unekcum. Ɛreḍ i tikelt-nniḍen."

msgid "Invalid user name"
msgstr "Isem n useqdac arameɣtu"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Aselkim-agi yettwasekkeṛ sɣur uɣerbaz; ma ulac aɣilif, nermes IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Anekcum am anebgi ur yettwasireg ara ɣef uselkim-agi"

msgid "Local accounts cannot sign in on this computer"
msgstr "Imiḍanen idiganen ur zemren ara ad kecmen ɣer uselkim-agi"

msgid "School accounts cannot sign in on this computer"
msgstr "Imiḍanen n uɣerbaz ur zemren ara ad kecmen ɣer uselkim-agi"

msgid "This app can only be opened from the sign-in screen"
msgstr "Asnas-agi yezmer kan ad yettwaldi seg ugdil n unekcum"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Asnas-agi yesra aẓeṭṭa. Qqen ɣer Wi-Fi seg ufeggag n ufella, sakin ɛreḍ i tikelt-nniḍen."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Ulac aẓeṭṭa. Qqen ɣer Wi-Fi seg umuɣ n ufella ɣer yefus."

msgid "Waiting for school settings."
msgstr "Araǧu n yiɣewwaren n uɣerbaz."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Asebded n yiminig web. Tzemreḍ ad tkecmeḍ; ad d-iban mi ara yewjed."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Ur yezmir ara ad yebded yiminig web akka tura; ad yettwaɛreḍ tikelt-nniḍen. Tzemreḍ ad tkecmeḍ."

msgid "Name or school email"
msgstr "Isem neɣ imayl n uɣerbaz"

msgid "Keep typing to narrow down"
msgstr "Kemmel tira akken ad tesmeẓẓiḍ tabdart"
