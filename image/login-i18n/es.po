msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Administrado por %s"

msgid "Shut down"
msgstr "Apagar"

msgid "Browse as Guest"
msgstr "Navegar como invitado"

msgid "Apps"
msgstr "Aplicaciones"

msgid "Cancel"
msgstr "Cancelar"

msgid "Retry"
msgstr "Reintentar"

msgid "Opening the sign-in page…"
msgstr "Abriendo la página de inicio de sesión…"

msgid "The sign-in page could not be opened."
msgstr "No se pudo abrir la página de inicio de sesión."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "No se puede acceder a la escuela. Conéctate a una red Wi-Fi desde la barra superior y vuelve a intentarlo."

msgid "IT maintenance sign-in"
msgstr "Inicio de sesión de mantenimiento informático"

msgid "Username"
msgstr "Nombre de usuario"

msgid "This account cannot sign in on this computer."
msgstr "Esta cuenta no puede iniciar sesión en este equipo."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Esta cuenta no puede iniciar sesión en este equipo. Usa tu correo de la escuela (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Iniciaste sesión con otra cuenta. Vuelve a iniciar sesión con la cuenta que elegiste aquí."

msgid "Language"
msgstr "Idioma"

msgid "Keyboard"
msgstr "Teclado"

msgid "Continue"
msgstr "Continuar"

msgid "The setting could not be saved. Try again."
msgstr "No se pudo guardar el ajuste. Inténtalo de nuevo."

msgid "Your account is disabled. Contact your administrator."
msgstr "Tu cuenta está desactivada. Ponte en contacto con tu administrador."

msgid "This device is disabled. Contact your administrator."
msgstr "Este dispositivo está desactivado. Ponte en contacto con tu administrador."

msgid "Sign in with your school account."
msgstr "Inicia sesión con tu cuenta de la escuela."

msgid "Could not sign in. Please try again."
msgstr "No se pudo iniciar sesión. Inténtalo de nuevo."

msgid "Authentication request cancelled"
msgstr "Solicitud de autenticación cancelada"

msgid "Maximum number of authentication attempts reached"
msgstr "Se alcanzó el número máximo de intentos de autenticación"

msgid "Error retrieving access token. Please try again."
msgstr "Error al obtener el token de acceso. Inténtalo de nuevo."

msgid "Invalid user name"
msgstr "Nombre de usuario no válido"

msgid "This computer has been locked by the school; please contact IT"
msgstr "La escuela ha bloqueado este equipo; ponte en contacto con TI"

msgid "Guest sign-in is not allowed on this computer"
msgstr "No se permite iniciar sesión como invitado en este equipo"

msgid "Local accounts cannot sign in on this computer"
msgstr "Las cuentas locales no pueden iniciar sesión en este equipo"

msgid "School accounts cannot sign in on this computer"
msgstr "Las cuentas de la escuela no pueden iniciar sesión en este equipo"

msgid "This app can only be opened from the sign-in screen"
msgstr "Esta aplicación solo se puede abrir desde la pantalla de inicio de sesión"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Esta aplicación necesita una red. Conéctate a una red Wi-Fi desde la barra superior y vuelve a intentarlo."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "No hay red. Conéctate a una red Wi-Fi desde el menú de la esquina superior derecha."

msgid "Waiting for school settings."
msgstr "Esperando la configuración de la escuela."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Instalando el navegador web. Puedes iniciar sesión; aparecerá cuando esté listo."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Todavía no se pudo instalar el navegador web; se volverá a intentar. Puedes iniciar sesión."

msgid "Name or school email"
msgstr "Nombre o correo de la escuela"

msgid "Keep typing to narrow down"
msgstr "Sigue escribiendo para acotar la lista"
