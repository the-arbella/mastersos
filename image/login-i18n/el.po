msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Διαχειρίζεται από: %s"

msgid "Shut down"
msgstr "Τερματισμός"

msgid "Browse as Guest"
msgstr "Περιήγηση ως επισκέπτης"

msgid "Apps"
msgstr "Εφαρμογές"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Retry"
msgstr "Επανάληψη"

msgid "Opening the sign-in page…"
msgstr "Άνοιγμα της σελίδας σύνδεσης…"

msgid "The sign-in page could not be opened."
msgstr "Δεν ήταν δυνατό το άνοιγμα της σελίδας σύνδεσης."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Δεν είναι δυνατή η σύνδεση με το σχολείο. Συνδεθείτε στο Wi-Fi από την επάνω γραμμή και δοκιμάστε ξανά."

msgid "IT maintenance sign-in"
msgstr "Σύνδεση συντήρησης IT"

msgid "Username"
msgstr "Όνομα χρήστη"

msgid "This account cannot sign in on this computer."
msgstr "Αυτός ο λογαριασμός δεν μπορεί να συνδεθεί σε αυτόν τον υπολογιστή."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Αυτός ο λογαριασμός δεν μπορεί να συνδεθεί σε αυτόν τον υπολογιστή. Χρησιμοποιήστε το σχολικό σας email (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Συνδεθήκατε με διαφορετικό λογαριασμό. Συνδεθείτε ξανά με τον λογαριασμό που επιλέξατε εδώ."

msgid "Language"
msgstr "Γλώσσα"

msgid "Keyboard"
msgstr "Πληκτρολόγιο"

msgid "Continue"
msgstr "Συνέχεια"

msgid "The setting could not be saved. Try again."
msgstr "Δεν ήταν δυνατή η αποθήκευση της ρύθμισης. Δοκιμάστε ξανά."

msgid "Your account is disabled. Contact your administrator."
msgstr "Ο λογαριασμός σας είναι απενεργοποιημένος. Επικοινωνήστε με τον διαχειριστή σας."

msgid "This device is disabled. Contact your administrator."
msgstr "Αυτή η συσκευή είναι απενεργοποιημένη. Επικοινωνήστε με τον διαχειριστή σας."

msgid "Sign in with your school account."
msgstr "Συνδεθείτε με τον σχολικό σας λογαριασμό."

msgid "Could not sign in. Please try again."
msgstr "Δεν ήταν δυνατή η σύνδεση. Δοκιμάστε ξανά."

msgid "Authentication request cancelled"
msgstr "Το αίτημα ταυτοποίησης ακυρώθηκε"

msgid "Maximum number of authentication attempts reached"
msgstr "Συμπληρώθηκε ο μέγιστος αριθμός προσπαθειών ταυτοποίησης"

msgid "Error retrieving access token. Please try again."
msgstr "Σφάλμα κατά τη λήψη του διακριτικού πρόσβασης. Δοκιμάστε ξανά."

msgid "Invalid user name"
msgstr "Μη έγκυρο όνομα χρήστη"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Αυτός ο υπολογιστής έχει κλειδωθεί από το σχολείο· επικοινωνήστε με το τμήμα IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Η σύνδεση επισκέπτη δεν επιτρέπεται σε αυτόν τον υπολογιστή"

msgid "Local accounts cannot sign in on this computer"
msgstr "Οι τοπικοί λογαριασμοί δεν μπορούν να συνδεθούν σε αυτόν τον υπολογιστή"

msgid "School accounts cannot sign in on this computer"
msgstr "Οι σχολικοί λογαριασμοί δεν μπορούν να συνδεθούν σε αυτόν τον υπολογιστή"

msgid "This app can only be opened from the sign-in screen"
msgstr "Αυτή η εφαρμογή ανοίγει μόνο από την οθόνη σύνδεσης"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Αυτή η εφαρμογή χρειάζεται δίκτυο. Συνδεθείτε στο Wi-Fi από την επάνω γραμμή και δοκιμάστε ξανά."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Δεν υπάρχει δίκτυο. Συνδεθείτε στο Wi-Fi από το μενού επάνω δεξιά."

msgid "Waiting for school settings."
msgstr "Αναμονή για τις ρυθμίσεις του σχολείου."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Γίνεται εγκατάσταση του προγράμματος περιήγησης. Μπορείτε να συνδεθείτε· θα εμφανιστεί όταν είναι έτοιμο."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Δεν ήταν ακόμη δυνατή η εγκατάσταση του προγράμματος περιήγησης· θα γίνει νέα προσπάθεια. Μπορείτε να συνδεθείτε."

msgid "Name or school email"
msgstr "Όνομα ή σχολικό email"

msgid "Keep typing to narrow down"
msgstr "Συνεχίστε να πληκτρολογείτε για να περιορίσετε τη λίστα"

msgid "Get help"
msgstr "Βοήθεια"

msgid "Get help from IT"
msgstr "Βοήθεια από το τμήμα IT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Δεν μπορώ να συνδεθώ"

msgid "An app"
msgstr "Μια εφαρμογή"

msgid "Screen, keys or sound"
msgstr "Οθόνη, πλήκτρα ή ήχος"

msgid "Battery"
msgstr "Μπαταρία"

msgid "Other"
msgstr "Άλλο"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Τι συνέβη; Μην συμπεριλάβετε κωδικούς πρόσβασης ή προσωπικά στοιχεία."

msgid "Attach a screenshot"
msgstr "Επισύναψη στιγμιότυπου οθόνης"

msgid "Send"
msgstr "Αποστολή"

msgid "Close"
msgstr "Κλείσιμο"

msgid "Sending…"
msgstr "Αποστολή…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Στάλθηκε. Αίτημα #%s. Το τμήμα IT ενημερώθηκε."

msgid "Saved. It will be sent when this computer is online."
msgstr "Αποθηκεύτηκε. Θα σταλεί όταν ο υπολογιστής συνδεθεί στο διαδίκτυο."

msgid "Help requests are turned off at this school."
msgstr "Τα αιτήματα βοήθειας είναι απενεργοποιημένα σε αυτό το σχολείο."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Έχετε στείλει 3 αιτήματα αυτήν την ώρα. Δοκιμάστε ξανά αργότερα."

msgid "Couldn't send. Please tell a teacher."
msgstr "Δεν ήταν δυνατή η αποστολή. Ενημερώστε έναν εκπαιδευτικό."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Το τμήμα IT συλλέγει διαγνωστικές πληροφορίες από αυτόν τον υπολογιστή."
