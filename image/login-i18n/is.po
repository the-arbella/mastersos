msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Stýrt af %s"

msgid "Shut down"
msgstr "Slökkva"

msgid "Browse as Guest"
msgstr "Vafra sem gestur"

msgid "Apps"
msgstr "Forrit"

msgid "Cancel"
msgstr "Hætta við"

msgid "Retry"
msgstr "Reyna aftur"

msgid "Opening the sign-in page…"
msgstr "Opna innskráningarsíðuna…"

msgid "The sign-in page could not be opened."
msgstr "Ekki tókst að opna innskráningarsíðuna."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Næ ekki sambandi við skólann. Tengstu Wi-Fi úr efri stikunni og reyndu aftur."

msgid "IT maintenance sign-in"
msgstr "Innskráning fyrir tölvuviðhald"

msgid "Username"
msgstr "Notandanafn"

msgid "This account cannot sign in on this computer."
msgstr "Þessi reikningur getur ekki skráð sig inn á þessari tölvu."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Þessi reikningur getur ekki skráð sig inn á þessari tölvu. Notaðu skólanetfangið þitt (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Þessi reikningur getur ekki skráð sig inn á þessari tölvu. Netfang hans hefur ekki verið staðfest."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Þú skráðir þig inn með öðrum reikningi. Skráðu þig aftur inn með reikningnum sem þú valdir hér."

msgid "Language"
msgstr "Tungumál"

msgid "Keyboard"
msgstr "Lyklaborð"

msgid "Continue"
msgstr "Áfram"

msgid "The setting could not be saved. Try again."
msgstr "Ekki tókst að vista stillinguna. Reyndu aftur."

msgid "Your account is disabled. Contact your administrator."
msgstr "Reikningurinn þinn er óvirkur. Hafðu samband við kerfisstjóra."

msgid "This device is disabled. Contact your administrator."
msgstr "Þetta tæki er óvirkt. Hafðu samband við kerfisstjóra."

msgid "Sign in with your school account."
msgstr "Skráðu þig inn með skólareikningnum þínum."

msgid "Could not sign in. Please try again."
msgstr "Innskráning mistókst. Reyndu aftur."

msgid "Authentication request cancelled"
msgstr "Auðkenningarbeiðni afturkölluð"

msgid "Maximum number of authentication attempts reached"
msgstr "Hámarksfjölda auðkenningartilrauna náð"

msgid "Error retrieving access token. Please try again."
msgstr "Villa við að sækja aðgangslykil. Reyndu aftur."

msgid "Invalid user name"
msgstr "Ógilt notandanafn"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Skólinn hefur læst þessari tölvu; hafðu samband við tæknideild"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Gestainnskráning er ekki leyfð á þessari tölvu"

msgid "Local accounts cannot sign in on this computer"
msgstr "Staðbundnir reikningar geta ekki skráð sig inn á þessari tölvu"

msgid "School accounts cannot sign in on this computer"
msgstr "Skólareikningar geta ekki skráð sig inn á þessari tölvu"

msgid "This app can only be opened from the sign-in screen"
msgstr "Aðeins er hægt að opna þetta forrit af innskráningarskjánum"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Þetta forrit þarf net. Tengstu Wi-Fi úr efri stikunni og reyndu aftur."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Ekkert net. Tengstu Wi-Fi úr valmyndinni efst til hægri."

msgid "Waiting for school settings."
msgstr "Bíð eftir stillingum skólans."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Verið er að setja upp vafrann. Þú getur skráð þig inn; hann birtist þegar hann er tilbúinn."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Ekki tókst enn að setja upp vafrann; reynt verður aftur. Þú getur skráð þig inn."

msgid "Name or school email"
msgstr "Nafn eða skólanetfang"

msgid "Keep typing to narrow down"
msgstr "Haltu áfram að skrifa til að þrengja listann"

msgid "Get help"
msgstr "Fá aðstoð"

msgid "Get help from IT"
msgstr "Fá aðstoð frá tæknideild"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Get ekki skráð mig inn"

msgid "An app"
msgstr "Forrit"

msgid "Screen, keys or sound"
msgstr "Skjár, lyklar eða hljóð"

msgid "Battery"
msgstr "Rafhlaða"

msgid "Other"
msgstr "Annað"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Hvað gerðist? Ekki skrifa lykilorð eða persónuupplýsingar."

msgid "Attach a screenshot"
msgstr "Hengja skjámynd við"

msgid "Send"
msgstr "Senda"

msgid "Close"
msgstr "Loka"

msgid "Sending…"
msgstr "Sendi…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Sent. Beiðni #%s. Tæknideild hefur verið látin vita."

msgid "Saved. It will be sent when this computer is online."
msgstr "Vistað. Þetta verður sent þegar tölvan tengist netinu."

msgid "Help requests are turned off at this school."
msgstr "Slökkt er á hjálparbeiðnum í þessum skóla."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Þú hefur sent 3 beiðnir á þessari klukkustund. Reyndu aftur síðar."

msgid "Couldn't send. Please tell a teacher."
msgstr "Ekki tókst að senda. Láttu kennara vita."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Tæknideild er að safna greiningarupplýsingum úr þessari tölvu."
