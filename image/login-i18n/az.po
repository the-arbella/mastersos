msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s tərəfindən idarə olunur"

msgid "Shut down"
msgstr "Söndür"

msgid "Browse as Guest"
msgstr "Qonaq kimi gəz"

msgid "Apps"
msgstr "Tətbiqlər"

msgid "Cancel"
msgstr "Ləğv et"

msgid "Retry"
msgstr "Yenidən cəhd et"

msgid "Opening the sign-in page…"
msgstr "Giriş səhifəsi açılır…"

msgid "The sign-in page could not be opened."
msgstr "Giriş səhifəsi açıla bilmədi."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Məktəbə qoşulmaq mümkün olmadı. Yuxarı paneldən Wi-Fi şəbəkəsinə qoşulun, sonra yenidən cəhd edin."

msgid "IT maintenance sign-in"
msgstr "İT xidməti üçün giriş"

msgid "Username"
msgstr "İstifadəçi adı"

msgid "This account cannot sign in on this computer."
msgstr "Bu hesabla bu kompüterə daxil olmaq olmaz."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Bu hesabla bu kompüterə daxil olmaq olmaz. Məktəb e-poçtunuzdan (%s) istifadə edin."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Başqa hesabla daxil oldunuz. Burada seçdiyiniz hesabla yenidən daxil olun."

msgid "Language"
msgstr "Dil"

msgid "Keyboard"
msgstr "Klaviatura"

msgid "Continue"
msgstr "Davam et"

msgid "The setting could not be saved. Try again."
msgstr "Ayar saxlanıla bilmədi. Yenidən cəhd edin."

msgid "Your account is disabled. Contact your administrator."
msgstr "Hesabınız deaktiv edilib. Administratorla əlaqə saxlayın."

msgid "This device is disabled. Contact your administrator."
msgstr "Bu cihaz deaktiv edilib. Administratorla əlaqə saxlayın."

msgid "Sign in with your school account."
msgstr "Məktəb hesabınızla daxil olun."

msgid "Could not sign in. Please try again."
msgstr "Daxil olmaq mümkün olmadı. Lütfən, yenidən cəhd edin."

msgid "Authentication request cancelled"
msgstr "Autentifikasiya sorğusu ləğv edildi"

msgid "Maximum number of authentication attempts reached"
msgstr "Autentifikasiya cəhdlərinin maksimum sayına çatıldı"

msgid "Error retrieving access token. Please try again."
msgstr "Giriş tokenini əldə edərkən xəta baş verdi. Lütfən, yenidən cəhd edin."

msgid "Invalid user name"
msgstr "Yanlış istifadəçi adı"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Bu kompüter məktəb tərəfindən kilidlənib; lütfən, İT ilə əlaqə saxlayın"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Bu kompüterdə qonaq kimi daxil olmağa icazə verilmir"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokal hesablarla bu kompüterə daxil olmaq olmaz"

msgid "School accounts cannot sign in on this computer"
msgstr "Məktəb hesabları ilə bu kompüterə daxil olmaq olmaz"

msgid "This app can only be opened from the sign-in screen"
msgstr "Bu tətbiq yalnız giriş ekranından açıla bilər"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Bu tətbiq şəbəkəyə ehtiyac duyur. Yuxarı paneldən Wi-Fi şəbəkəsinə qoşulun, sonra yenidən cəhd edin."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Şəbəkə yoxdur. Yuxarı sağdakı menyudan Wi-Fi şəbəkəsinə qoşulun."

msgid "Waiting for school settings."
msgstr "Məktəb ayarları gözlənilir."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Veb brauzer quraşdırılır. Daxil ola bilərsiniz; hazır olanda görünəcək."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Veb brauzer hələ quraşdırıla bilmədi; yenidən cəhd ediləcək. Daxil ola bilərsiniz."

msgid "Name or school email"
msgstr "Ad və ya məktəb e-poçtu"

msgid "Keep typing to narrow down"
msgstr "Siyahını daraltmaq üçün yazmağa davam edin"

msgid "Get help"
msgstr "Kömək al"

msgid "Get help from IT"
msgstr "İT-dən kömək al"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Daxil ola bilmirəm"

msgid "An app"
msgstr "Tətbiq"

msgid "Screen, keys or sound"
msgstr "Ekran, düymələr və ya səs"

msgid "Battery"
msgstr "Batareya"

msgid "Other"
msgstr "Digər"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Nə baş verdi? Lütfən, parol və ya şəxsi məlumat yazmayın."

msgid "Attach a screenshot"
msgstr "Ekran şəklini əlavə et"

msgid "Send"
msgstr "Göndər"

msgid "Close"
msgstr "Bağla"

msgid "Sending…"
msgstr "Göndərilir…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Göndərildi. Müraciət #%s. İT-yə xəbər verildi."

msgid "Saved. It will be sent when this computer is online."
msgstr "Saxlanıldı. Kompüter internetə qoşulanda göndəriləcək."

msgid "Help requests are turned off at this school."
msgstr "Bu məktəbdə kömək sorğuları söndürülüb."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Bu saat 3 sorğu göndərmisiniz. Lütfən, bir az sonra yenidən cəhd edin."

msgid "Couldn't send. Please tell a teacher."
msgstr "Göndərmək mümkün olmadı. Lütfən, müəllimə deyin."

msgid "IT is collecting diagnostic info from this computer."
msgstr "İT bu kompüterdən diaqnostika məlumatı toplayır."
