msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Bestuur deur %s"

msgid "Shut down"
msgstr "Skakel af"

msgid "Browse as Guest"
msgstr "Blaai as gas"

msgid "Apps"
msgstr "Toepassings"

msgid "Cancel"
msgstr "Kanselleer"

msgid "Retry"
msgstr "Probeer weer"

msgid "Opening the sign-in page…"
msgstr "Maak tans die aanmeldbladsy oop…"

msgid "The sign-in page could not be opened."
msgstr "Die aanmeldbladsy kon nie oopgemaak word nie."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Kan nie die skool bereik nie. Koppel via die boonste balk aan Wi-Fi en probeer dan weer."

msgid "IT maintenance sign-in"
msgstr "IT-onderhoud-aanmelding"

msgid "Username"
msgstr "Gebruikernaam"

msgid "This account cannot sign in on this computer."
msgstr "Hierdie rekening kan nie op hierdie rekenaar aanmeld nie."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Hierdie rekening kan nie op hierdie rekenaar aanmeld nie. Gebruik jou skool-e-pos (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Hierdie rekening kan nie op hierdie rekenaar aanmeld nie. Sy e-posadres is nie geverifieer nie."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Jy het met 'n ander rekening aangemeld. Meld weer aan met die rekening wat jy hier gekies het."

msgid "Language"
msgstr "Taal"

msgid "Keyboard"
msgstr "Sleutelbord"

msgid "Continue"
msgstr "Gaan voort"

msgid "The setting could not be saved. Try again."
msgstr "Die instelling kon nie gestoor word nie. Probeer weer."

msgid "Your account is disabled. Contact your administrator."
msgstr "Jou rekening is gedeaktiveer. Kontak jou administrateur."

msgid "This device is disabled. Contact your administrator."
msgstr "Hierdie toestel is gedeaktiveer. Kontak jou administrateur."

msgid "Sign in with your school account."
msgstr "Meld aan met jou skoolrekening."

msgid "Could not sign in. Please try again."
msgstr "Kon nie aanmeld nie. Probeer asseblief weer."

msgid "Authentication request cancelled"
msgstr "Verifikasieversoek gekanselleer"

msgid "Maximum number of authentication attempts reached"
msgstr "Maksimum aantal verifikasiepogings bereik"

msgid "Error retrieving access token. Please try again."
msgstr "Fout met die verkryging van toegangstoken. Probeer asseblief weer."

msgid "Invalid user name"
msgstr "Ongeldige gebruikernaam"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Hierdie rekenaar is deur die skool gesluit; kontak asseblief IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Gasaanmelding word nie op hierdie rekenaar toegelaat nie"

msgid "Local accounts cannot sign in on this computer"
msgstr "Plaaslike rekeninge kan nie op hierdie rekenaar aanmeld nie"

msgid "School accounts cannot sign in on this computer"
msgstr "Skoolrekeninge kan nie op hierdie rekenaar aanmeld nie"

msgid "This app can only be opened from the sign-in screen"
msgstr "Hierdie toepassing kan slegs vanaf die aanmeldskerm oopgemaak word"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Hierdie toep het 'n netwerk nodig. Koppel via die boonste balk aan Wi-Fi en probeer dan weer."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Geen netwerk nie. Koppel aan Wi-Fi via die kieslys regs bo."

msgid "Waiting for school settings."
msgstr "Wag vir skoolinstellings."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Die webblaaier word geïnstalleer. Jy kan aanmeld; dit sal verskyn wanneer dit gereed is."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Die webblaaier kon nog nie geïnstalleer word nie; dit sal weer probeer. Jy kan aanmeld."

msgid "Name or school email"
msgstr "Naam of skool-e-pos"

msgid "Keep typing to narrow down"
msgstr "Hou aan tik om die lys te verklein"

msgid "Get help"
msgstr "Kry hulp"

msgid "Get help from IT"
msgstr "Kry hulp van IT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Kan nie aanmeld nie"

msgid "An app"
msgstr "'n Toep"

msgid "Screen, keys or sound"
msgstr "Skerm, sleutels of klank"

msgid "Battery"
msgstr "Battery"

msgid "Other"
msgstr "Ander"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Wat het gebeur? Moet asseblief nie wagwoorde of persoonlike besonderhede insluit nie."

msgid "Attach a screenshot"
msgstr "Heg 'n skermskoot aan"

msgid "Send"
msgstr "Stuur"

msgid "Close"
msgstr "Maak toe"

msgid "Sending…"
msgstr "Stuur tans…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Gestuur. Kaartjie #%s. IT is ingelig."

msgid "Saved. It will be sent when this computer is online."
msgstr "Gestoor. Dit sal gestuur word wanneer hierdie rekenaar aanlyn is."

msgid "Help requests are turned off at this school."
msgstr "Hulpversoeke is by hierdie skool afgeskakel."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Jy het hierdie uur al 3 versoeke gestuur. Probeer asseblief later weer."

msgid "Couldn't send. Please tell a teacher."
msgstr "Kon nie stuur nie. Sê asseblief vir 'n onderwyser."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT versamel diagnostiese inligting van hierdie rekenaar af."
