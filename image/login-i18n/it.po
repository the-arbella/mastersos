msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Gestito da %s"

msgid "Shut down"
msgstr "Spegni"

msgid "Browse as Guest"
msgstr "Naviga come ospite"

msgid "Apps"
msgstr "App"

msgid "Cancel"
msgstr "Annulla"

msgid "Retry"
msgstr "Riprova"

msgid "Opening the sign-in page…"
msgstr "Apertura della pagina di accesso…"

msgid "The sign-in page could not be opened."
msgstr "Impossibile aprire la pagina di accesso."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Impossibile raggiungere la scuola. Connettiti al Wi-Fi dalla barra in alto, poi riprova."

msgid "IT maintenance sign-in"
msgstr "Accesso per la manutenzione IT"

msgid "Username"
msgstr "Nome utente"

msgid "This account cannot sign in on this computer."
msgstr "Questo account non può accedere su questo computer."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Questo account non può accedere su questo computer. Usa la tua email della scuola (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Questo account non può accedere su questo computer. Il suo indirizzo email non è stato verificato."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Hai effettuato l’accesso con un account diverso. Accedi di nuovo con l’account scelto qui."

msgid "Language"
msgstr "Lingua"

msgid "Keyboard"
msgstr "Tastiera"

msgid "Continue"
msgstr "Continua"

msgid "The setting could not be saved. Try again."
msgstr "Impossibile salvare l’impostazione. Riprova."

msgid "Your account is disabled. Contact your administrator."
msgstr "Il tuo account è disattivato. Contatta l’amministratore."

msgid "This device is disabled. Contact your administrator."
msgstr "Questo dispositivo è disattivato. Contatta l’amministratore."

msgid "Sign in with your school account."
msgstr "Accedi con il tuo account della scuola."

msgid "Could not sign in. Please try again."
msgstr "Accesso non riuscito. Riprova."

msgid "Authentication request cancelled"
msgstr "Richiesta di autenticazione annullata"

msgid "Maximum number of authentication attempts reached"
msgstr "Raggiunto il numero massimo di tentativi di autenticazione"

msgid "Error retrieving access token. Please try again."
msgstr "Errore nel recupero del token di accesso. Riprova."

msgid "Invalid user name"
msgstr "Nome utente non valido"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Questo computer è stato bloccato dalla scuola; contatta l’assistenza IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "L’accesso come ospite non è consentito su questo computer"

msgid "Local accounts cannot sign in on this computer"
msgstr "Gli account locali non possono accedere su questo computer"

msgid "School accounts cannot sign in on this computer"
msgstr "Gli account della scuola non possono accedere su questo computer"

msgid "This app can only be opened from the sign-in screen"
msgstr "Questa app può essere aperta solo dalla schermata di accesso"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Questa app ha bisogno di una rete. Connettiti al Wi-Fi dalla barra in alto, poi riprova."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Nessuna rete. Connettiti al Wi-Fi dal menu in alto a destra."

msgid "Waiting for school settings."
msgstr "In attesa delle impostazioni della scuola."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Installazione del browser web in corso. Puoi accedere; comparirà quando sarà pronto."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Non è stato ancora possibile installare il browser web; verrà fatto un nuovo tentativo. Puoi accedere."

msgid "Name or school email"
msgstr "Nome o email della scuola"

msgid "Keep typing to narrow down"
msgstr "Continua a digitare per restringere l'elenco"

msgid "Get help"
msgstr "Chiedi aiuto"

msgid "Get help from IT"
msgstr "Chiedi aiuto all’assistenza IT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Non riesco ad accedere"

msgid "An app"
msgstr "Un’app"

msgid "Screen, keys or sound"
msgstr "Schermo, tasti o audio"

msgid "Battery"
msgstr "Batteria"

msgid "Other"
msgstr "Altro"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Cosa è successo? Non inserire password o dati personali."

msgid "Attach a screenshot"
msgstr "Allega uno screenshot"

msgid "Send"
msgstr "Invia"

msgid "Close"
msgstr "Chiudi"

msgid "Sending…"
msgstr "Invio in corso…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Inviata. Ticket #%s. L’assistenza IT è stata avvisata."

msgid "Saved. It will be sent when this computer is online."
msgstr "Salvata. Verrà inviata quando questo computer sarà online."

msgid "Help requests are turned off at this school."
msgstr "Le richieste di aiuto sono disattivate in questa scuola."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Hai inviato 3 richieste in quest’ora. Riprova più tardi."

msgid "Couldn't send. Please tell a teacher."
msgstr "Invio non riuscito. Avvisa un insegnante."

msgid "IT is collecting diagnostic info from this computer."
msgstr "L’assistenza IT sta raccogliendo informazioni diagnostiche da questo computer."
