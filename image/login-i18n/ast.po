msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Alministráu por %s"

msgid "Shut down"
msgstr "Apagar"

msgid "Browse as Guest"
msgstr "Restolar como invitáu"

msgid "Add person"
msgstr "Amestar persona"

msgid "Apps"
msgstr "Aplicaciones"

msgid "Cancel"
msgstr "Encaboxar"

msgid "Retry"
msgstr "Reintentar"

msgid "Opening the sign-in page…"
msgstr "Abriendo la páxina d'aniciu de sesión…"

msgid "The sign-in page could not be opened."
msgstr "Nun se pudo abrir la páxina d'aniciu de sesión."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Nun se pue acceder a la escuela. Conéctate a una rede Wi-Fi dende la barra de riba y volvi intentalo."

msgid "School email"
msgstr "Corréu de la escuela"

msgid "IT local account"
msgstr "Cuenta llocal de TI"

msgid "Username"
msgstr "Nome d'usuariu"

msgid "This account cannot sign in on this computer."
msgstr "Esta cuenta nun pue aniciar sesión nesti ordenador."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Esta cuenta nun pue aniciar sesión nesti ordenador. Usa'l corréu de la escuela (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Aniciesti sesión con otra cuenta. Volvi aniciar sesión cola cuenta qu'escoyesti equí."

msgid "Language"
msgstr "Idioma"

msgid "Keyboard"
msgstr "Tecláu"

msgid "Continue"
msgstr "Siguir"

msgid "The setting could not be saved. Try again."
msgstr "Nun se pudo guardar l'axuste. Volvi intentalo."

msgid "Your account is disabled. Contact your administrator."
msgstr "La to cuenta ta desactivada. Ponte en contautu col alministrador."

msgid "This device is disabled. Contact your administrator."
msgstr "Esti preséu ta desactiváu. Ponte en contautu col alministrador."

msgid "Sign in with your school account."
msgstr "Anicia sesión cola to cuenta de la escuela."

msgid "Could not sign in. Please try again."
msgstr "Nun se pudo aniciar sesión. Volvi intentalo."

msgid "Authentication request cancelled"
msgstr "Encaboxóse la solicitú d'autenticación"

msgid "Maximum number of authentication attempts reached"
msgstr "Algamóse'l númberu máximu d'intentos d'autenticación"

msgid "Error retrieving access token. Please try again."
msgstr "Error al obtener el token d'accesu. Volvi intentalo."

msgid "Invalid user name"
msgstr "Nome d'usuariu non válidu"

msgid "This computer has been locked by the school; please contact IT"
msgstr "La escuela bloquió esti ordenador; ponte en contautu con TI"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Nesti ordenador nun se permite aniciar sesión como invitáu"

msgid "Local accounts cannot sign in on this computer"
msgstr "Les cuentes llocales nun puen aniciar sesión nesti ordenador"

msgid "School accounts cannot sign in on this computer"
msgstr "Les cuentes de la escuela nun puen aniciar sesión nesti ordenador"

msgid "This app can only be opened from the sign-in screen"
msgstr "Esta aplicación namás se pue abrir dende la pantalla d'aniciu de sesión"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Esta aplicación necesita una rede. Conéctate a una rede Wi-Fi dende la barra de riba y volvi intentalo."
