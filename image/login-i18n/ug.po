msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s باشقۇرىدۇ"

msgid "Shut down"
msgstr "تاقا"

msgid "Browse as Guest"
msgstr "مېھمان سۈپىتىدە زىيارەت قىل"

msgid "Apps"
msgstr "ئەپلەر"

msgid "Cancel"
msgstr "ئىناۋەتسىز"

msgid "Retry"
msgstr "قايتا سىنا"

msgid "Opening the sign-in page…"
msgstr "كىرىش بېتى ئېچىلىۋاتىدۇ…"

msgid "The sign-in page could not be opened."
msgstr "كىرىش بېتىنى ئاچقىلى بولمىدى."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "مەكتەپكە ئۇلانغىلى بولمىدى. ئۈستى بالداقتىن Wi-Fi غا ئۇلاڭ، ئاندىن قايتا سىناڭ."

msgid "IT maintenance sign-in"
msgstr "IT ئاسراش كىرىشى"

msgid "Username"
msgstr "ئىشلەتكۈچى ئىسمى"

msgid "This account cannot sign in on this computer."
msgstr "بۇ ھېسابات بۇ كومپيۇتېرغا كىرەلمەيدۇ."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "بۇ ھېسابات بۇ كومپيۇتېرغا كىرەلمەيدۇ. مەكتەپ ئېلخېتىڭىزنى (%s) ئىشلىتىڭ."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "سىز باشقا ھېسابات بىلەن كىردىڭىز. بۇ يەردە تاللىغان ھېساباتىڭىز بىلەن قايتا كىرىڭ."

msgid "Language"
msgstr "تىل"

msgid "Keyboard"
msgstr "كۇنۇپكا تاختىسى"

msgid "Continue"
msgstr "داۋاملاشتۇر"

msgid "The setting could not be saved. Try again."
msgstr "تەڭشەكنى ساقلىغىلى بولمىدى. قايتا سىناڭ."

msgid "Your account is disabled. Contact your administrator."
msgstr "ھېساباتىڭىز چەكلەنگەن. باشقۇرغۇچىڭىز بىلەن ئالاقىلىشىڭ."

msgid "This device is disabled. Contact your administrator."
msgstr "بۇ ئۈسكۈنە چەكلەنگەن. باشقۇرغۇچىڭىز بىلەن ئالاقىلىشىڭ."

msgid "Sign in with your school account."
msgstr "مەكتەپ ھېساباتىڭىز بىلەن كىرىڭ."

msgid "Could not sign in. Please try again."
msgstr "كىرەلمىدى. قايتا سىناڭ."

msgid "Authentication request cancelled"
msgstr "كىملىك دەلىللەش تەلىپى ئەمەلدىن قالدۇرۇلدى"

msgid "Maximum number of authentication attempts reached"
msgstr "كىملىك دەلىللەش سىناق قېتىمى ئەڭ كۆپ چەككە يەتتى"

msgid "Error retrieving access token. Please try again."
msgstr "زىيارەت بەلگىسىنى ئېلىشتا خاتالىق كۆرۈلدى. قايتا سىناڭ."

msgid "Invalid user name"
msgstr "ئىشلەتكۈچى ئىسمى ئىناۋەتسىز"

msgid "This computer has been locked by the school; please contact IT"
msgstr "بۇ كومپيۇتېر مەكتەپ تەرىپىدىن قۇلۇپلانغان؛ IT بىلەن ئالاقىلىشىڭ"

msgid "Guest sign-in is not allowed on this computer"
msgstr "بۇ كومپيۇتېردا مېھمان سۈپىتىدە كىرىشكە بولمايدۇ"

msgid "Local accounts cannot sign in on this computer"
msgstr "يەرلىك ھېساباتلار بۇ كومپيۇتېرغا كىرەلمەيدۇ"

msgid "School accounts cannot sign in on this computer"
msgstr "مەكتەپ ھېساباتلىرى بۇ كومپيۇتېرغا كىرەلمەيدۇ"

msgid "This app can only be opened from the sign-in screen"
msgstr "بۇ ئەپنى پەقەت كىرىش ئېكرانىدىن ئاچقىلى بولىدۇ"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "بۇ ئەپكە تور لازىم. ئۈستى بالداقتىن Wi-Fi غا ئۇلاڭ، ئاندىن قايتا سىناڭ."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "تور يوق. سول ئۈستىدىكى تىزىملىكتىن Wi-Fi غا ئۇلاڭ."

msgid "Waiting for school settings."
msgstr "مەكتەپ تەڭشەكلىرىنى كۈتۈۋاتىدۇ."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "تور كۆرگۈچ ئورنىتىلىۋاتىدۇ. كىرسىڭىز بولىدۇ؛ تەييار بولغاندا كۆرۈنىدۇ."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "تور كۆرگۈچ تېخى ئورنىتىلمىدى؛ قايتا سىنىلىدۇ. كىرسىڭىز بولىدۇ."

msgid "Name or school email"
msgstr "ئىسىم ياكى مەكتەپ ئېلخېتى"

msgid "Keep typing to narrow down"
msgstr "تىزىملىكنى تارايتىش ئۈچۈن داۋاملىق كىرگۈزۈڭ"

msgid "Get help"
msgstr "ياردەم سوراش"

msgid "Get help from IT"
msgstr "IT دىن ياردەم سوراش"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "كىرەلمىدىم"

msgid "An app"
msgstr "بىر ئەپ"

msgid "Screen, keys or sound"
msgstr "ئېكران، كۇنۇپكا ياكى ئاۋاز"

msgid "Battery"
msgstr "باتارېيە"

msgid "Other"
msgstr "باشقا"

msgid "What happened? Please don't include passwords or personal details."
msgstr "نېمە بولدى؟ مەخپىي نومۇر ياكى شەخسىي ئۇچۇرلارنى يازماڭ."

msgid "Attach a screenshot"
msgstr "ئېكران رەسىمى قوشۇش"

msgid "Send"
msgstr "يوللاش"

msgid "Close"
msgstr "تاقاش"

msgid "Sending…"
msgstr "يوللىنىۋاتىدۇ…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "يوللاندى. خىزمەت بېلىتى #%s. IT غا ئۇقتۇرۇلدى."

msgid "Saved. It will be sent when this computer is online."
msgstr "ساقلاندى. بۇ كومپيۇتېر تورغا ئۇلانغاندا يوللىنىدۇ."

msgid "Help requests are turned off at this school."
msgstr "بۇ مەكتەپتە ياردەم سوراش ئېتىۋېتىلگەن."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "بۇ سائەتتە 3 قېتىم ئىلتىماس يوللىدىڭىز. كېيىن قايتا سىناڭ."

msgid "Couldn't send. Please tell a teacher."
msgstr "يوللىغىلى بولمىدى. ئوقۇتقۇچىغا ئېيتىڭ."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT بۇ كومپيۇتېردىن دىياگنوز ئۇچۇرى توپلاۋاتىدۇ."
