msgid "Managed by %s"
msgstr "بەڕێوەبراوە لەلایەن %s"

msgid "Shut down"
msgstr "کوژاندنەوە"

msgid "Browse as Guest"
msgstr "وەک میوان بگەڕێ"

msgid "Apps"
msgstr "ئەپەکان"

msgid "Cancel"
msgstr "هەڵوەشاندنەوە"

msgid "Retry"
msgstr "دووبارە هەوڵبدەرەوە"

msgid "Opening the sign-in page…"
msgstr "پەڕەی چوونەژوورەوە دەکرێتەوە…"

msgid "The sign-in page could not be opened."
msgstr "نەتوانرا پەڕەی چوونەژوورەوە بکرێتەوە."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "نەتوانرا پەیوەندی بە قوتابخانەوە بکرێت. لە شریتی سەرەوە بە Wi-Fi ببەستەرەوە، پاشان دووبارە هەوڵبدەرەوە."

msgid "Local manager"
msgstr "بەڕێوەبەری ناوخۆیی"

msgid "Username"
msgstr "ناوی بەکارهێنەر"

msgid "This account cannot sign in on this computer."
msgstr "ئەم هەژمارە ناتوانێت لەسەر ئەم کۆمپیوتەرە بچێتە ژوورەوە."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "ئەم هەژمارە ناتوانێت لەسەر ئەم کۆمپیوتەرە بچێتە ژوورەوە. ئیمەیڵی قوتابخانەکەت (%s) بەکاربهێنە."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "بە هەژمارێکی جیاواز چوویتە ژوورەوە. دووبارە بە هەژمارەکەی لێرە هەڵتبژاردووە بچۆ ژوورەوە."

msgid "Language"
msgstr "زمان"

msgid "Keyboard"
msgstr "کیبۆرد"

msgid "Continue"
msgstr "بەردەوامبوون"

msgid "The setting could not be saved. Try again."
msgstr "ڕێکخستنەکە نەتوانرا پاشەکەوت بکرێت. دووبارە هەوڵبدەرەوە."

msgid "Your account is disabled. Contact your administrator."
msgstr "هەژمارەکەت ناچالاک کراوە. پەیوەندی بە بەڕێوەبەرەکەتەوە بکە."

msgid "This device is disabled. Contact your administrator."
msgstr "ئەم ئامێرە ناچالاک کراوە. پەیوەندی بە بەڕێوەبەرەکەتەوە بکە."

msgid "Sign in with your school account."
msgstr "بە هەژماری قوتابخانەکەت بچۆ ژوورەوە."

msgid "Could not sign in. Please try again."
msgstr "نەتوانرا بچیتە ژوورەوە. تکایە دووبارە هەوڵبدەرەوە."

msgid "Authentication request cancelled"
msgstr "داواکاری سەلماندن هەڵوەشێنرایەوە"

msgid "Maximum number of authentication attempts reached"
msgstr "زۆرترین ژمارەی هەوڵەکانی سەلماندن تەواو بوو"

msgid "Error retrieving access token. Please try again."
msgstr "هەڵە ڕوویدا لە وەرگرتنی تۆکنی دەستپێگەیشتن. تکایە دووبارە هەوڵبدەرەوە."

msgid "Invalid user name"
msgstr "ناوی بەکارهێنەر دروست نییە"

msgid "This computer has been locked by the school; please contact IT"
msgstr "ئەم کۆمپیوتەرە لەلایەن قوتابخانەوە قفڵ کراوە؛ تکایە پەیوەندی بە IT بکە"

msgid "Guest sign-in is not allowed on this computer"
msgstr "چوونەژوورەوەی میوان لەسەر ئەم کۆمپیوتەرە ڕێگەپێدراو نییە"

msgid "Local accounts cannot sign in on this computer"
msgstr "هەژمارە ناوخۆییەکان ناتوانن لەسەر ئەم کۆمپیوتەرە بچنە ژوورەوە"

msgid "School accounts cannot sign in on this computer"
msgstr "هەژمارەکانی قوتابخانە ناتوانن لەسەر ئەم کۆمپیوتەرە بچنە ژوورەوە"

msgid "This app can only be opened from the sign-in screen"
msgstr "ئەم ئەپە تەنیا لە شاشەی چوونەژوورەوە دەکرێتەوە"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "ئەم ئەپە پێویستی بە تۆڕ هەیە. لە شریتی سەرەوە بە Wi-Fi ببەستەرەوە، پاشان دووبارە هەوڵبدەرەوە."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "تۆڕ نییە. لە لیستی سەرەوەی لای چەپ بە Wi-Fi ببەستەرەوە."

msgid "Waiting for school settings."
msgstr "چاوەڕوانی ڕێکخستنەکانی قوتابخانە."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "وێبگەڕ دادەمەزرێت. دەتوانیت بچیتە ژوورەوە؛ کاتێک ئامادە بوو دەردەکەوێت."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "وێبگەڕ هێشتا نەتوانرا دابمەزرێت؛ دووبارە هەوڵ دەدرێتەوە. دەتوانیت بچیتە ژوورەوە."

msgid "Name or school email"
msgstr "ناو یان ئیمەیڵی قوتابخانە"

msgid "Keep typing to narrow down"
msgstr "بەردەوام بە لە نووسین بۆ کەمکردنەوەی لیستەکە"
