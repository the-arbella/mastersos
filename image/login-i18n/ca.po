msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Gestionat per %s"

msgid "Shut down"
msgstr "Apaga"

msgid "Browse as Guest"
msgstr "Navega com a convidat"

msgid "Apps"
msgstr "Aplicacions"

msgid "Cancel"
msgstr "Cancel·la"

msgid "Retry"
msgstr "Reintenta"

msgid "Opening the sign-in page…"
msgstr "S'està obrint la pàgina d'inici de sessió…"

msgid "The sign-in page could not be opened."
msgstr "No s'ha pogut obrir la pàgina d'inici de sessió."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "No es pot contactar amb l'escola. Connecteu-vos al Wi-Fi des de la barra superior i torneu-ho a provar."

msgid "Local manager"
msgstr "Administrador local"

msgid "Username"
msgstr "Nom d'usuari"

msgid "This account cannot sign in on this computer."
msgstr "Aquest compte no pot iniciar la sessió en aquest ordinador."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Aquest compte no pot iniciar la sessió en aquest ordinador. Feu servir el correu de l'escola (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Heu iniciat la sessió amb un altre compte. Torneu-la a iniciar amb el compte que heu triat aquí."

msgid "Language"
msgstr "Llengua"

msgid "Keyboard"
msgstr "Teclat"

msgid "Continue"
msgstr "Continua"

msgid "The setting could not be saved. Try again."
msgstr "No s'ha pogut desar el paràmetre. Torneu-ho a provar."

msgid "Your account is disabled. Contact your administrator."
msgstr "El vostre compte està desactivat. Contacteu amb l'administrador."

msgid "This device is disabled. Contact your administrator."
msgstr "Aquest dispositiu està desactivat. Contacteu amb l'administrador."

msgid "Sign in with your school account."
msgstr "Inicieu la sessió amb el compte de l'escola."

msgid "Could not sign in. Please try again."
msgstr "No s'ha pogut iniciar la sessió. Torneu-ho a provar."

msgid "Authentication request cancelled"
msgstr "S'ha cancel·lat la sol·licitud d'autenticació"

msgid "Maximum number of authentication attempts reached"
msgstr "S'ha assolit el nombre màxim d'intents d'autenticació"

msgid "Error retrieving access token. Please try again."
msgstr "S'ha produït un error en obtenir el testimoni d'accés. Torneu-ho a provar."

msgid "Invalid user name"
msgstr "Nom d'usuari no vàlid"

msgid "This computer has been locked by the school; please contact IT"
msgstr "L'escola ha bloquejat aquest ordinador; contacteu amb TI"

msgid "Guest sign-in is not allowed on this computer"
msgstr "En aquest ordinador no es permet iniciar la sessió com a convidat"

msgid "Local accounts cannot sign in on this computer"
msgstr "Els comptes locals no poden iniciar la sessió en aquest ordinador"

msgid "School accounts cannot sign in on this computer"
msgstr "Els comptes de l'escola no poden iniciar la sessió en aquest ordinador"

msgid "This app can only be opened from the sign-in screen"
msgstr "Aquesta aplicació només es pot obrir des de la pantalla d'inici de sessió"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Aquesta aplicació necessita una xarxa. Connecteu-vos al Wi-Fi des de la barra superior i torneu-ho a provar."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "No hi ha xarxa. Connecteu-vos al Wi-Fi des del menú de la part superior dreta."

msgid "Waiting for school settings."
msgstr "S'està esperant la configuració de l'escola."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "S'està instal·lant el navegador web. Podeu iniciar la sessió; apareixerà quan estigui a punt."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Encara no s'ha pogut instal·lar el navegador web; es tornarà a provar. Podeu iniciar la sessió."

msgid "Name or school email"
msgstr "Nom o correu de l'escola"

msgid "Keep typing to narrow down"
msgstr "Continueu escrivint per reduir la llista"
