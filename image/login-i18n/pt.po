msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Gerido por %s"

msgid "Shut down"
msgstr "Desligar"

msgid "Browse as Guest"
msgstr "Navegar como convidado"

msgid "Add person"
msgstr "Adicionar pessoa"

msgid "Apps"
msgstr "Aplicações"

msgid "Cancel"
msgstr "Cancelar"

msgid "Retry"
msgstr "Tentar novamente"

msgid "Opening the sign-in page…"
msgstr "A abrir a página de início de sessão…"

msgid "The sign-in page could not be opened."
msgstr "Não foi possível abrir a página de início de sessão."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Não foi possível contactar a escola. Ligue-se ao Wi-Fi na barra superior e tente novamente."

msgid "School email"
msgstr "E-mail da escola"

msgid "Local manager"
msgstr "Administrador local"

msgid "Username"
msgstr "Nome de utilizador"

msgid "This account cannot sign in on this computer."
msgstr "Esta conta não pode iniciar sessão neste computador."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Esta conta não pode iniciar sessão neste computador. Utilize o seu e-mail da escola (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Iniciou sessão com outra conta. Inicie sessão novamente com a conta que escolheu aqui."

msgid "Language"
msgstr "Idioma"

msgid "Keyboard"
msgstr "Teclado"

msgid "Continue"
msgstr "Continuar"

msgid "The setting could not be saved. Try again."
msgstr "Não foi possível guardar a definição. Tente novamente."

msgid "Your account is disabled. Contact your administrator."
msgstr "A sua conta está desativada. Contacte o administrador."

msgid "This device is disabled. Contact your administrator."
msgstr "Este dispositivo está desativado. Contacte o administrador."

msgid "Sign in with your school account."
msgstr "Inicie sessão com a sua conta da escola."

msgid "Could not sign in. Please try again."
msgstr "Não foi possível iniciar sessão. Tente novamente."

msgid "Authentication request cancelled"
msgstr "Pedido de autenticação cancelado"

msgid "Maximum number of authentication attempts reached"
msgstr "Número máximo de tentativas de autenticação atingido"

msgid "Error retrieving access token. Please try again."
msgstr "Erro ao obter o token de acesso. Tente novamente."

msgid "Invalid user name"
msgstr "Nome de utilizador inválido"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Este computador foi bloqueado pela escola; contacte os serviços de TI"

msgid "Guest sign-in is not allowed on this computer"
msgstr "O início de sessão como convidado não é permitido neste computador"

msgid "Local accounts cannot sign in on this computer"
msgstr "As contas locais não podem iniciar sessão neste computador"

msgid "School accounts cannot sign in on this computer"
msgstr "As contas da escola não podem iniciar sessão neste computador"

msgid "This app can only be opened from the sign-in screen"
msgstr "Esta aplicação só pode ser aberta a partir do ecrã de início de sessão"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Esta aplicação precisa de uma rede. Ligue-se ao Wi-Fi na barra superior e tente novamente."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Sem rede. Escolha uma rede Wi-Fi no menu no canto superior direito, ou ligue um cabo de rede ou um telemóvel com partilha de ligação por USB."

msgid "Waiting for school settings."
msgstr "A aguardar as definições da escola."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "A instalar o navegador web. Pode iniciar sessão; ele aparecerá quando estiver pronto."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Ainda não foi possível instalar o navegador web; será feita uma nova tentativa. Pode iniciar sessão."
