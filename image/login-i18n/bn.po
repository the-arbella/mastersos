msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s দ্বারা পরিচালিত"

msgid "Shut down"
msgstr "বন্ধ করুন"

msgid "Browse as Guest"
msgstr "অতিথি হিসেবে ব্রাউজ করুন"

msgid "Apps"
msgstr "অ্যাপ"

msgid "Cancel"
msgstr "বাতিল"

msgid "Retry"
msgstr "আবার চেষ্টা করুন"

msgid "Opening the sign-in page…"
msgstr "সাইন-ইন পৃষ্ঠা খোলা হচ্ছে…"

msgid "The sign-in page could not be opened."
msgstr "সাইন-ইন পৃষ্ঠা খোলা যায়নি।"

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "স্কুলের সাথে যোগাযোগ করা যাচ্ছে না। উপরের বার থেকে Wi-Fi-তে সংযুক্ত হন, তারপর আবার চেষ্টা করুন।"

msgid "IT maintenance sign-in"
msgstr "আইটি রক্ষণাবেক্ষণ সাইন-ইন"

msgid "Username"
msgstr "ব্যবহারকারীর নাম"

msgid "This account cannot sign in on this computer."
msgstr "এই অ্যাকাউন্ট দিয়ে এই কম্পিউটারে সাইন ইন করা যাবে না।"

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "এই অ্যাকাউন্ট দিয়ে এই কম্পিউটারে সাইন ইন করা যাবে না। আপনার স্কুলের ইমেইল (%s) ব্যবহার করুন।"

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "আপনি অন্য একটি অ্যাকাউন্টে সাইন ইন করেছেন। এখানে যে অ্যাকাউন্টটি বেছে নিয়েছিলেন সেটি দিয়ে আবার সাইন ইন করুন।"

msgid "Language"
msgstr "ভাষা"

msgid "Keyboard"
msgstr "কীবোর্ড"

msgid "Continue"
msgstr "চালিয়ে যান"

msgid "The setting could not be saved. Try again."
msgstr "সেটিং সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"

msgid "Your account is disabled. Contact your administrator."
msgstr "আপনার অ্যাকাউন্ট নিষ্ক্রিয় করা হয়েছে। আপনার অ্যাডমিনিস্ট্রেটরের সাথে যোগাযোগ করুন।"

msgid "This device is disabled. Contact your administrator."
msgstr "এই ডিভাইসটি নিষ্ক্রিয় করা হয়েছে। আপনার অ্যাডমিনিস্ট্রেটরের সাথে যোগাযোগ করুন।"

msgid "Sign in with your school account."
msgstr "আপনার স্কুল অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"

msgid "Could not sign in. Please try again."
msgstr "সাইন ইন করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"

msgid "Authentication request cancelled"
msgstr "প্রমাণীকরণের অনুরোধ বাতিল করা হয়েছে"

msgid "Maximum number of authentication attempts reached"
msgstr "প্রমাণীকরণের সর্বোচ্চ চেষ্টার সংখ্যায় পৌঁছানো হয়েছে"

msgid "Error retrieving access token. Please try again."
msgstr "অ্যাক্সেস টোকেন আনতে ত্রুটি হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"

msgid "Invalid user name"
msgstr "ব্যবহারকারীর নাম সঠিক নয়"

msgid "This computer has been locked by the school; please contact IT"
msgstr "এই কম্পিউটারটি স্কুল লক করে দিয়েছে; অনুগ্রহ করে আইটি বিভাগের সাথে যোগাযোগ করুন"

msgid "Guest sign-in is not allowed on this computer"
msgstr "এই কম্পিউটারে অতিথি হিসেবে সাইন ইন করার অনুমতি নেই"

msgid "Local accounts cannot sign in on this computer"
msgstr "স্থানীয় অ্যাকাউন্ট দিয়ে এই কম্পিউটারে সাইন ইন করা যাবে না"

msgid "School accounts cannot sign in on this computer"
msgstr "স্কুল অ্যাকাউন্ট দিয়ে এই কম্পিউটারে সাইন ইন করা যাবে না"

msgid "This app can only be opened from the sign-in screen"
msgstr "এই অ্যাপটি শুধুমাত্র সাইন-ইন স্ক্রিন থেকে খোলা যাবে"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "এই অ্যাপের জন্য নেটওয়ার্ক প্রয়োজন। উপরের বার থেকে Wi-Fi-তে সংযুক্ত হন, তারপর আবার চেষ্টা করুন।"

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "নেটওয়ার্ক নেই। উপরের ডানদিকের মেনু থেকে Wi-Fi-তে সংযুক্ত হন।"

msgid "Waiting for school settings."
msgstr "স্কুলের সেটিংসের জন্য অপেক্ষা করা হচ্ছে।"

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "ওয়েব ব্রাউজার ইনস্টল করা হচ্ছে। আপনি সাইন ইন করতে পারেন; প্রস্তুত হলে এটি দেখা যাবে।"

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "ওয়েব ব্রাউজার এখনও ইনস্টল করা যায়নি; আবার চেষ্টা করা হবে। আপনি সাইন ইন করতে পারেন।"

msgid "Name or school email"
msgstr "নাম বা স্কুলের ইমেইল"

msgid "Keep typing to narrow down"
msgstr "তালিকা ছোট করতে টাইপ করতে থাকুন"

msgid "Get help"
msgstr "সাহায্য নিন"

msgid "Get help from IT"
msgstr "আইটি থেকে সাহায্য নিন"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "সাইন ইন করা যাচ্ছে না"

msgid "An app"
msgstr "একটি অ্যাপ"

msgid "Screen, keys or sound"
msgstr "স্ক্রিন, কী বা সাউন্ড"

msgid "Battery"
msgstr "ব্যাটারি"

msgid "Other"
msgstr "অন্যান্য"

msgid "What happened? Please don't include passwords or personal details."
msgstr "কী হয়েছে? অনুগ্রহ করে পাসওয়ার্ড বা ব্যক্তিগত তথ্য লিখবেন না।"

msgid "Attach a screenshot"
msgstr "একটি স্ক্রিনশট সংযুক্ত করুন"

msgid "Send"
msgstr "পাঠান"

msgid "Close"
msgstr "বন্ধ করুন"

msgid "Sending…"
msgstr "পাঠানো হচ্ছে…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "পাঠানো হয়েছে। টিকিট #%s। আইটি বিভাগকে জানানো হয়েছে।"

msgid "Saved. It will be sent when this computer is online."
msgstr "সংরক্ষিত হয়েছে। এই কম্পিউটার অনলাইনে এলে পাঠানো হবে।"

msgid "Help requests are turned off at this school."
msgstr "এই স্কুলে সাহায্যের অনুরোধ বন্ধ করা আছে।"

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "আপনি এই ঘণ্টায় 3টি অনুরোধ পাঠিয়েছেন। অনুগ্রহ করে পরে আবার চেষ্টা করুন।"

msgid "Couldn't send. Please tell a teacher."
msgstr "পাঠানো যায়নি। অনুগ্রহ করে একজন শিক্ষককে জানান।"

msgid "IT is collecting diagnostic info from this computer."
msgstr "আইটি বিভাগ এই কম্পিউটার থেকে ডায়াগনস্টিক তথ্য সংগ্রহ করছে।"
