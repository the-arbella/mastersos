msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "מנוהל על ידי %s"

msgid "Shut down"
msgstr "כיבוי"

msgid "Browse as Guest"
msgstr "גלישה כאורח"

msgid "Apps"
msgstr "אפליקציות"

msgid "Cancel"
msgstr "ביטול"

msgid "Retry"
msgstr "ניסיון חוזר"

msgid "Opening the sign-in page…"
msgstr "דף הכניסה נפתח…"

msgid "The sign-in page could not be opened."
msgstr "לא ניתן לפתוח את דף הכניסה."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "אין חיבור לבית הספר. התחברו ל-Wi-Fi מהסרגל העליון ונסו שוב."

msgid "IT maintenance sign-in"
msgstr "כניסה לתחזוקת IT"

msgid "Username"
msgstr "שם משתמש"

msgid "This account cannot sign in on this computer."
msgstr "חשבון זה אינו יכול להיכנס במחשב הזה."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "חשבון זה אינו יכול להיכנס במחשב הזה. השתמשו בדוא״ל בית הספר שלכם (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "נכנסתם עם חשבון אחר. היכנסו שוב עם החשבון שבחרתם כאן."

msgid "Language"
msgstr "שפה"

msgid "Keyboard"
msgstr "מקלדת"

msgid "Continue"
msgstr "המשך"

msgid "The setting could not be saved. Try again."
msgstr "לא ניתן היה לשמור את ההגדרה. נסו שוב."

msgid "Your account is disabled. Contact your administrator."
msgstr "החשבון שלכם מושבת. פנו למנהל המערכת."

msgid "This device is disabled. Contact your administrator."
msgstr "המכשיר הזה מושבת. פנו למנהל המערכת."

msgid "Sign in with your school account."
msgstr "היכנסו עם חשבון בית הספר."

msgid "Could not sign in. Please try again."
msgstr "הכניסה נכשלה. נסו שוב."

msgid "Authentication request cancelled"
msgstr "בקשת האימות בוטלה"

msgid "Maximum number of authentication attempts reached"
msgstr "הגעתם למספר ניסיונות האימות המרבי"

msgid "Error retrieving access token. Please try again."
msgstr "שגיאה בקבלת אסימון הגישה. נסו שוב."

msgid "Invalid user name"
msgstr "שם משתמש לא תקין"

msgid "This computer has been locked by the school; please contact IT"
msgstr "המחשב הזה ננעל על ידי בית הספר; פנו לצוות ה-IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "כניסה כאורח אינה מותרת במחשב הזה"

msgid "Local accounts cannot sign in on this computer"
msgstr "חשבונות מקומיים אינם יכולים להיכנס במחשב הזה"

msgid "School accounts cannot sign in on this computer"
msgstr "חשבונות בית ספר אינם יכולים להיכנס במחשב הזה"

msgid "This app can only be opened from the sign-in screen"
msgstr "אפשר לפתוח את האפליקציה הזו רק ממסך הכניסה"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "האפליקציה הזו צריכה רשת. התחברו ל-Wi-Fi מהסרגל העליון ונסו שוב."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "אין רשת. התחברו ל-Wi-Fi מהתפריט שבפינה השמאלית העליונה."

msgid "Waiting for school settings."
msgstr "ממתין להגדרות בית הספר."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "דפדפן האינטרנט מותקן כעת. אפשר כבר להיכנס; הוא יופיע כשיהיה מוכן."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "עדיין לא ניתן היה להתקין את דפדפן האינטרנט; יתבצע ניסיון נוסף. אפשר להיכנס."

msgid "Name or school email"
msgstr "שם או דוא״ל בית הספר"

msgid "Keep typing to narrow down"
msgstr "המשיכו להקליד כדי לצמצם את הרשימה"

msgid "Get help"
msgstr "קבלת עזרה"

msgid "Get help from IT"
msgstr "קבלת עזרה מצוות ה-IT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "בעיה בכניסה"

msgid "An app"
msgstr "אפליקציה"

msgid "Screen, keys or sound"
msgstr "מסך, מקשים או צליל"

msgid "Battery"
msgstr "סוללה"

msgid "Other"
msgstr "אחר"

msgid "What happened? Please don't include passwords or personal details."
msgstr "מה קרה? נא לא לכלול סיסמאות או פרטים אישיים."

msgid "Attach a screenshot"
msgstr "צירוף צילום מסך"

msgid "Send"
msgstr "שליחה"

msgid "Close"
msgstr "סגירה"

msgid "Sending…"
msgstr "בשליחה…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "נשלח. קריאה #%s. צוות ה-IT עודכן."

msgid "Saved. It will be sent when this computer is online."
msgstr "נשמר. הפנייה תישלח כשהמחשב יתחבר לאינטרנט."

msgid "Help requests are turned off at this school."
msgstr "בקשות עזרה מושבתות בבית הספר הזה."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "שלחתם 3 בקשות בשעה הזו. נסו שוב מאוחר יותר."

msgid "Couldn't send. Please tell a teacher."
msgstr "השליחה נכשלה. ספרו למורה."

msgid "IT is collecting diagnostic info from this computer."
msgstr "צוות ה-IT אוסף מידע אבחוני מהמחשב הזה."
