msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Басқарушы: %s"

msgid "Shut down"
msgstr "Өшіру"

msgid "Browse as Guest"
msgstr "Қонақ ретінде шолу"

msgid "Apps"
msgstr "Қолданбалар"

msgid "Cancel"
msgstr "Бас тарту"

msgid "Retry"
msgstr "Қайталау"

msgid "Opening the sign-in page…"
msgstr "Кіру беті ашылуда…"

msgid "The sign-in page could not be opened."
msgstr "Кіру бетін ашу мүмкін болмады."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Мектепке қосылу мүмкін емес. Жоғарғы жолақтан Wi-Fi желісіне қосылып, қайталап көріңіз."

msgid "IT maintenance sign-in"
msgstr "IT қызмет көрсету үшін кіру"

msgid "Username"
msgstr "Пайдаланушы аты"

msgid "This account cannot sign in on this computer."
msgstr "Бұл тіркелгімен осы компьютерге кіру мүмкін емес."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Бұл тіркелгімен осы компьютерге кіру мүмкін емес. Мектеп поштасын (%s) пайдаланыңыз."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Бұл тіркелгімен осы компьютерге кіру мүмкін емес. Оның электрондық пошта мекенжайы расталмаған."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Сіз басқа тіркелгімен кірдіңіз. Осында таңдаған тіркелгімен қайта кіріңіз."

msgid "Language"
msgstr "Тіл"

msgid "Keyboard"
msgstr "Пернетақта"

msgid "Continue"
msgstr "Жалғастыру"

msgid "The setting could not be saved. Try again."
msgstr "Параметрді сақтау мүмкін болмады. Қайталап көріңіз."

msgid "Your account is disabled. Contact your administrator."
msgstr "Тіркелгіңіз өшірілген. Әкімшіге хабарласыңыз."

msgid "This device is disabled. Contact your administrator."
msgstr "Бұл құрылғы өшірілген. Әкімшіге хабарласыңыз."

msgid "Sign in with your school account."
msgstr "Мектеп тіркелгісімен кіріңіз."

msgid "Could not sign in. Please try again."
msgstr "Кіру мүмкін болмады. Қайталап көріңіз."

msgid "Authentication request cancelled"
msgstr "Аутентификация сұрауы тоқтатылды"

msgid "Maximum number of authentication attempts reached"
msgstr "Аутентификация әрекеттерінің ең көп саны таусылды"

msgid "Error retrieving access token. Please try again."
msgstr "Қолжетімділік токенін алу қатесі. Қайталап көріңіз."

msgid "Invalid user name"
msgstr "Пайдаланушы аты жарамсыз"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Бұл компьютерді мектеп құлыптаған; IT бөліміне хабарласыңыз"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Бұл компьютерде қонақ ретінде кіруге рұқсат жоқ"

msgid "Local accounts cannot sign in on this computer"
msgstr "Жергілікті тіркелгілермен бұл компьютерге кіру мүмкін емес"

msgid "School accounts cannot sign in on this computer"
msgstr "Мектеп тіркелгілерімен бұл компьютерге кіру мүмкін емес"

msgid "This app can only be opened from the sign-in screen"
msgstr "Бұл қолданбаны тек кіру экранынан ашуға болады"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Бұл қолданбаға желі қажет. Жоғарғы жолақтан Wi-Fi желісіне қосылып, қайталап көріңіз."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Желі жоқ. Жоғарғы оң жақтағы мәзірден Wi-Fi желісіне қосылыңыз."

msgid "Waiting for school settings."
msgstr "Мектеп баптауларын күту."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Веб-браузер орнатылуда. Кіре беруіңізге болады; дайын болғанда пайда болады."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Веб-браузерді әзірге орнату мүмкін болмады; қайта әрекет жасалады. Кіре беруіңізге болады."

msgid "Name or school email"
msgstr "Аты немесе мектеп электрондық поштасы"

msgid "Keep typing to narrow down"
msgstr "Тізімді тарылту үшін теруді жалғастырыңыз"

msgid "Get help"
msgstr "Көмек сұрау"

msgid "Get help from IT"
msgstr "IT бөлімінен көмек сұрау"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Кіре алмаймын"

msgid "An app"
msgstr "Қолданба"

msgid "Screen, keys or sound"
msgstr "Экран, пернелер немесе дыбыс"

msgid "Battery"
msgstr "Батарея"

msgid "Other"
msgstr "Басқа"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Не болды? Құпиясөздерді немесе жеке деректерді жазбаңыз."

msgid "Attach a screenshot"
msgstr "Скриншот тіркеу"

msgid "Send"
msgstr "Жіберу"

msgid "Close"
msgstr "Жабу"

msgid "Sending…"
msgstr "Жіберілуде…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Жіберілді. Өтінім #%s. IT бөліміне хабарланды."

msgid "Saved. It will be sent when this computer is online."
msgstr "Сақталды. Бұл компьютер желіге қосылғанда жіберіледі."

msgid "Help requests are turned off at this school."
msgstr "Бұл мектепте көмек сұрау өшірілген."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Осы сағатта 3 сұрау жібердіңіз. Кейінірек қайталап көріңіз."

msgid "Couldn't send. Please tell a teacher."
msgstr "Жіберу мүмкін болмады. Мұғалімге айтыңыз."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT бөлімі осы компьютерден диагностикалық деректер жинап жатыр."
