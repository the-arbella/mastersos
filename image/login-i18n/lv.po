msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Pārvalda: %s"

msgid "Shut down"
msgstr "Izslēgt"

msgid "Browse as Guest"
msgstr "Pārlūkot kā viesim"

msgid "Apps"
msgstr "Lietotnes"

msgid "Cancel"
msgstr "Atcelt"

msgid "Retry"
msgstr "Mēģināt vēlreiz"

msgid "Opening the sign-in page…"
msgstr "Tiek atvērta pieteikšanās lapa…"

msgid "The sign-in page could not be opened."
msgstr "Pieteikšanās lapu neizdevās atvērt."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Nevar sazināties ar skolu. Izveidojiet savienojumu ar Wi-Fi augšējā joslā un mēģiniet vēlreiz."

msgid "IT maintenance sign-in"
msgstr "IT uzturēšanas pieteikšanās"

msgid "Username"
msgstr "Lietotājvārds"

msgid "This account cannot sign in on this computer."
msgstr "Ar šo kontu šajā datorā pieteikties nevar."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Ar šo kontu šajā datorā pieteikties nevar. Izmantojiet savu skolas e-pastu (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Jūs pieteicāties ar citu kontu. Pieteikties vēlreiz ar šeit izvēlēto kontu."

msgid "Language"
msgstr "Valoda"

msgid "Keyboard"
msgstr "Tastatūra"

msgid "Continue"
msgstr "Turpināt"

msgid "The setting could not be saved. Try again."
msgstr "Iestatījumu neizdevās saglabāt. Mēģiniet vēlreiz."

msgid "Your account is disabled. Contact your administrator."
msgstr "Jūsu konts ir atspējots. Sazinieties ar administratoru."

msgid "This device is disabled. Contact your administrator."
msgstr "Šī ierīce ir atspējota. Sazinieties ar administratoru."

msgid "Sign in with your school account."
msgstr "Piesakieties ar savu skolas kontu."

msgid "Could not sign in. Please try again."
msgstr "Pieteikties neizdevās. Lūdzu, mēģiniet vēlreiz."

msgid "Authentication request cancelled"
msgstr "Autentifikācijas pieprasījums atcelts"

msgid "Maximum number of authentication attempts reached"
msgstr "Sasniegts maksimālais autentifikācijas mēģinājumu skaits"

msgid "Error retrieving access token. Please try again."
msgstr "Kļūda, iegūstot piekļuves pilnvaru. Lūdzu, mēģiniet vēlreiz."

msgid "Invalid user name"
msgstr "Nederīgs lietotājvārds"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Skola ir bloķējusi šo datoru; sazinieties ar IT speciālistiem"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Šajā datorā pieteikšanās kā viesim nav atļauta"

msgid "Local accounts cannot sign in on this computer"
msgstr "Vietējie konti šajā datorā pieteikties nevar"

msgid "School accounts cannot sign in on this computer"
msgstr "Skolas konti šajā datorā pieteikties nevar"

msgid "This app can only be opened from the sign-in screen"
msgstr "Šo lietotni var atvērt tikai no pieteikšanās ekrāna"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Šai lietotnei ir nepieciešams tīkls. Izveidojiet savienojumu ar Wi-Fi augšējā joslā un mēģiniet vēlreiz."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Nav tīkla. Izvēlieties Wi-Fi tīklu izvēlnē augšējā labajā stūrī vai pievienojiet tīkla kabeli vai tālruni ar USB piesaisti."

msgid "Waiting for school settings."
msgstr "Gaida skolas iestatījumus."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Notiek tīmekļa pārlūka instalēšana. Varat pieteikties; tas parādīsies, kad būs gatavs."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Tīmekļa pārlūku vēl neizdevās instalēt; tiks mēģināts vēlreiz. Varat pieteikties."

msgid "Name or school email"
msgstr "Vārds vai skolas e-pasts"

msgid "Keep typing to narrow down"
msgstr "Turpiniet rakstīt, lai sašaurinātu sarakstu"
