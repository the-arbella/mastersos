msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Administrata de %s"

msgid "Shut down"
msgstr "Malŝalti"

msgid "Browse as Guest"
msgstr "Foliumi kiel gasto"

msgid "Add person"
msgstr "Aldoni personon"

msgid "Apps"
msgstr "Aplikaĵoj"

msgid "Cancel"
msgstr "Nuligi"

msgid "Retry"
msgstr "Reprovi"

msgid "Opening the sign-in page…"
msgstr "Malfermas la saluta paĝo…"

msgid "The sign-in page could not be opened."
msgstr "La saluta paĝo ne povis esti malfermita."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ne eblas atingi la lernejon. Konektu al Wi-Fi per la supra breto kaj reprovu."

msgid "School email"
msgstr "Lerneja retpoŝto"

msgid "IT local account"
msgstr "Loka konto de IT"

msgid "Username"
msgstr "Uzantnomo"

msgid "This account cannot sign in on this computer."
msgstr "Ĉi tiu konto ne povas saluti en ĉi tiu komputilo."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Ĉi tiu konto ne povas saluti en ĉi tiu komputilo. Uzu vian lernejan retpoŝton (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Vi salutis per alia konto. Salutu denove per la konto, kiun vi elektis ĉi tie."

msgid "Language"
msgstr "Lingvo"

msgid "Keyboard"
msgstr "Klavaro"

msgid "Continue"
msgstr "Daŭrigi"

msgid "The setting could not be saved. Try again."
msgstr "La agordo ne povis esti konservita. Reprovu."

msgid "Your account is disabled. Contact your administrator."
msgstr "Via konto estas malŝaltita. Kontaktu vian administranton."

msgid "This device is disabled. Contact your administrator."
msgstr "Ĉi tiu aparato estas malŝaltita. Kontaktu vian administranton."

msgid "Sign in with your school account."
msgstr "Salutu per via lerneja konto."

msgid "Could not sign in. Please try again."
msgstr "Saluto ne eblis. Bonvolu reprovi."

msgid "Authentication request cancelled"
msgstr "La aŭtentiga peto estis nuligita"

msgid "Maximum number of authentication attempts reached"
msgstr "La maksimuma nombro de aŭtentigaj provoj estas atingita"

msgid "Error retrieving access token. Please try again."
msgstr "Eraro dum akiro de la alirsigno. Bonvolu reprovi."

msgid "Invalid user name"
msgstr "Nevalida uzantnomo"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Ĉi tiu komputilo estas ŝlosita de la lernejo; bonvolu kontakti IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Gasta saluto ne estas permesita en ĉi tiu komputilo"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokaj kontoj ne povas saluti en ĉi tiu komputilo"

msgid "School accounts cannot sign in on this computer"
msgstr "Lernejaj kontoj ne povas saluti en ĉi tiu komputilo"

msgid "This app can only be opened from the sign-in screen"
msgstr "Ĉi tiu aplikaĵo malfermeblas nur de la saluta ekrano"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ĉi tiu aplikaĵo bezonas reton. Konektu al Wi-Fi per la supra breto kaj reprovu."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Neniu reto. Elektu Wi-Fi-reton en la menuo supre dekstre, aŭ konektu retkablon aŭ telefonon, kiu kunhavigas sian konekton per USB."

msgid "Waiting for school settings."
msgstr "Atendante la agordojn de la lernejo."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Instalante la retumilon. Vi povas saluti; ĝi aperos, kiam ĝi estos preta."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "La retumilo ankoraŭ ne povis esti instalita; ĝi estos reprovita. Vi povas saluti."
