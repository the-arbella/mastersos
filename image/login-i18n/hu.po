msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Kezeli: %s"

msgid "Shut down"
msgstr "Leállítás"

msgid "Browse as Guest"
msgstr "Böngészés vendégként"

msgid "Add person"
msgstr "Személy hozzáadása"

msgid "Apps"
msgstr "Alkalmazások"

msgid "Cancel"
msgstr "Mégse"

msgid "Retry"
msgstr "Újra"

msgid "Opening the sign-in page…"
msgstr "A bejelentkezési oldal megnyitása…"

msgid "The sign-in page could not be opened."
msgstr "A bejelentkezési oldal nem nyitható meg."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Az iskola nem érhető el. Csatlakozz a Wi-Fi-hez a felső sávon, majd próbáld újra."

msgid "School email"
msgstr "Iskolai e-mail-cím"

msgid "Local manager"
msgstr "Helyi rendszergazda"

msgid "Username"
msgstr "Felhasználónév"

msgid "This account cannot sign in on this computer."
msgstr "Ez a fiók nem tud bejelentkezni ezen a számítógépen."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Ez a fiók nem tud bejelentkezni ezen a számítógépen. Használd az iskolai e-mail-címedet (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Másik fiókkal jelentkeztél be. Jelentkezz be újra az itt kiválasztott fiókkal."

msgid "Language"
msgstr "Nyelv"

msgid "Keyboard"
msgstr "Billentyűzet"

msgid "Continue"
msgstr "Tovább"

msgid "The setting could not be saved. Try again."
msgstr "A beállítást nem sikerült menteni. Próbáld újra."

msgid "Your account is disabled. Contact your administrator."
msgstr "A fiókod le van tiltva. Fordulj a rendszergazdához."

msgid "This device is disabled. Contact your administrator."
msgstr "Ez az eszköz le van tiltva. Fordulj a rendszergazdához."

msgid "Sign in with your school account."
msgstr "Jelentkezz be az iskolai fiókoddal."

msgid "Could not sign in. Please try again."
msgstr "A bejelentkezés nem sikerült. Próbáld újra."

msgid "Authentication request cancelled"
msgstr "A hitelesítési kérés megszakítva"

msgid "Maximum number of authentication attempts reached"
msgstr "Elérted a hitelesítési kísérletek maximális számát"

msgid "Error retrieving access token. Please try again."
msgstr "Hiba a hozzáférési token lekérésekor. Próbáld újra."

msgid "Invalid user name"
msgstr "Érvénytelen felhasználónév"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Az iskola zárolta ezt a számítógépet; fordulj az informatikushoz"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Vendégként nem lehet bejelentkezni ezen a számítógépen"

msgid "Local accounts cannot sign in on this computer"
msgstr "Helyi fiókok nem jelentkezhetnek be ezen a számítógépen"

msgid "School accounts cannot sign in on this computer"
msgstr "Iskolai fiókok nem jelentkezhetnek be ezen a számítógépen"

msgid "This app can only be opened from the sign-in screen"
msgstr "Ez az alkalmazás csak a bejelentkezési képernyőről nyitható meg"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ennek az alkalmazásnak hálózatra van szüksége. Csatlakozz a Wi-Fi-hez a felső sávon, majd próbáld újra."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Nincs hálózat. Válassz Wi-Fi-hálózatot a jobb felső menüben, vagy csatlakoztass hálózati kábelt vagy USB-n internetet megosztó telefont."

msgid "Waiting for school settings."
msgstr "Várakozás az iskolai beállításokra."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "A webböngésző telepítése folyamatban. Bejelentkezhetsz; megjelenik, amikor elkészült."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "A webböngészőt még nem sikerült telepíteni; a rendszer újra megpróbálja. Bejelentkezhetsz."
