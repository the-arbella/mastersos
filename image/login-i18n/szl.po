msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: szl\n"

msgid "Managed by %s"
msgstr "Zarzōndzane bez %s"

msgid "Shut down"
msgstr "Wyłōncz"

msgid "Browse as Guest"
msgstr "Przeglōndej jako gość"

msgid "Add person"
msgstr "Przidej ôsobã"

msgid "Apps"
msgstr "Aplikacyje"

msgid "Cancel"
msgstr "Anuluj"

msgid "Retry"
msgstr "Sprōbuj zaś"

msgid "Opening the sign-in page…"
msgstr "Ôtwiyranie zajty logowaniŏ…"

msgid "The sign-in page could not be opened."
msgstr "Niy szło ôtwarcić zajty logowaniŏ."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Niy idzie sie połōnczyć ze szkołōm. Połōncz sie z Wi-Fi z gōrnego posku, a potym sprōbuj zaś."

msgid "School email"
msgstr "Szkolny e-mejl"

msgid "IT local account"
msgstr "Lokalne kōnto IT"

msgid "Username"
msgstr "Miano użytkowńika"

msgid "This account cannot sign in on this computer."
msgstr "To kōnto niy może sie zalogować na tym kōmputrze."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "To kōnto niy może sie zalogować na tym kōmputrze. Użyj szkolnego e-mejla (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Zalogowôłeś sie na inksze kōnto. Zaloguj sie zaś na kōnto, kere ôbrôłeś tukej."

msgid "Language"
msgstr "Gŏdka"

msgid "Keyboard"
msgstr "Klawiatura"

msgid "Continue"
msgstr "Dalij"

msgid "The setting could not be saved. Try again."
msgstr "Niy szło zapisać sztelōnku. Sprōbuj zaś."

msgid "Your account is disabled. Contact your administrator."
msgstr "Twoje kōnto je zablokowane. Skōntaktuj sie ze swojim administratorym."

msgid "This device is disabled. Contact your administrator."
msgstr "To urzōndzynie je zablokowane. Skōntaktuj sie ze swojim administratorym."

msgid "Sign in with your school account."
msgstr "Zaloguj sie na szkolne kōnto."

msgid "Could not sign in. Please try again."
msgstr "Niy szło sie zalogować. Sprōbuj zaś."

msgid "Authentication request cancelled"
msgstr "Wniosek ô uwierzytelniynie ôstoł anulowany"

msgid "Maximum number of authentication attempts reached"
msgstr "Dosiōngnyto maksymalnõ ilość prōb uwierzytelniynia"

msgid "Error retrieving access token. Please try again."
msgstr "Feler przi pobiyraniu tokynu dostympu. Sprōbuj zaś."

msgid "Invalid user name"
msgstr "Niyprawidłowe miano użytkowńika"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Tyn kōmputer ôstoł zablokowany bez szkołã; skōntaktuj sie z IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Logowanie jako gość niy je dozwolone na tym kōmputrze"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokalne kōnta niy mogōm sie logować na tym kōmputrze"

msgid "School accounts cannot sign in on this computer"
msgstr "Szkolne kōnta niy mogōm sie logować na tym kōmputrze"

msgid "This app can only be opened from the sign-in screen"
msgstr "Ta aplikacyjŏ może być ôtwarta yno z ekranu logowaniŏ"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ta aplikacyjo potrzebuje siyci. Połōncz sie z Wi-Fi z gōrnego posku, a potym sprōbuj zaś."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Niy ma siyci. Wybier siyć Wi-Fi w menu w prawym gōrnym rogu abo podłōncz kabel sieciowy abo telefōn z tetheringiym USB."

msgid "Waiting for school settings."
msgstr "Czekanie na ustawiynia szkoły."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Instalowanie przeglōndarki. Możesz sie już zalogować; pokoże sie, jak bydzie fertich."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Niy szło jeszcze zainstalować przeglōndarki; bydzie prōbowane zaś. Możesz sie zalogować."
