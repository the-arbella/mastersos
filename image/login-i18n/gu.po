msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s દ્વારા સંચાલિત"

msgid "Shut down"
msgstr "શટ ડાઉન કરો"

msgid "Browse as Guest"
msgstr "મહેમાન તરીકે બ્રાઉઝ કરો"

msgid "Apps"
msgstr "એપ્સ"

msgid "Cancel"
msgstr "રદ કરો"

msgid "Retry"
msgstr "ફરી પ્રયાસ કરો"

msgid "Opening the sign-in page…"
msgstr "સાઇન-ઇન પેજ ખુલી રહ્યું છે…"

msgid "The sign-in page could not be opened."
msgstr "સાઇન-ઇન પેજ ખોલી શકાયું નથી."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "શાળા સુધી પહોંચી શકાતું નથી. ઉપરની પટ્ટીમાંથી Wi-Fi સાથે જોડાઓ, પછી ફરી પ્રયાસ કરો."

msgid "IT maintenance sign-in"
msgstr "IT જાળવણી સાઇન-ઇન"

msgid "Username"
msgstr "વપરાશકર્તા નામ"

msgid "This account cannot sign in on this computer."
msgstr "આ ખાતું આ કમ્પ્યુટર પર સાઇન ઇન કરી શકતું નથી."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "આ ખાતું આ કમ્પ્યુટર પર સાઇન ઇન કરી શકતું નથી. તમારું શાળાનું ઇમેઇલ (%s) વાપરો."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "તમે બીજા ખાતાથી સાઇન ઇન કર્યું. અહીં પસંદ કરેલા ખાતાથી ફરીથી સાઇન ઇન કરો."

msgid "Language"
msgstr "ભાષા"

msgid "Keyboard"
msgstr "કીબોર્ડ"

msgid "Continue"
msgstr "ચાલુ રાખો"

msgid "The setting could not be saved. Try again."
msgstr "સેટિંગ સાચવી શકાયું નથી. ફરી પ્રયાસ કરો."

msgid "Your account is disabled. Contact your administrator."
msgstr "તમારું ખાતું અક્ષમ છે. તમારા એડમિનિસ્ટ્રેટરનો સંપર્ક કરો."

msgid "This device is disabled. Contact your administrator."
msgstr "આ ઉપકરણ અક્ષમ છે. તમારા એડમિનિસ્ટ્રેટરનો સંપર્ક કરો."

msgid "Sign in with your school account."
msgstr "તમારા શાળાના ખાતાથી સાઇન ઇન કરો."

msgid "Could not sign in. Please try again."
msgstr "સાઇન ઇન થઈ શકાયું નથી. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Authentication request cancelled"
msgstr "પ્રમાણીકરણ વિનંતી રદ કરવામાં આવી"

msgid "Maximum number of authentication attempts reached"
msgstr "પ્રમાણીકરણના પ્રયાસોની મહત્તમ સંખ્યા પહોંચી ગઈ"

msgid "Error retrieving access token. Please try again."
msgstr "એક્સેસ ટોકન મેળવવામાં ભૂલ. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Invalid user name"
msgstr "અમાન્ય વપરાશકર્તા નામ"

msgid "This computer has been locked by the school; please contact IT"
msgstr "આ કમ્પ્યુટર શાળા દ્વારા લૉક કરવામાં આવ્યું છે; કૃપા કરીને IT નો સંપર્ક કરો"

msgid "Guest sign-in is not allowed on this computer"
msgstr "આ કમ્પ્યુટર પર મહેમાન સાઇન-ઇનની મંજૂરી નથી"

msgid "Local accounts cannot sign in on this computer"
msgstr "સ્થાનિક ખાતાં આ કમ્પ્યુટર પર સાઇન ઇન કરી શકતાં નથી"

msgid "School accounts cannot sign in on this computer"
msgstr "શાળાનાં ખાતાં આ કમ્પ્યુટર પર સાઇન ઇન કરી શકતાં નથી"

msgid "This app can only be opened from the sign-in screen"
msgstr "આ એપ ફક્ત સાઇન-ઇન સ્ક્રીન પરથી જ ખોલી શકાય છે"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "આ એપને નેટવર્કની જરૂર છે. ઉપરની પટ્ટીમાંથી Wi-Fi સાથે જોડાઓ, પછી ફરી પ્રયાસ કરો."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "નેટવર્ક નથી. ઉપર જમણી બાજુના મેનૂમાંથી Wi-Fi સાથે જોડાઓ."

msgid "Waiting for school settings."
msgstr "શાળાના સેટિંગ્સની રાહ જોવાઈ રહી છે."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "વેબ બ્રાઉઝર ઇન્સ્ટોલ થઈ રહ્યું છે. તમે સાઇન ઇન કરી શકો છો; તૈયાર થાય ત્યારે તે દેખાશે."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "વેબ બ્રાઉઝર હજી ઇન્સ્ટોલ થઈ શક્યું નથી; ફરી પ્રયાસ કરવામાં આવશે. તમે સાઇન ઇન કરી શકો છો."

msgid "Name or school email"
msgstr "નામ અથવા શાળાનું ઇમેઇલ"

msgid "Keep typing to narrow down"
msgstr "યાદી ટૂંકી કરવા ટાઇપ કરવાનું ચાલુ રાખો"

msgid "Get help"
msgstr "મદદ મેળવો"

msgid "Get help from IT"
msgstr "IT પાસેથી મદદ મેળવો"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "સાઇન ઇન થઈ શકતું નથી"

msgid "An app"
msgstr "કોઈ ઍપ"

msgid "Screen, keys or sound"
msgstr "સ્ક્રીન, કી અથવા અવાજ"

msgid "Battery"
msgstr "બૅટરી"

msgid "Other"
msgstr "અન્ય"

msgid "What happened? Please don't include passwords or personal details."
msgstr "શું થયું? કૃપા કરીને પાસવર્ડ અથવા વ્યક્તિગત વિગતો લખશો નહીં."

msgid "Attach a screenshot"
msgstr "સ્ક્રીનશૉટ જોડો"

msgid "Send"
msgstr "મોકલો"

msgid "Close"
msgstr "બંધ કરો"

msgid "Sending…"
msgstr "મોકલી રહ્યાં છીએ…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "મોકલાયું. ટિકિટ #%s. IT ને જાણ કરવામાં આવી છે."

msgid "Saved. It will be sent when this computer is online."
msgstr "સાચવ્યું. આ કમ્પ્યુટર ઑનલાઇન થશે ત્યારે મોકલાશે."

msgid "Help requests are turned off at this school."
msgstr "આ શાળામાં મદદ વિનંતીઓ બંધ છે."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "તમે આ કલાકમાં 3 વિનંતીઓ મોકલી છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો."

msgid "Couldn't send. Please tell a teacher."
msgstr "મોકલી શકાયું નથી. કૃપા કરીને શિક્ષકને જણાવો."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT આ કમ્પ્યુટરમાંથી નિદાન માહિતી એકત્ર કરી રહ્યું છે."
