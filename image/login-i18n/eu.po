msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "%s(e)k kudeatua"

msgid "Shut down"
msgstr "Itzali"

msgid "Browse as Guest"
msgstr "Arakatu gonbidatu gisa"

msgid "Apps"
msgstr "Aplikazioak"

msgid "Cancel"
msgstr "Utzi"

msgid "Retry"
msgstr "Saiatu berriro"

msgid "Opening the sign-in page…"
msgstr "Saioa hasteko orria irekitzen…"

msgid "The sign-in page could not be opened."
msgstr "Ezin izan da saioa hasteko orria ireki."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ezin da ikastetxea atzitu. Konektatu Wi-Fi sarera goiko barratik eta saiatu berriro."

msgid "IT maintenance sign-in"
msgstr "IT mantentze-saioa hastea"

msgid "Username"
msgstr "Erabiltzaile-izena"

msgid "This account cannot sign in on this computer."
msgstr "Kontu honek ezin du saioa hasi ordenagailu honetan."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Kontu honek ezin du saioa hasi ordenagailu honetan. Erabili zure ikastetxeko posta elektronikoa (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Beste kontu batekin hasi duzu saioa. Hasi saioa berriro hemen aukeratu duzun kontuarekin."

msgid "Language"
msgstr "Hizkuntza"

msgid "Keyboard"
msgstr "Teklatua"

msgid "Continue"
msgstr "Jarraitu"

msgid "The setting could not be saved. Try again."
msgstr "Ezin izan da ezarpena gorde. Saiatu berriro."

msgid "Your account is disabled. Contact your administrator."
msgstr "Zure kontua desgaituta dago. Jarri harremanetan administratzailearekin."

msgid "This device is disabled. Contact your administrator."
msgstr "Gailu hau desgaituta dago. Jarri harremanetan administratzailearekin."

msgid "Sign in with your school account."
msgstr "Hasi saioa zure ikastetxeko kontuarekin."

msgid "Could not sign in. Please try again."
msgstr "Ezin izan da saioa hasi. Saiatu berriro."

msgid "Authentication request cancelled"
msgstr "Autentifikazio-eskaera bertan behera utzi da"

msgid "Maximum number of authentication attempts reached"
msgstr "Autentifikazio-saiakeren gehieneko kopurura iritsi da"

msgid "Error retrieving access token. Please try again."
msgstr "Errorea sarbide-tokena eskuratzean. Saiatu berriro."

msgid "Invalid user name"
msgstr "Erabiltzaile-izen baliogabea"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Ikastetxeak ordenagailu hau blokeatu du; jarri harremanetan IT sailarekin"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Ordenagailu honetan ez da onartzen gonbidatu gisa saioa hastea"

msgid "Local accounts cannot sign in on this computer"
msgstr "Kontu lokalek ezin dute saioa hasi ordenagailu honetan"

msgid "School accounts cannot sign in on this computer"
msgstr "Ikastetxeko kontuek ezin dute saioa hasi ordenagailu honetan"

msgid "This app can only be opened from the sign-in screen"
msgstr "Aplikazio hau saioa hasteko pantailatik soilik ireki daiteke"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Aplikazio honek sarea behar du. Konektatu Wi-Fi sarera goiko barratik eta saiatu berriro."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Ez dago sarerik. Konektatu Wi-Fi sarera goiko eskuineko menutik."

msgid "Waiting for school settings."
msgstr "Ikastetxeko ezarpenen zain."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Web arakatzailea instalatzen. Saioa has dezakezu; prest dagoenean agertuko da."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Oraindik ezin izan da web arakatzailea instalatu; berriro saiatuko da. Saioa has dezakezu."

msgid "Name or school email"
msgstr "Izena edo ikastetxeko posta elektronikoa"

msgid "Keep typing to narrow down"
msgstr "Jarraitu idazten zerrenda murrizteko"

msgid "Get help"
msgstr "Eskatu laguntza"

msgid "Get help from IT"
msgstr "Eskatu laguntza IT sailari"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Ezin dut saioa hasi"

msgid "An app"
msgstr "Aplikazio bat"

msgid "Screen, keys or sound"
msgstr "Pantaila, teklak edo soinua"

msgid "Battery"
msgstr "Bateria"

msgid "Other"
msgstr "Bestelakoa"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Zer gertatu da? Ez idatzi pasahitzik edo datu pertsonalik."

msgid "Attach a screenshot"
msgstr "Erantsi pantaila-argazki bat"

msgid "Send"
msgstr "Bidali"

msgid "Close"
msgstr "Itxi"

msgid "Sending…"
msgstr "Bidaltzen…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Bidalita. #%s txartela. IT saila jakinaren gainean dago."

msgid "Saved. It will be sent when this computer is online."
msgstr "Gordeta. Ordenagailu hau linean dagoenean bidaliko da."

msgid "Help requests are turned off at this school."
msgstr "Laguntza-eskaerak desaktibatuta daude ikastetxe honetan."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "3 eskaera bidali dituzu ordu honetan. Saiatu berriro geroago."

msgid "Couldn't send. Please tell a teacher."
msgstr "Ezin izan da bidali. Esan irakasle bati."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT saila ordenagailu honetako diagnostiko-informazioa biltzen ari da."
