msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Merañ a ra %s"

msgid "Shut down"
msgstr "Lazhañ"

msgid "Browse as Guest"
msgstr "Merdeiñ evel den pedet"

msgid "Apps"
msgstr "Arloadoù"

msgid "Cancel"
msgstr "Nullañ"

msgid "Retry"
msgstr "Klask en-dro"

msgid "Opening the sign-in page…"
msgstr "O tigeriñ ar bajenn gevreañ…"

msgid "The sign-in page could not be opened."
msgstr "Ne c'haller ket digeriñ ar bajenn gevreañ."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ne c'haller ket tizhout ar skol. Kevreit ouzh ur rouedad Wi-Fi diwar ar varrenn el laez, hag adklaskit."

msgid "IT maintenance sign-in"
msgstr "Kevreañ evit trezalc'h an urzhiataerezh"

msgid "Username"
msgstr "Anv implijer"

msgid "This account cannot sign in on this computer."
msgstr "Ne c'hall ket ar gont-mañ kevreañ er mikrourzhiataer-mañ."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Ne c'hall ket ar gont-mañ kevreañ er mikrourzhiataer-mañ. Implijit postel ho skol (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Kevreet oc'h gant ur gont all. Kevreit en-dro gant ar gont hoc'h eus dibabet amañ."

msgid "Language"
msgstr "Yezh"

msgid "Keyboard"
msgstr "Klavier"

msgid "Continue"
msgstr "Kenderc'hel"

msgid "The setting could not be saved. Try again."
msgstr "Ne c'haller ket enrollañ an arventenn. Klaskit en-dro."

msgid "Your account is disabled. Contact your administrator."
msgstr "Diweredekaet eo ho kont. Darempredit ho merour."

msgid "This device is disabled. Contact your administrator."
msgstr "Diweredekaet eo an trevnad-mañ. Darempredit ho merour."

msgid "Sign in with your school account."
msgstr "Kevreit gant kont ho skol."

msgid "Could not sign in. Please try again."
msgstr "Ne c'haller ket kevreañ. Klaskit en-dro mar plij."

msgid "Authentication request cancelled"
msgstr "Nullet eo bet ar reked dilesadur"

msgid "Maximum number of authentication attempts reached"
msgstr "Tizhet eo bet an niver brasañ a esaeoù dilesadur"

msgid "Error retrieving access token. Please try again."
msgstr "Fazi en ur gavout ar jeton moned. Klaskit en-dro mar plij."

msgid "Invalid user name"
msgstr "Anv implijer direizh"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Prennet eo bet ar mikrourzhiataer-mañ gant ar skol; darempredit an TIC mar plij"

msgid "Guest sign-in is not allowed on this computer"
msgstr "N'eo ket aotreet ar gevreadur evel den pedet er mikrourzhiataer-mañ"

msgid "Local accounts cannot sign in on this computer"
msgstr "Ne c'hall ket ar c'hontoù lec'hel kevreañ er mikrourzhiataer-mañ"

msgid "School accounts cannot sign in on this computer"
msgstr "Ne c'hall ket kontoù ar skol kevreañ er mikrourzhiataer-mañ"

msgid "This app can only be opened from the sign-in screen"
msgstr "An arload-mañ ne c'hall bezañ digoret nemet diwar skramm ar gevreadur"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "An arload-mañ en deus ezhomm eus ur rouedad. Kevreit ouzh ur rouedad Wi-Fi diwar ar varrenn el laez, hag adklaskit."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Rouedad ebet. Kevreit ouzh ur rouedad Wi-Fi diwar al lañser e-krec'h a-zehou."

msgid "Waiting for school settings."
msgstr "O c'hortoz arventennoù ar skol."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "O staliañ ar merdeer web. Gallout a rit kevreañ; dont a raio war wel pa vo prest."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "N'eus ket bet gallet staliañ ar merdeer web c'hoazh; klasket e vo en-dro. Gallout a rit kevreañ."

msgid "Name or school email"
msgstr "Anv pe postel ar skol"

msgid "Keep typing to narrow down"
msgstr "Kendalc'hit da skrivañ evit strishaat ar roll"

msgid "Get help"
msgstr "Goulenn skoazell"

msgid "Get help from IT"
msgstr "Goulenn skoazell digant an TIC"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Ne c'hallan ket kevreañ"

msgid "An app"
msgstr "Un arload"

msgid "Screen, keys or sound"
msgstr "Skramm, stokelloù pe son"

msgid "Battery"
msgstr "Batiri"

msgid "Other"
msgstr "All"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Petra zo c'hoarvezet? Na lakait ket gerioù-tremen na titouroù personel, mar plij."

msgid "Attach a screenshot"
msgstr "Stagañ ur skeudenn-skramm"

msgid "Send"
msgstr "Kas"

msgid "Close"
msgstr "Serriñ"

msgid "Sending…"
msgstr "O kas…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Kaset. Tiked #%s. Kelaouet eo bet an TIC."

msgid "Saved. It will be sent when this computer is online."
msgstr "Enrollet. Kaset e vo pa vo kevreet ar mikrourzhiataer-mañ ouzh ar genrouedad."

msgid "Help requests are turned off at this school."
msgstr "Diweredekaet eo ar goulennoù skoazell er skol-mañ."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Kaset hoc'h eus 3 goulenn an eurvezh-mañ. Klaskit en-dro diwezhatoc'h, mar plij."

msgid "Couldn't send. Please tell a teacher."
msgstr "N'eus ket bet gallet kas. Lavarit d'ur c'helenner, mar plij."

msgid "IT is collecting diagnostic info from this computer."
msgstr "An TIC a zastum titouroù diagnostik diwar ar mikrourzhiataer-mañ."
