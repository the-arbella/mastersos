msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Administrau por %s"

msgid "Shut down"
msgstr "Amortar"

msgid "Browse as Guest"
msgstr "Navegar como convidau"

msgid "Apps"
msgstr "Aplicacions"

msgid "Cancel"
msgstr "Cancelar"

msgid "Retry"
msgstr "Reintentar"

msgid "Opening the sign-in page…"
msgstr "Ubrindo a pachina d'inicio de sesión…"

msgid "The sign-in page could not be opened."
msgstr "No s'ha puesto ubrir a pachina d'inicio de sesión."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "No se puede connectar con a escuela. Connecta-te a una Wi-Fi dende a barra superior y torna a intentar-lo."

msgid "IT maintenance sign-in"
msgstr "Inicio de sesión de mantenimiento informatico"

msgid "Username"
msgstr "Nombre d'usuario"

msgid "This account cannot sign in on this computer."
msgstr "Esta cuenta no puede iniciar sesión en este ordenador."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Esta cuenta no puede iniciar sesión en este ordenador. Usa o tuyo correu d'a escuela (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Has iniciau sesión con una atra cuenta. Torna a iniciar sesión con a cuenta que has triau aquí."

msgid "Language"
msgstr "Idioma"

msgid "Keyboard"
msgstr "Teclau"

msgid "Continue"
msgstr "Continar"

msgid "The setting could not be saved. Try again."
msgstr "No s'ha puesto alzar l'achuste. Torna a intentar-lo."

msgid "Your account is disabled. Contact your administrator."
msgstr "A tuya cuenta ye desactivada. Contacta con o tuyo administrador."

msgid "This device is disabled. Contact your administrator."
msgstr "Este dispositivo ye desactivau. Contacta con o tuyo administrador."

msgid "Sign in with your school account."
msgstr "Inicia sesión con a tuya cuenta d'a escuela."

msgid "Could not sign in. Please try again."
msgstr "No s'ha puesto iniciar sesión. Torna a intentar-lo."

msgid "Authentication request cancelled"
msgstr "Solicitut d'autenticación cancelada"

msgid "Maximum number of authentication attempts reached"
msgstr "S'ha plegau a o numero maximo d'intentos d'autenticación"

msgid "Error retrieving access token. Please try again."
msgstr "Error en obtener o token d'acceso. Torna a intentar-lo."

msgid "Invalid user name"
msgstr "Nombre d'usuario no valido"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Este ordenador ye bloqueyau por a escuela; contacta con TI"

msgid "Guest sign-in is not allowed on this computer"
msgstr "No se permite l'inicio de sesión como convidau en este ordenador"

msgid "Local accounts cannot sign in on this computer"
msgstr "As cuentas locals no pueden iniciar sesión en este ordenador"

msgid "School accounts cannot sign in on this computer"
msgstr "As cuentas d'a escuela no pueden iniciar sesión en este ordenador"

msgid "This app can only be opened from the sign-in screen"
msgstr "Esta aplicación nomás se puede ubrir dende a pantalla d'inicio de sesión"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Esta aplicación necesita una reixa. Connecta-te a una Wi-Fi dende a barra superior y torna a intentar-lo."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "No i hai reixa. Connecta-te a una Wi-Fi dende o menú d'alto a la dreita."

msgid "Waiting for school settings."
msgstr "Asperando a configuración d'a escuela."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Se ye instalando o navegador web. Puetz iniciar sesión; amaneixerá quan sía listo."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "No s'ha puesto instalar encara o navegador web; se tornará a intentar. Puetz iniciar sesión."

msgid "Name or school email"
msgstr "Nombre u correu d'a escuela"

msgid "Keep typing to narrow down"
msgstr "Contina escribindo pa reducir a lista"

msgid "Get help"
msgstr "Demandar aduya"

msgid "Get help from IT"
msgstr "Demandar aduya a TI"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "No puedo iniciar sesión"

msgid "An app"
msgstr "Una aplicación"

msgid "Screen, keys or sound"
msgstr "Pantalla, teclas u son"

msgid "Battery"
msgstr "Batería"

msgid "Other"
msgstr "Atro"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Qué ha pasau? No i metas contrasenyas ni datos personals."

msgid "Attach a screenshot"
msgstr "Adchuntar una captura de pantalla"

msgid "Send"
msgstr "Ninviar"

msgid "Close"
msgstr "Zarrar"

msgid "Sending…"
msgstr "Ninviando…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Ninviau. Incidencia #%s. S'ha avisau a TI."

msgid "Saved. It will be sent when this computer is online."
msgstr "Alzau. Se ninviará quan este ordenador tienga connexión."

msgid "Help requests are turned off at this school."
msgstr "As demandas d'aduya son desactivadas en esta escuela."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Has ninviau 3 demandas en esta hora. Torna a intentar-lo mas tarde."

msgid "Couldn't send. Please tell a teacher."
msgstr "No s'ha puesto ninviar. Dí-lo a un profesor."

msgid "IT is collecting diagnostic info from this computer."
msgstr "TI ye replegando información de diagnostico d'este ordenador."
