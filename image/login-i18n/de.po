msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Verwaltet von %s"

msgid "Shut down"
msgstr "Herunterfahren"

msgid "Browse as Guest"
msgstr "Als Gast surfen"

msgid "Apps"
msgstr "Apps"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Retry"
msgstr "Erneut versuchen"

msgid "Opening the sign-in page…"
msgstr "Anmeldeseite wird geöffnet …"

msgid "The sign-in page could not be opened."
msgstr "Die Anmeldeseite konnte nicht geöffnet werden."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Die Schule ist nicht erreichbar. Verbinden Sie sich über die obere Leiste mit dem WLAN und versuchen Sie es erneut."

msgid "IT maintenance sign-in"
msgstr "Anmeldung für IT-Wartung"

msgid "Username"
msgstr "Benutzername"

msgid "This account cannot sign in on this computer."
msgstr "Dieses Konto kann sich an diesem Computer nicht anmelden."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Dieses Konto kann sich an diesem Computer nicht anmelden. Verwenden Sie Ihre Schul-E-Mail (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Dieses Konto kann sich an diesem Computer nicht anmelden. Seine E-Mail-Adresse wurde nicht bestätigt."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Sie haben sich mit einem anderen Konto angemeldet. Melden Sie sich erneut mit dem hier gewählten Konto an."

msgid "Language"
msgstr "Sprache"

msgid "Keyboard"
msgstr "Tastatur"

msgid "Continue"
msgstr "Weiter"

msgid "The setting could not be saved. Try again."
msgstr "Die Einstellung konnte nicht gespeichert werden. Versuchen Sie es erneut."

msgid "Your account is disabled. Contact your administrator."
msgstr "Ihr Konto ist deaktiviert. Wenden Sie sich an Ihren Administrator."

msgid "This device is disabled. Contact your administrator."
msgstr "Dieses Gerät ist deaktiviert. Wenden Sie sich an Ihren Administrator."

msgid "Sign in with your school account."
msgstr "Melden Sie sich mit Ihrem Schulkonto an."

msgid "Could not sign in. Please try again."
msgstr "Anmeldung nicht möglich. Bitte versuchen Sie es erneut."

msgid "Authentication request cancelled"
msgstr "Authentifizierungsanfrage abgebrochen"

msgid "Maximum number of authentication attempts reached"
msgstr "Maximale Anzahl an Authentifizierungsversuchen erreicht"

msgid "Error retrieving access token. Please try again."
msgstr "Fehler beim Abrufen des Zugriffstokens. Bitte versuchen Sie es erneut."

msgid "Invalid user name"
msgstr "Ungültiger Benutzername"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Dieser Computer wurde von der Schule gesperrt; bitte wenden Sie sich an die IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Gastanmeldung ist auf diesem Computer nicht erlaubt"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokale Konten können sich an diesem Computer nicht anmelden"

msgid "School accounts cannot sign in on this computer"
msgstr "Schulkonten können sich an diesem Computer nicht anmelden"

msgid "This app can only be opened from the sign-in screen"
msgstr "Diese App kann nur über den Anmeldebildschirm geöffnet werden"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Diese App benötigt ein Netzwerk. Verbinden Sie sich über die obere Leiste mit dem WLAN und versuchen Sie es erneut."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Kein Netzwerk. Verbinden Sie sich über das Menü oben rechts mit dem WLAN."

msgid "Waiting for school settings."
msgstr "Warten auf Schuleinstellungen."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Der Webbrowser wird installiert. Sie können sich anmelden; er erscheint, sobald er bereit ist."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Der Webbrowser konnte noch nicht installiert werden; es wird erneut versucht. Sie können sich anmelden."

msgid "Name or school email"
msgstr "Name oder Schul-E-Mail"

msgid "Keep typing to narrow down"
msgstr "Weiter tippen, um die Auswahl einzugrenzen"

msgid "Get help"
msgstr "Hilfe holen"

msgid "Get help from IT"
msgstr "Hilfe von der IT"

msgid "Wi-Fi"
msgstr "WLAN"

msgid "Can't sign in"
msgstr "Anmeldung klappt nicht"

msgid "An app"
msgstr "Eine App"

msgid "Screen, keys or sound"
msgstr "Bildschirm, Tasten oder Ton"

msgid "Battery"
msgstr "Akku"

msgid "Other"
msgstr "Sonstiges"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Was ist passiert? Bitte keine Passwörter oder persönlichen Daten angeben."

msgid "Attach a screenshot"
msgstr "Bildschirmfoto anhängen"

msgid "Send"
msgstr "Senden"

msgid "Close"
msgstr "Schließen"

msgid "Sending…"
msgstr "Wird gesendet…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Gesendet. Ticket #%s. Die IT wurde informiert."

msgid "Saved. It will be sent when this computer is online."
msgstr "Gespeichert. Wird gesendet, sobald dieser Computer online ist."

msgid "Help requests are turned off at this school."
msgstr "Hilfeanfragen sind an dieser Schule deaktiviert."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Sie haben in dieser Stunde 3 Anfragen gesendet. Bitte versuchen Sie es später erneut."

msgid "Couldn't send. Please tell a teacher."
msgstr "Senden fehlgeschlagen. Bitte sagen Sie einer Lehrkraft Bescheid."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Die IT sammelt Diagnosedaten von diesem Computer."
