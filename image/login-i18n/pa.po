msgid "Managed by %s"
msgstr "%s ਦੁਆਰਾ ਪ੍ਰਬੰਧਿਤ"

msgid "Shut down"
msgstr "ਬੰਦ ਕਰੋ"

msgid "Browse as Guest"
msgstr "ਮਹਿਮਾਨ ਵਜੋਂ ਬ੍ਰਾਊਜ਼ ਕਰੋ"

msgid "Apps"
msgstr "ਐਪਾਂ"

msgid "Cancel"
msgstr "ਰੱਦ ਕਰੋ"

msgid "Retry"
msgstr "ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ"

msgid "Opening the sign-in page…"
msgstr "ਸਾਈਨ-ਇਨ ਪੰਨਾ ਖੋਲ੍ਹਿਆ ਜਾ ਰਿਹਾ ਹੈ…"

msgid "The sign-in page could not be opened."
msgstr "ਸਾਈਨ-ਇਨ ਪੰਨਾ ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "ਸਕੂਲ ਨਾਲ ਸੰਪਰਕ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਉੱਪਰਲੀ ਪੱਟੀ ਤੋਂ Wi-Fi ਨਾਲ ਜੁੜੋ, ਫਿਰ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "IT maintenance sign-in"
msgstr "IT ਰੱਖ-ਰਖਾਅ ਸਾਈਨ-ਇਨ"

msgid "Username"
msgstr "ਵਰਤੋਂਕਾਰ ਨਾਮ"

msgid "This account cannot sign in on this computer."
msgstr "ਇਹ ਖਾਤਾ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਸਾਈਨ ਇਨ ਨਹੀਂ ਕਰ ਸਕਦਾ।"

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "ਇਹ ਖਾਤਾ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਸਾਈਨ ਇਨ ਨਹੀਂ ਕਰ ਸਕਦਾ। ਆਪਣੀ ਸਕੂਲ ਈਮੇਲ (%s) ਵਰਤੋ।"

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "ਇਹ ਖਾਤਾ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਸਾਈਨ ਇਨ ਨਹੀਂ ਕਰ ਸਕਦਾ। ਇਸਦੇ ਈਮੇਲ ਪਤੇ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਹੋਈ ਹੈ।"

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "ਤੁਸੀਂ ਕਿਸੇ ਹੋਰ ਖਾਤੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕੀਤਾ ਹੈ। ਇੱਥੇ ਚੁਣੇ ਖਾਤੇ ਨਾਲ ਦੁਬਾਰਾ ਸਾਈਨ ਇਨ ਕਰੋ।"

msgid "Language"
msgstr "ਭਾਸ਼ਾ"

msgid "Keyboard"
msgstr "ਕੀਬੋਰਡ"

msgid "Continue"
msgstr "ਜਾਰੀ ਰੱਖੋ"

msgid "The setting could not be saved. Try again."
msgstr "ਸੈਟਿੰਗ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "Your account is disabled. Contact your administrator."
msgstr "ਤੁਹਾਡਾ ਖਾਤਾ ਅਯੋਗ ਕੀਤਾ ਗਿਆ ਹੈ। ਆਪਣੇ ਪ੍ਰਸ਼ਾਸਕ ਨਾਲ ਸੰਪਰਕ ਕਰੋ।"

msgid "This device is disabled. Contact your administrator."
msgstr "ਇਹ ਡੀਵਾਈਸ ਅਯੋਗ ਕੀਤਾ ਗਿਆ ਹੈ। ਆਪਣੇ ਪ੍ਰਸ਼ਾਸਕ ਨਾਲ ਸੰਪਰਕ ਕਰੋ।"

msgid "Sign in with your school account."
msgstr "ਆਪਣੇ ਸਕੂਲ ਖਾਤੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋ।"

msgid "Could not sign in. Please try again."
msgstr "ਸਾਈਨ ਇਨ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਕਿਰਪਾ ਕਰਕੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "Authentication request cancelled"
msgstr "ਪ੍ਰਮਾਣਿਕਤਾ ਬੇਨਤੀ ਰੱਦ ਕੀਤੀ ਗਈ"

msgid "Maximum number of authentication attempts reached"
msgstr "ਪ੍ਰਮਾਣਿਕਤਾ ਕੋਸ਼ਿਸ਼ਾਂ ਦੀ ਵੱਧ ਤੋਂ ਵੱਧ ਗਿਣਤੀ ਪੂਰੀ ਹੋ ਗਈ"

msgid "Error retrieving access token. Please try again."
msgstr "ਐਕਸੈਸ ਟੋਕਨ ਪ੍ਰਾਪਤ ਕਰਨ ਵਿੱਚ ਗਲਤੀ। ਕਿਰਪਾ ਕਰਕੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "Invalid user name"
msgstr "ਅਵੈਧ ਵਰਤੋਂਕਾਰ ਨਾਮ"

msgid "This computer has been locked by the school; please contact IT"
msgstr "ਇਹ ਕੰਪਿਊਟਰ ਸਕੂਲ ਵੱਲੋਂ ਲੌਕ ਕੀਤਾ ਗਿਆ ਹੈ; ਕਿਰਪਾ ਕਰਕੇ IT ਨਾਲ ਸੰਪਰਕ ਕਰੋ"

msgid "Guest sign-in is not allowed on this computer"
msgstr "ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਮਹਿਮਾਨ ਸਾਈਨ-ਇਨ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ"

msgid "Local accounts cannot sign in on this computer"
msgstr "ਲੋਕਲ ਖਾਤੇ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਸਾਈਨ ਇਨ ਨਹੀਂ ਕਰ ਸਕਦੇ"

msgid "School accounts cannot sign in on this computer"
msgstr "ਸਕੂਲ ਖਾਤੇ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਸਾਈਨ ਇਨ ਨਹੀਂ ਕਰ ਸਕਦੇ"

msgid "This app can only be opened from the sign-in screen"
msgstr "ਇਹ ਐਪ ਸਿਰਫ਼ ਸਾਈਨ-ਇਨ ਸਕ੍ਰੀਨ ਤੋਂ ਹੀ ਖੋਲ੍ਹੀ ਜਾ ਸਕਦੀ ਹੈ"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "ਇਸ ਐਪ ਨੂੰ ਨੈੱਟਵਰਕ ਦੀ ਲੋੜ ਹੈ। ਉੱਪਰਲੀ ਪੱਟੀ ਤੋਂ Wi-Fi ਨਾਲ ਜੁੜੋ, ਫਿਰ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "ਕੋਈ ਨੈੱਟਵਰਕ ਨਹੀਂ। ਉੱਪਰ ਸੱਜੇ ਮੀਨੂ ਤੋਂ Wi-Fi ਨਾਲ ਜੁੜੋ।"

msgid "Waiting for school settings."
msgstr "ਸਕੂਲ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਦੀ ਉਡੀਕ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ।"

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "ਵੈੱਬ ਬ੍ਰਾਊਜ਼ਰ ਇੰਸਟਾਲ ਹੋ ਰਿਹਾ ਹੈ। ਤੁਸੀਂ ਸਾਈਨ ਇਨ ਕਰ ਸਕਦੇ ਹੋ; ਤਿਆਰ ਹੋਣ 'ਤੇ ਇਹ ਦਿਖਾਈ ਦੇਵੇਗਾ।"

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "ਵੈੱਬ ਬ੍ਰਾਊਜ਼ਰ ਅਜੇ ਇੰਸਟਾਲ ਨਹੀਂ ਹੋ ਸਕਿਆ; ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕੀਤੀ ਜਾਵੇਗੀ। ਤੁਸੀਂ ਸਾਈਨ ਇਨ ਕਰ ਸਕਦੇ ਹੋ।"

msgid "Name or school email"
msgstr "ਨਾਮ ਜਾਂ ਸਕੂਲ ਈਮੇਲ"

msgid "Keep typing to narrow down"
msgstr "ਸੂਚੀ ਛੋਟੀ ਕਰਨ ਲਈ ਟਾਈਪ ਕਰਦੇ ਰਹੋ"

msgid "Get help"
msgstr "ਮਦਦ ਲਓ"

msgid "Get help from IT"
msgstr "IT ਤੋਂ ਮਦਦ ਲਓ"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "ਸਾਈਨ ਇਨ ਨਹੀਂ ਹੋ ਰਿਹਾ"

msgid "An app"
msgstr "ਕੋਈ ਐਪ"

msgid "Screen, keys or sound"
msgstr "ਸਕ੍ਰੀਨ, ਕੁੰਜੀਆਂ ਜਾਂ ਆਵਾਜ਼"

msgid "Battery"
msgstr "ਬੈਟਰੀ"

msgid "Other"
msgstr "ਹੋਰ"

msgid "What happened? Please don't include passwords or personal details."
msgstr "ਕੀ ਹੋਇਆ? ਕਿਰਪਾ ਕਰਕੇ ਪਾਸਵਰਡ ਜਾਂ ਨਿੱਜੀ ਜਾਣਕਾਰੀ ਨਾ ਲਿਖੋ।"

msgid "Attach a screenshot"
msgstr "ਸਕ੍ਰੀਨਸ਼ੌਟ ਨੱਥੀ ਕਰੋ"

msgid "Send"
msgstr "ਭੇਜੋ"

msgid "Close"
msgstr "ਬੰਦ ਕਰੋ"

msgid "Sending…"
msgstr "ਭੇਜਿਆ ਜਾ ਰਿਹਾ ਹੈ…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "ਭੇਜ ਦਿੱਤਾ। ਟਿਕਟ #%s। IT ਨੂੰ ਦੱਸ ਦਿੱਤਾ ਗਿਆ ਹੈ।"

msgid "Saved. It will be sent when this computer is online."
msgstr "ਸੰਭਾਲਿਆ ਗਿਆ। ਇਹ ਕੰਪਿਊਟਰ ਆਨਲਾਈਨ ਹੋਣ 'ਤੇ ਭੇਜ ਦਿੱਤਾ ਜਾਵੇਗਾ।"

msgid "Help requests are turned off at this school."
msgstr "ਇਸ ਸਕੂਲ ਵਿੱਚ ਮਦਦ ਬੇਨਤੀਆਂ ਬੰਦ ਹਨ।"

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "ਤੁਸੀਂ ਇਸ ਘੰਟੇ 3 ਬੇਨਤੀਆਂ ਭੇਜੀਆਂ ਹਨ। ਕਿਰਪਾ ਕਰਕੇ ਬਾਅਦ ਵਿੱਚ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

msgid "Couldn't send. Please tell a teacher."
msgstr "ਭੇਜਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਕਿਰਪਾ ਕਰਕੇ ਕਿਸੇ ਅਧਿਆਪਕ ਨੂੰ ਦੱਸੋ।"

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT ਇਸ ਕੰਪਿਊਟਰ ਤੋਂ ਨਿਦਾਨ ਜਾਣਕਾਰੀ ਇਕੱਠੀ ਕਰ ਰਿਹਾ ਹੈ।"
