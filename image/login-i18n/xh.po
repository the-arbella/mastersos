msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: xh\n"

msgid "Managed by %s"
msgstr "Iphethwe ngu-%s"

msgid "Shut down"
msgstr "Cima"

msgid "Browse as Guest"
msgstr "Khangela njengendwendwe"

msgid "Apps"
msgstr "Ii-app"

msgid "Cancel"
msgstr "Rhoxisa"

msgid "Retry"
msgstr "Zama kwakhona"

msgid "Opening the sign-in page…"
msgstr "Iyivula iphepha lokungena…"

msgid "The sign-in page could not be opened."
msgstr "Iphepha lokungena alikwazanga ukuvulwa."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Akukwazeki ukufikelela isikolo. Qhagamshela kwi-Wi-Fi ukusuka kwibha ephezulu, uze uzame kwakhona."

msgid "IT maintenance sign-in"
msgstr "Ukungena kolondolozo lwe-IT"

msgid "Username"
msgstr "Igama lomsebenzisi"

msgid "This account cannot sign in on this computer."
msgstr "Le akhawunti ayikwazi ukungena kule khompyutha."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Le akhawunti ayikwazi ukungena kule khompyutha. Sebenzisa i-imeyile yakho yesikolo (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Ungene nge-akhawunti eyahlukileyo. Ngena kwakhona nge-akhawunti oyikhethe apha."

msgid "Language"
msgstr "Ulwimi"

msgid "Keyboard"
msgstr "Ikhibhodi"

msgid "Continue"
msgstr "Qhubeka"

msgid "The setting could not be saved. Try again."
msgstr "Useto alukwazanga ukugcinwa. Zama kwakhona."

msgid "Your account is disabled. Contact your administrator."
msgstr "I-akhawunti yakho ivaliwe. Qhagamshelana nomlawuli wakho."

msgid "This device is disabled. Contact your administrator."
msgstr "Esi sixhobo sivaliwe. Qhagamshelana nomlawuli wakho."

msgid "Sign in with your school account."
msgstr "Ngena nge-akhawunti yakho yesikolo."

msgid "Could not sign in. Please try again."
msgstr "Akukwazekanga ukungena. Nceda uzame kwakhona."

msgid "Authentication request cancelled"
msgstr "Isicelo sokuqinisekisa sirhoxisiwe"

msgid "Maximum number of authentication attempts reached"
msgstr "Kufikelelwe kwinani eliphezulu lokuzama ukuqinisekisa"

msgid "Error retrieving access token. Please try again."
msgstr "Kubekho impazamo ekufumaneni i-token yokufikelela. Nceda uzame kwakhona."

msgid "Invalid user name"
msgstr "Igama lomsebenzisi alivumelekanga"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Le khompyutha ivalwe sisikolo; nceda uqhagamshelane ne-IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Ukungena njengendwendwe akuvumelekanga kule khompyutha"

msgid "Local accounts cannot sign in on this computer"
msgstr "Ii-akhawunti zasekhaya azikwazi ukungena kule khompyutha"

msgid "School accounts cannot sign in on this computer"
msgstr "Ii-akhawunti zesikolo azikwazi ukungena kule khompyutha"

msgid "This app can only be opened from the sign-in screen"
msgstr "Le app ingavulwa kuphela kwisikrini sokungena"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Esi sicelo sidinga inethiwekhi. Qhagamshela kwi-Wi-Fi ukusuka kwibha ephezulu, uze uzame kwakhona."

msgid "No network. Choose a Wi-Fi network in the top-right menu, or plug in a network cable or a phone with USB tethering."
msgstr "Akukho nethiwekhi. Khetha inethiwekhi ye-Wi-Fi kwimenyu ephezulu ngasekunene, okanye faka intambo yenethiwekhi okanye ifowuni eyabelana ngonxibelelwano nge-USB."

msgid "Waiting for school settings."
msgstr "Kulindwe iisetingi zesikolo."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Ibhrawuza yewebhu iyafakelwa. Ungangena; iya kuvela xa ilungile."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Ibhrawuza yewebhu ayikakwazi ukufakelwa; kuza kuzanywa kwakhona. Ungangena."

msgid "Name or school email"
msgstr "Igama okanye i-imeyile yesikolo"

msgid "Keep typing to narrow down"
msgstr "Qhubeka uchwetheza ukuze unciphise uluhlu"
