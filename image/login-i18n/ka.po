msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "მართავს: %s"

msgid "Shut down"
msgstr "გამორთვა"

msgid "Browse as Guest"
msgstr "დათვალიერება სტუმრად"

msgid "Apps"
msgstr "აპები"

msgid "Cancel"
msgstr "გაუქმება"

msgid "Retry"
msgstr "ხელახლა ცდა"

msgid "Opening the sign-in page…"
msgstr "შესვლის გვერდი იხსნება…"

msgid "The sign-in page could not be opened."
msgstr "შესვლის გვერდის გახსნა ვერ მოხერხდა."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "სკოლასთან დაკავშირება ვერ ხერხდება. ზედა პანელიდან დაუკავშირდით Wi-Fi-ს და სცადეთ ხელახლა."

msgid "IT maintenance sign-in"
msgstr "IT მომსახურების შესვლა"

msgid "Username"
msgstr "მომხმარებლის სახელი"

msgid "This account cannot sign in on this computer."
msgstr "ამ ანგარიშით ამ კომპიუტერზე შესვლა შეუძლებელია."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "ამ ანგარიშით ამ კომპიუტერზე შესვლა შეუძლებელია. გამოიყენეთ თქვენი სკოლის ელფოსტა (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "სხვა ანგარიშით შეხვედით. ხელახლა შედით იმ ანგარიშით, რომელიც აქ აირჩიეთ."

msgid "Language"
msgstr "ენა"

msgid "Keyboard"
msgstr "კლავიატურა"

msgid "Continue"
msgstr "გაგრძელება"

msgid "The setting could not be saved. Try again."
msgstr "პარამეტრის შენახვა ვერ მოხერხდა. სცადეთ ხელახლა."

msgid "Your account is disabled. Contact your administrator."
msgstr "თქვენი ანგარიში გამორთულია. დაუკავშირდით ადმინისტრატორს."

msgid "This device is disabled. Contact your administrator."
msgstr "ეს მოწყობილობა გამორთულია. დაუკავშირდით ადმინისტრატორს."

msgid "Sign in with your school account."
msgstr "შედით თქვენი სკოლის ანგარიშით."

msgid "Could not sign in. Please try again."
msgstr "შესვლა ვერ მოხერხდა. გთხოვთ, სცადოთ ხელახლა."

msgid "Authentication request cancelled"
msgstr "ავთენტიფიკაციის მოთხოვნა გაუქმდა"

msgid "Maximum number of authentication attempts reached"
msgstr "ავთენტიფიკაციის მცდელობების მაქსიმალური რაოდენობა ამოიწურა"

msgid "Error retrieving access token. Please try again."
msgstr "წვდომის ტოკენის მიღების შეცდომა. გთხოვთ, სცადოთ ხელახლა."

msgid "Invalid user name"
msgstr "მომხმარებლის სახელი არასწორია"

msgid "This computer has been locked by the school; please contact IT"
msgstr "ეს კომპიუტერი სკოლამ დაბლოკა; დაუკავშირდით IT განყოფილებას"

msgid "Guest sign-in is not allowed on this computer"
msgstr "ამ კომპიუტერზე სტუმრად შესვლა დაშვებული არ არის"

msgid "Local accounts cannot sign in on this computer"
msgstr "ლოკალური ანგარიშებით ამ კომპიუტერზე შესვლა შეუძლებელია"

msgid "School accounts cannot sign in on this computer"
msgstr "სკოლის ანგარიშებით ამ კომპიუტერზე შესვლა შეუძლებელია"

msgid "This app can only be opened from the sign-in screen"
msgstr "ეს აპი მხოლოდ შესვლის ეკრანიდან იხსნება"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "ამ აპლიკაციას ქსელი სჭირდება. ზედა პანელიდან დაუკავშირდით Wi-Fi-ს და სცადეთ ხელახლა."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "ქსელი არ არის. დაუკავშირდით Wi-Fi-ს ზედა მარჯვენა მენიუდან."

msgid "Waiting for school settings."
msgstr "სკოლის პარამეტრების მოლოდინი."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "ვებბრაუზერი ინსტალირდება. შეგიძლიათ შეხვიდეთ; ის გამოჩნდება, როცა მზად იქნება."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "ვებბრაუზერის ინსტალაცია ჯერ ვერ მოხერხდა; მცდელობა განმეორდება. შეგიძლიათ შეხვიდეთ."

msgid "Name or school email"
msgstr "სახელი ან სკოლის ელფოსტა"

msgid "Keep typing to narrow down"
msgstr "განაგრძეთ აკრეფა სიის შესავიწროებლად"

msgid "Get help"
msgstr "დახმარება"

msgid "Get help from IT"
msgstr "დახმარება IT განყოფილებისგან"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "შესვლა ვერ ხერხდება"

msgid "An app"
msgstr "აპლიკაცია"

msgid "Screen, keys or sound"
msgstr "ეკრანი, კლავიშები ან ხმა"

msgid "Battery"
msgstr "ბატარეა"

msgid "Other"
msgstr "სხვა"

msgid "What happened? Please don't include passwords or personal details."
msgstr "რა მოხდა? გთხოვთ, ნუ მიუთითებთ პაროლებს ან პირად მონაცემებს."

msgid "Attach a screenshot"
msgstr "ეკრანის სურათის მიმაგრება"

msgid "Send"
msgstr "გაგზავნა"

msgid "Close"
msgstr "დახურვა"

msgid "Sending…"
msgstr "იგზავნება…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "გაიგზავნა. მოთხოვნა #%s. IT განყოფილებას ეცნობა."

msgid "Saved. It will be sent when this computer is online."
msgstr "შენახულია. გაიგზავნება, როცა ეს კომპიუტერი ინტერნეტს დაუკავშირდება."

msgid "Help requests are turned off at this school."
msgstr "დახმარების მოთხოვნები ამ სკოლაში გამორთულია."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "ამ საათში უკვე გაგზავნეთ 3 მოთხოვნა. გთხოვთ, სცადოთ მოგვიანებით."

msgid "Couldn't send. Please tell a teacher."
msgstr "გაგზავნა ვერ მოხერხდა. გთხოვთ, უთხრათ მასწავლებელს."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT განყოფილება ამ კომპიუტერიდან დიაგნოსტიკურ ინფორმაციას აგროვებს."
