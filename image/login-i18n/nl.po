msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Beheerd door %s"

msgid "Shut down"
msgstr "Afsluiten"

msgid "Browse as Guest"
msgstr "Surfen als gast"

msgid "Apps"
msgstr "Apps"

msgid "Cancel"
msgstr "Annuleren"

msgid "Retry"
msgstr "Opnieuw proberen"

msgid "Opening the sign-in page…"
msgstr "Aanmeldpagina openen…"

msgid "The sign-in page could not be opened."
msgstr "De aanmeldpagina kon niet worden geopend."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "De school is niet bereikbaar. Maak verbinding met Wi-Fi via de bovenbalk en probeer het opnieuw."

msgid "IT maintenance sign-in"
msgstr "Aanmelden voor IT-onderhoud"

msgid "Username"
msgstr "Gebruikersnaam"

msgid "This account cannot sign in on this computer."
msgstr "Dit account kan zich niet aanmelden op deze computer."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Dit account kan zich niet aanmelden op deze computer. Gebruik je school-e-mailadres (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Dit account kan zich niet aanmelden op deze computer. Het e-mailadres ervan is niet geverifieerd."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Je hebt je met een ander account aangemeld. Meld je opnieuw aan met het account dat je hier hebt gekozen."

msgid "Language"
msgstr "Taal"

msgid "Keyboard"
msgstr "Toetsenbord"

msgid "Continue"
msgstr "Doorgaan"

msgid "The setting could not be saved. Try again."
msgstr "De instelling kon niet worden opgeslagen. Probeer het opnieuw."

msgid "Your account is disabled. Contact your administrator."
msgstr "Je account is uitgeschakeld. Neem contact op met je beheerder."

msgid "This device is disabled. Contact your administrator."
msgstr "Dit apparaat is uitgeschakeld. Neem contact op met je beheerder."

msgid "Sign in with your school account."
msgstr "Meld je aan met je schoolaccount."

msgid "Could not sign in. Please try again."
msgstr "Aanmelden is mislukt. Probeer het opnieuw."

msgid "Authentication request cancelled"
msgstr "Authenticatieverzoek geannuleerd"

msgid "Maximum number of authentication attempts reached"
msgstr "Maximaal aantal authenticatiepogingen bereikt"

msgid "Error retrieving access token. Please try again."
msgstr "Fout bij het ophalen van het toegangstoken. Probeer het opnieuw."

msgid "Invalid user name"
msgstr "Ongeldige gebruikersnaam"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Deze computer is door de school vergrendeld; neem contact op met ICT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Aanmelden als gast is op deze computer niet toegestaan"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokale accounts kunnen zich niet aanmelden op deze computer"

msgid "School accounts cannot sign in on this computer"
msgstr "Schoolaccounts kunnen zich niet aanmelden op deze computer"

msgid "This app can only be opened from the sign-in screen"
msgstr "Deze app kan alleen vanaf het aanmeldscherm worden geopend"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Deze app heeft een netwerk nodig. Maak verbinding met Wi-Fi via de bovenbalk en probeer het opnieuw."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Geen netwerk. Maak verbinding met Wi-Fi via het menu rechtsboven."

msgid "Waiting for school settings."
msgstr "Wachten op schoolinstellingen."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "De webbrowser wordt geïnstalleerd. Je kunt je al aanmelden; hij verschijnt zodra hij klaar is."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "De webbrowser kon nog niet worden geïnstalleerd; er wordt opnieuw geprobeerd. Je kunt je aanmelden."

msgid "Name or school email"
msgstr "Naam of school-e-mailadres"

msgid "Keep typing to narrow down"
msgstr "Blijf typen om de lijst te verkleinen"

msgid "Get help"
msgstr "Hulp vragen"

msgid "Get help from IT"
msgstr "Hulp vragen aan ICT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Kan niet aanmelden"

msgid "An app"
msgstr "Een app"

msgid "Screen, keys or sound"
msgstr "Scherm, toetsen of geluid"

msgid "Battery"
msgstr "Batterij"

msgid "Other"
msgstr "Anders"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Wat is er gebeurd? Vermeld geen wachtwoorden of persoonlijke gegevens."

msgid "Attach a screenshot"
msgstr "Schermafbeelding toevoegen"

msgid "Send"
msgstr "Versturen"

msgid "Close"
msgstr "Sluiten"

msgid "Sending…"
msgstr "Versturen…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Verstuurd. Ticket #%s. ICT is op de hoogte."

msgid "Saved. It will be sent when this computer is online."
msgstr "Opgeslagen. Wordt verstuurd zodra deze computer online is."

msgid "Help requests are turned off at this school."
msgstr "Hulpverzoeken staan uit op deze school."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Je hebt dit uur 3 verzoeken verstuurd. Probeer het later opnieuw."

msgid "Couldn't send. Please tell a teacher."
msgstr "Versturen is mislukt. Vertel het aan een leraar."

msgid "IT is collecting diagnostic info from this computer."
msgstr "ICT verzamelt diagnostische gegevens van deze computer."
