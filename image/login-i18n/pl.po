msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Zarządzane przez %s"

msgid "Shut down"
msgstr "Wyłącz"

msgid "Browse as Guest"
msgstr "Przeglądaj jako gość"

msgid "Apps"
msgstr "Aplikacje"

msgid "Cancel"
msgstr "Anuluj"

msgid "Retry"
msgstr "Spróbuj ponownie"

msgid "Opening the sign-in page…"
msgstr "Otwieranie strony logowania…"

msgid "The sign-in page could not be opened."
msgstr "Nie udało się otworzyć strony logowania."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Nie można połączyć się ze szkołą. Połącz się z siecią Wi-Fi na górnym pasku, a następnie spróbuj ponownie."

msgid "IT maintenance sign-in"
msgstr "Logowanie do konserwacji IT"

msgid "Username"
msgstr "Nazwa użytkownika"

msgid "This account cannot sign in on this computer."
msgstr "To konto nie może się zalogować na tym komputerze."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "To konto nie może się zalogować na tym komputerze. Użyj szkolnego adresu e-mail (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Zalogowano na inne konto. Zaloguj się ponownie na konto wybrane tutaj."

msgid "Language"
msgstr "Język"

msgid "Keyboard"
msgstr "Klawiatura"

msgid "Continue"
msgstr "Dalej"

msgid "The setting could not be saved. Try again."
msgstr "Nie udało się zapisać ustawienia. Spróbuj ponownie."

msgid "Your account is disabled. Contact your administrator."
msgstr "Twoje konto jest wyłączone. Skontaktuj się z administratorem."

msgid "This device is disabled. Contact your administrator."
msgstr "To urządzenie jest wyłączone. Skontaktuj się z administratorem."

msgid "Sign in with your school account."
msgstr "Zaloguj się kontem szkolnym."

msgid "Could not sign in. Please try again."
msgstr "Nie udało się zalogować. Spróbuj ponownie."

msgid "Authentication request cancelled"
msgstr "Anulowano żądanie uwierzytelnienia"

msgid "Maximum number of authentication attempts reached"
msgstr "Osiągnięto maksymalną liczbę prób uwierzytelnienia"

msgid "Error retrieving access token. Please try again."
msgstr "Błąd pobierania tokenu dostępu. Spróbuj ponownie."

msgid "Invalid user name"
msgstr "Nieprawidłowa nazwa użytkownika"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Ten komputer został zablokowany przez szkołę; skontaktuj się z działem IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Logowanie jako gość nie jest dozwolone na tym komputerze"

msgid "Local accounts cannot sign in on this computer"
msgstr "Konta lokalne nie mogą się logować na tym komputerze"

msgid "School accounts cannot sign in on this computer"
msgstr "Konta szkolne nie mogą się logować na tym komputerze"

msgid "This app can only be opened from the sign-in screen"
msgstr "Tę aplikację można otworzyć tylko z ekranu logowania"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ta aplikacja wymaga sieci. Połącz się z siecią Wi-Fi na górnym pasku, a następnie spróbuj ponownie."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Brak sieci. Połącz się z siecią Wi-Fi w menu w prawym górnym rogu."

msgid "Waiting for school settings."
msgstr "Oczekiwanie na ustawienia szkoły."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Instalowanie przeglądarki internetowej. Możesz się już zalogować; przeglądarka pojawi się, gdy będzie gotowa."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Nie udało się jeszcze zainstalować przeglądarki internetowej; nastąpi ponowna próba. Możesz się zalogować."

msgid "Name or school email"
msgstr "Imię i nazwisko lub szkolny adres e-mail"

msgid "Keep typing to narrow down"
msgstr "Pisz dalej, aby zawęzić listę"

msgid "Get help"
msgstr "Poproś o pomoc"

msgid "Get help from IT"
msgstr "Poproś dział IT o pomoc"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Nie mogę się zalogować"

msgid "An app"
msgstr "Aplikacja"

msgid "Screen, keys or sound"
msgstr "Ekran, klawisze lub dźwięk"

msgid "Battery"
msgstr "Bateria"

msgid "Other"
msgstr "Inne"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Co się stało? Nie podawaj haseł ani danych osobowych."

msgid "Attach a screenshot"
msgstr "Dołącz zrzut ekranu"

msgid "Send"
msgstr "Wyślij"

msgid "Close"
msgstr "Zamknij"

msgid "Sending…"
msgstr "Wysyłanie…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Wysłano. Zgłoszenie #%s. Dział IT został powiadomiony."

msgid "Saved. It will be sent when this computer is online."
msgstr "Zapisano. Zostanie wysłane, gdy ten komputer będzie online."

msgid "Help requests are turned off at this school."
msgstr "Prośby o pomoc są wyłączone w tej szkole."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "W tej godzinie wysłano już 3 prośby. Spróbuj ponownie później."

msgid "Couldn't send. Please tell a teacher."
msgstr "Nie udało się wysłać. Powiedz nauczycielowi."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Dział IT zbiera dane diagnostyczne z tego komputera."
