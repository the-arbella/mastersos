msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Upravlja: %s"

msgid "Shut down"
msgstr "Izklopi"

msgid "Browse as Guest"
msgstr "Brskaj kot gost"

msgid "Apps"
msgstr "Aplikacije"

msgid "Cancel"
msgstr "Prekliči"

msgid "Retry"
msgstr "Poskusi znova"

msgid "Opening the sign-in page…"
msgstr "Odpiranje strani za prijavo …"

msgid "The sign-in page could not be opened."
msgstr "Strani za prijavo ni bilo mogoče odpreti."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Šole ni mogoče doseči. Povežite se z omrežjem Wi-Fi v zgornji vrstici in poskusite znova."

msgid "IT maintenance sign-in"
msgstr "Prijava za vzdrževanje IT"

msgid "Username"
msgstr "Uporabniško ime"

msgid "This account cannot sign in on this computer."
msgstr "S tem računom se v tem računalniku ni mogoče prijaviti."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "S tem računom se v tem računalniku ni mogoče prijaviti. Uporabite šolski e-poštni naslov (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "S tem računom se v tem računalniku ni mogoče prijaviti. Njegov e-poštni naslov ni bil preverjen."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Prijavili ste se z drugim računom. Znova se prijavite z računom, ki ste ga izbrali tukaj."

msgid "Language"
msgstr "Jezik"

msgid "Keyboard"
msgstr "Tipkovnica"

msgid "Continue"
msgstr "Naprej"

msgid "The setting could not be saved. Try again."
msgstr "Nastavitve ni bilo mogoče shraniti. Poskusite znova."

msgid "Your account is disabled. Contact your administrator."
msgstr "Vaš račun je onemogočen. Obrnite se na skrbnika."

msgid "This device is disabled. Contact your administrator."
msgstr "Ta naprava je onemogočena. Obrnite se na skrbnika."

msgid "Sign in with your school account."
msgstr "Prijavite se s šolskim računom."

msgid "Could not sign in. Please try again."
msgstr "Prijava ni uspela. Poskusite znova."

msgid "Authentication request cancelled"
msgstr "Zahteva za overitev je bila preklicana"

msgid "Maximum number of authentication attempts reached"
msgstr "Doseženo je največje dovoljeno število poskusov overitve"

msgid "Error retrieving access token. Please try again."
msgstr "Napaka pri pridobivanju dostopnega žetona. Poskusite znova."

msgid "Invalid user name"
msgstr "Neveljavno uporabniško ime"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Šola je zaklenila ta računalnik; obrnite se na informatike"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Prijava gosta v tem računalniku ni dovoljena"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokalni računi se v tem računalniku ne morejo prijaviti"

msgid "School accounts cannot sign in on this computer"
msgstr "Šolski računi se v tem računalniku ne morejo prijaviti"

msgid "This app can only be opened from the sign-in screen"
msgstr "To aplikacijo je mogoče odpreti samo na zaslonu za prijavo"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Ta aplikacija potrebuje omrežje. Povežite se z omrežjem Wi-Fi v zgornji vrstici in poskusite znova."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Ni omrežja. Povežite se z omrežjem Wi-Fi v meniju zgoraj desno."

msgid "Waiting for school settings."
msgstr "Čakanje na nastavitve šole."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Nameščanje spletnega brskalnika. Lahko se prijavite; prikazal se bo, ko bo pripravljen."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Spletnega brskalnika še ni bilo mogoče namestiti; poskus bo ponovljen. Lahko se prijavite."

msgid "Name or school email"
msgstr "Ime ali šolski e-poštni naslov"

msgid "Keep typing to narrow down"
msgstr "Tipkajte naprej, da zožite seznam"

msgid "Get help"
msgstr "Pomoč"

msgid "Get help from IT"
msgstr "Pomoč informatikov"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Prijava ne deluje"

msgid "An app"
msgstr "Aplikacija"

msgid "Screen, keys or sound"
msgstr "Zaslon, tipke ali zvok"

msgid "Battery"
msgstr "Baterija"

msgid "Other"
msgstr "Drugo"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Kaj se je zgodilo? Ne navajajte gesel ali osebnih podatkov."

msgid "Attach a screenshot"
msgstr "Priloži posnetek zaslona"

msgid "Send"
msgstr "Pošlji"

msgid "Close"
msgstr "Zapri"

msgid "Sending…"
msgstr "Pošiljanje…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Poslano. Zahtevek #%s. Informatiki so obveščeni."

msgid "Saved. It will be sent when this computer is online."
msgstr "Shranjeno. Poslano bo, ko bo ta računalnik povezan v splet."

msgid "Help requests are turned off at this school."
msgstr "Prošnje za pomoč so na tej šoli izklopljene."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "V tej uri ste poslali že 3 prošnje. Poskusite znova pozneje."

msgid "Couldn't send. Please tell a teacher."
msgstr "Pošiljanje ni uspelo. Povejte učitelju."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Informatiki zbirajo diagnostične podatke s tega računalnika."
