msgid ""
msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Verwaltet vun %s"

msgid "Shut down"
msgstr "Utmaken"

msgid "Browse as Guest"
msgstr "As Gast surfen"

msgid "Apps"
msgstr "Apps"

msgid "Cancel"
msgstr "Afbreken"

msgid "Retry"
msgstr "Nochmal versöken"

msgid "Opening the sign-in page…"
msgstr "Anmellsiet warrt opmaakt…"

msgid "The sign-in page could not be opened."
msgstr "De Anmellsiet leet sik nich opmaken."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "De School is nich to erreken. Verbinn di boven in de Balken mit Wi-Fi un versöök dat nochmal."

msgid "IT maintenance sign-in"
msgstr "Anmellen för IT-Wartung"

msgid "Username"
msgstr "Brukernaam"

msgid "This account cannot sign in on this computer."
msgstr "Dit Konto kann sik op dissen Reekner nich anmellen."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Dit Konto kann sik op dissen Reekner nich anmellen. Bruuk dien School-E-Mail (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Du hest di mit en anner Konto anmellt. Mell di nochmal mit dat Konto an, dat du hier utsöcht hest."

msgid "Language"
msgstr "Spraak"

msgid "Keyboard"
msgstr "Tastatuur"

msgid "Continue"
msgstr "Wiedergahn"

msgid "The setting could not be saved. Try again."
msgstr "De Instellen leet sik nich spiekern. Versöök dat nochmal."

msgid "Your account is disabled. Contact your administrator."
msgstr "Dien Konto is sperrt. Snack mit dien Administrator."

msgid "This device is disabled. Contact your administrator."
msgstr "Dit Reedschap is sperrt. Snack mit dien Administrator."

msgid "Sign in with your school account."
msgstr "Mell di mit dien School-Konto an."

msgid "Could not sign in. Please try again."
msgstr "Anmellen hett nich klappt. Versöök dat bitte nochmal."

msgid "Authentication request cancelled"
msgstr "De Anfraag to’n Utwiesen is afbroken wurrn"

msgid "Maximum number of authentication attempts reached"
msgstr "De hööchste Tahl an Versöken to’n Utwiesen is erreekt"

msgid "Error retrieving access token. Please try again."
msgstr "Fehler bi’t Afropen vun den Togriffs-Token. Versöök dat bitte nochmal."

msgid "Invalid user name"
msgstr "Brukernaam is nich gellig"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Disse Reekner is vun de School sperrt wurrn; snack bitte mit IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Anmellen as Gast is op dissen Reekner nich verlöövt"

msgid "Local accounts cannot sign in on this computer"
msgstr "Lokale Konten köönt sik op dissen Reekner nich anmellen"

msgid "School accounts cannot sign in on this computer"
msgstr "School-Konten köönt sik op dissen Reekner nich anmellen"

msgid "This app can only be opened from the sign-in screen"
msgstr "Disse App lett sik blots vun den Anmellschirm ut opmaken"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Disse App bruukt en Netz. Verbinn di boven in de Balken mit Wi-Fi un versöök dat nochmal."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Keen Netz. Verbinn di över dat Menü boven rechts mit Wi-Fi."

msgid "Waiting for school settings."
msgstr "Töövt op de School-Instellen."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "De Webbrowser warrt installeert. Du kannst di anmellen; he dukt op, wenn he praat is."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "De Webbrowser kunn noch nich installeert warrn; dat warrt nochmal versöcht. Du kannst di anmellen."

msgid "Name or school email"
msgstr "Naam or School-E-Mail"

msgid "Keep typing to narrow down"
msgstr "Wieder tippen, üm de List lütter to maken"

msgid "Get help"
msgstr "Hülp halen"

msgid "Get help from IT"
msgstr "Hülp vun IT"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Anmellen geiht nich"

msgid "An app"
msgstr "En App"

msgid "Screen, keys or sound"
msgstr "Billschirm, Tasten oder Toon"

msgid "Battery"
msgstr "Akku"

msgid "Other"
msgstr "Anners"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Wat is passeert? Schriev bitte keen Passwöör oder persöönliche Saken."

msgid "Attach a screenshot"
msgstr "Billschirmfoto anhangen"

msgid "Send"
msgstr "Sennen"

msgid "Close"
msgstr "Tomaken"

msgid "Sending…"
msgstr "Warrt sennt…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Sennt. Ticket #%s. IT weet Bescheed."

msgid "Saved. It will be sent when this computer is online."
msgstr "Spiekert. Dat warrt sennt, wenn disse Reekner online is."

msgid "Help requests are turned off at this school."
msgstr "Hülpanfragen sünd op disse School utschalt."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Du hest in disse Stünn al 3 Anfragen sennt. Versöök dat bitte later nochmal."

msgid "Couldn't send. Please tell a teacher."
msgstr "Sennen hett nich klappt. Segg dat bitte en Lehrer."

msgid "IT is collecting diagnostic info from this computer."
msgstr "IT sammelt Diagnose-Infos vun dissen Reekner."
