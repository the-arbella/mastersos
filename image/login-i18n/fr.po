msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Géré par %s"

msgid "Shut down"
msgstr "Éteindre"

msgid "Browse as Guest"
msgstr "Naviguer en invité"

msgid "Apps"
msgstr "Applications"

msgid "Cancel"
msgstr "Annuler"

msgid "Retry"
msgstr "Réessayer"

msgid "Opening the sign-in page…"
msgstr "Ouverture de la page de connexion…"

msgid "The sign-in page could not be opened."
msgstr "Impossible d'ouvrir la page de connexion."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Impossible de joindre l'école. Connectez-vous au Wi-Fi depuis la barre supérieure, puis réessayez."

msgid "IT maintenance sign-in"
msgstr "Connexion pour la maintenance informatique"

msgid "Username"
msgstr "Nom d'utilisateur"

msgid "This account cannot sign in on this computer."
msgstr "Ce compte ne peut pas se connecter sur cet ordinateur."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Ce compte ne peut pas se connecter sur cet ordinateur. Utilisez votre adresse e-mail de l'école (%s)."

msgid "This account cannot sign in on this computer. Its email address has not been verified."
msgstr "Ce compte ne peut pas se connecter sur cet ordinateur. Son adresse e-mail n'a pas été vérifiée."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Vous vous êtes connecté avec un autre compte. Reconnectez-vous avec le compte choisi ici."

msgid "Language"
msgstr "Langue"

msgid "Keyboard"
msgstr "Clavier"

msgid "Continue"
msgstr "Continuer"

msgid "The setting could not be saved. Try again."
msgstr "Impossible d'enregistrer le paramètre. Réessayez."

msgid "Your account is disabled. Contact your administrator."
msgstr "Votre compte est désactivé. Contactez votre administrateur."

msgid "This device is disabled. Contact your administrator."
msgstr "Cet appareil est désactivé. Contactez votre administrateur."

msgid "Sign in with your school account."
msgstr "Connectez-vous avec votre compte scolaire."

msgid "Could not sign in. Please try again."
msgstr "Connexion impossible. Veuillez réessayer."

msgid "Authentication request cancelled"
msgstr "Demande d'authentification annulée"

msgid "Maximum number of authentication attempts reached"
msgstr "Nombre maximal de tentatives d'authentification atteint"

msgid "Error retrieving access token. Please try again."
msgstr "Erreur lors de la récupération du jeton d'accès. Veuillez réessayer."

msgid "Invalid user name"
msgstr "Nom d'utilisateur non valide"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Cet ordinateur a été verrouillé par l'école ; veuillez contacter le service informatique"

msgid "Guest sign-in is not allowed on this computer"
msgstr "La connexion en invité n'est pas autorisée sur cet ordinateur"

msgid "Local accounts cannot sign in on this computer"
msgstr "Les comptes locaux ne peuvent pas se connecter sur cet ordinateur"

msgid "School accounts cannot sign in on this computer"
msgstr "Les comptes scolaires ne peuvent pas se connecter sur cet ordinateur"

msgid "This app can only be opened from the sign-in screen"
msgstr "Cette application ne peut être ouverte que depuis l'écran de connexion"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Cette application a besoin d'un réseau. Connectez-vous au Wi-Fi depuis la barre supérieure, puis réessayez."

msgid "No network. Connect to Wi-Fi from the top-right menu."
msgstr "Aucun réseau. Connectez-vous au Wi-Fi depuis le menu en haut à droite."

msgid "Waiting for school settings."
msgstr "En attente des paramètres de l'école."

msgid "Installing the web browser. You can sign in; it will appear when ready."
msgstr "Installation du navigateur web. Vous pouvez vous connecter ; il apparaîtra une fois prêt."

msgid "The web browser could not be installed yet; it will try again. You can sign in."
msgstr "Le navigateur web n'a pas encore pu être installé ; une nouvelle tentative aura lieu. Vous pouvez vous connecter."

msgid "Name or school email"
msgstr "Nom ou adresse e-mail de l'école"

msgid "Keep typing to narrow down"
msgstr "Continuez à taper pour affiner la liste"

msgid "Get help"
msgstr "Obtenir de l'aide"

msgid "Get help from IT"
msgstr "Demander de l'aide au service informatique"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Can't sign in"
msgstr "Connexion impossible"

msgid "An app"
msgstr "Une application"

msgid "Screen, keys or sound"
msgstr "Écran, clavier ou son"

msgid "Battery"
msgstr "Batterie"

msgid "Other"
msgstr "Autre"

msgid "What happened? Please don't include passwords or personal details."
msgstr "Que s'est-il passé ? N'indiquez pas de mots de passe ni d'informations personnelles."

msgid "Attach a screenshot"
msgstr "Joindre une capture d'écran"

msgid "Send"
msgstr "Envoyer"

msgid "Close"
msgstr "Fermer"

msgid "Sending…"
msgstr "Envoi…"

msgid "Sent. Ticket #%s. IT has been told."
msgstr "Envoyé. Ticket n° %s. Le service informatique a été prévenu."

msgid "Saved. It will be sent when this computer is online."
msgstr "Enregistré. Il sera envoyé dès que cet ordinateur sera en ligne."

msgid "Help requests are turned off at this school."
msgstr "Les demandes d'aide sont désactivées dans cette école."

msgid "You've sent 3 requests this hour. Please try again later."
msgstr "Vous avez envoyé 3 demandes au cours de cette heure. Veuillez réessayer plus tard."

msgid "Couldn't send. Please tell a teacher."
msgstr "Envoi impossible. Prévenez un enseignant."

msgid "IT is collecting diagnostic info from this computer."
msgstr "Le service informatique collecte des informations de diagnostic sur cet ordinateur."
