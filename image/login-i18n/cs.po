msgstr ""
"Project-Id-Version: mastersos-login\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Managed by %s"
msgstr "Spravuje %s"

msgid "Shut down"
msgstr "Vypnout"

msgid "Browse as Guest"
msgstr "Procházet jako host"

msgid "Add person"
msgstr "Přidat osobu"

msgid "Apps"
msgstr "Aplikace"

msgid "Cancel"
msgstr "Zrušit"

msgid "Retry"
msgstr "Zkusit znovu"

msgid "Opening the sign-in page…"
msgstr "Otevírá se přihlašovací stránka…"

msgid "The sign-in page could not be opened."
msgstr "Přihlašovací stránku se nepodařilo otevřít."

msgid "Cannot reach the school. Connect to Wi-Fi from the top bar, then retry."
msgstr "Škola není dostupná. Připojte se k Wi-Fi v horní liště a zkuste to znovu."

msgid "School email"
msgstr "Školní e-mail"

msgid "IT local account"
msgstr "Místní účet IT"

msgid "Username"
msgstr "Uživatelské jméno"

msgid "This account cannot sign in on this computer."
msgstr "Tento účet se na tomto počítači nemůže přihlásit."

msgid "This account cannot sign in on this computer. Use your school email (%s)."
msgstr "Tento účet se na tomto počítači nemůže přihlásit. Použijte svůj školní e-mail (%s)."

msgid "You signed in with a different account. Sign in again with the account you chose here."
msgstr "Přihlásili jste se jiným účtem. Přihlaste se znovu účtem, který jste zde vybrali."

msgid "Language"
msgstr "Jazyk"

msgid "Keyboard"
msgstr "Klávesnice"

msgid "Continue"
msgstr "Pokračovat"

msgid "The setting could not be saved. Try again."
msgstr "Nastavení se nepodařilo uložit. Zkuste to znovu."

msgid "Your account is disabled. Contact your administrator."
msgstr "Váš účet je zakázán. Obraťte se na správce."

msgid "This device is disabled. Contact your administrator."
msgstr "Toto zařízení je zakázáno. Obraťte se na správce."

msgid "Sign in with your school account."
msgstr "Přihlaste se školním účtem."

msgid "Could not sign in. Please try again."
msgstr "Přihlášení se nezdařilo. Zkuste to prosím znovu."

msgid "Authentication request cancelled"
msgstr "Požadavek na ověření byl zrušen"

msgid "Maximum number of authentication attempts reached"
msgstr "Byl dosažen maximální počet pokusů o ověření"

msgid "Error retrieving access token. Please try again."
msgstr "Při získávání přístupového tokenu došlo k chybě. Zkuste to prosím znovu."

msgid "Invalid user name"
msgstr "Neplatné uživatelské jméno"

msgid "This computer has been locked by the school; please contact IT"
msgstr "Tento počítač byl zamčen školou; obraťte se na IT"

msgid "Guest sign-in is not allowed on this computer"
msgstr "Přihlášení hosta není na tomto počítači povoleno"

msgid "Local accounts cannot sign in on this computer"
msgstr "Místní účty se na tomto počítači nemohou přihlásit"

msgid "School accounts cannot sign in on this computer"
msgstr "Školní účty se na tomto počítači nemohou přihlásit"

msgid "This app can only be opened from the sign-in screen"
msgstr "Tuto aplikaci lze otevřít jen z přihlašovací obrazovky"

msgid "This app needs a network. Connect to Wi-Fi from the top bar, then retry."
msgstr "Tato aplikace potřebuje síť. Připojte se k Wi-Fi v horní liště a zkuste to znovu."
