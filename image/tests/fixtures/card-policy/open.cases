# Open card, issuer https://sso.school.ac.th, the Device blocks tiktok.com and example.net/blocked.
allow https://sso.school.ac.th/oauth/v2/authorize?client_id=x
allow https://accounts.google.com/signin
allow https://challenges.cloudflare.com/turnstile/v0/api.js
allow https://sso.school.ac.th:8443/other-port
allow https://example.net/other
allow http://127.0.0.1:48123/callback?code=x&state=y
block https://tiktok.com/
block https://www.tiktok.com/@someone
block https://example.net/blocked/page
block http://example.org/
block http://sso.school.ac.th/
block http://127.0.0.1:48123/other
block http://127.0.0.1:9477/
block file:///etc/passwd
block chrome://settings/
block chrome://version/
block chrome://flags/
block chrome://policy/
block ftp://example.org/file

# The camera and the microphone: the issuer's own pages without a question, nobody else.
media https://sso.school.ac.th/signin
nomedia https://accounts.google.com/signin
nomedia https://sso.school.ac.th.example.net/signin
nomedia https://login.sso.school.ac.th/signin
