#!/bin/bash
# ExecStart of mastersos-diag-setup.service (no argument) and mastersos-diag-adopt.service ("adopt"): the developer
# diagnostics switch (docs/specs/2026-11-03-diagnostics-design.md).
# The switch is the regular file /var/lib/mastersos-diag/enabled on the encrypted root. Only the first boot creates it, from the
# marker /var/lib/mastersos-seed/debug-install the installer wrote when d was held at its start ("adopt"). The seed partition is
# not encrypted: a marker found there on any other boot was put there afterwards; it is deleted and never trusted. A factory
# reset empties the root and so turns the switch off, and its first boot does not adopt a marker (identity.json, see below). Without the switch nothing is written. With it, before the services start:
#   /run/mastersos/diag.env                          read by the 90-mastersos-diag.conf drop-ins (EnvironmentFile=-):
#       MASTERSOS_LOG_LEVEL=debug                    mastersos-agent
#       MASTERSOS_DIAG_AUTHD_ARGS=-vv                authd and authd-oidc (cobra -v count: -vv is DEBUG, -vvv only adds the caller)
#       MASTERSOS_DIAG_WPA_ARGS=-d                   wpa_supplicant debug level; never -K (show keys)
#   /run/NetworkManager/conf.d/90-mastersos-diag.conf  [logging] level=DEBUG
#   /etc/gdm3/custom.conf                            Enable=true in [debug] (a copy path, owned by this machine; stays once set,
#                                                    like the switch, which only a reinstall removes)
# MASTERSOS_DIAG_ROOT prefixes every path (tests/diag-setup-test.sh only).
set -euo pipefail
R=${MASTERSOS_DIAG_ROOT:-}
switch=$R/var/lib/mastersos-diag/enabled
marker=$R/var/lib/mastersos-seed/debug-install

# write $2 to $1 through a temporary file in the same folder
put() {
	mkdir -p "$(dirname "$1")"
	printf '%s\n' "$2" >"$1.tmp"
	mv -f "$1.tmp" "$1"
}

# Enable=true in custom.conf's [debug] section: an existing "Enable=..." or "#Enable=true" line there becomes Enable=true,
# otherwise the line is added (and the section when it is missing). Other lines stay as they are.
gdm_debug() {
	local f=$R/etc/gdm3/custom.conf
	mkdir -p "$(dirname "$f")"
	[ -f "$f" ] || : >"$f"
	awk '
		/^\[/ { if (s == "[debug]" && !done) { print "Enable=true"; done = 1 } s = $0; print; next }
		s == "[debug]" && /^#?[ \t]*Enable[ \t]*=/ { if (!done) { print "Enable=true"; done = 1 } next }
		{ print }
		END { if (!done) { if (s != "[debug]") print "[debug]"; print "Enable=true" } }
	' "$f" >"$f.tmp"
	mv -f "$f.tmp" "$f"
}

if [ "${1:-}" = adopt ]; then
	# A factory reset also makes a first boot, but keeps the seed partition: identity.json there (written by the agent on the
	# machine's first run, after this unit) means this root was rebuilt, not installed, so a marker cannot be the installer's
	if [ -e "$R/var/lib/mastersos-seed/identity.json" ]; then
		[ ! -e "$marker" ] && [ ! -L "$marker" ] ||
			echo "mastersos-diag-setup: warning: removed $marker after a factory reset; only an install can turn diagnostics on" >&2
	elif [ -f "$marker" ] && [ ! -L "$marker" ]; then
		mkdir -p "$(dirname "$switch")"
		chmod 0700 "$(dirname "$switch")"
		: >"$switch"
		echo "mastersos-diag-setup: first boot: the installer turned developer diagnostics on; switch $switch"
	fi
	rm -f -- "$marker"
	exit 0
fi
if [ -e "$marker" ] || [ -L "$marker" ]; then
	rm -f -- "$marker"
	echo "mastersos-diag-setup: warning: removed $marker; only the first boot after an install can turn diagnostics on" >&2
fi
if [ ! -f "$switch" ] || [ -L "$switch" ]; then
	exit 0
fi
echo "mastersos-diag-setup: developer diagnostics are on ($switch): debug logging for NetworkManager, wpa_supplicant, GDM, authd and mastersos-agent"
put "$R/run/mastersos/diag.env" 'MASTERSOS_LOG_LEVEL=debug
MASTERSOS_DIAG_AUTHD_ARGS=-vv
MASTERSOS_DIAG_WPA_ARGS=-d'
put "$R/run/NetworkManager/conf.d/90-mastersos-diag.conf" '[logging]
level=DEBUG'
gdm_debug
