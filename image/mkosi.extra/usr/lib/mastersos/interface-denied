#!/bin/bash
# In a locked session (the `learning` mode, or a legacy browser-mode Group) mastersos-agent bind-mounts this file over the
# terminal, file manager and settings executables (core's system/exec_block.rs; `full` unmounts it). When started it only
# shows a notification and exits 126, opening no window. Arguments are ignored (D-Bus activation and wrapper scripts pass
# some). When the notification cannot be sent (no session bus) the text goes to stderr only. The text is in the session's
# language (notice-lib, image/system-i18n; English when the library is missing). MASTERSOS_NOTICE_LIB is for tests.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=notice-lib
. "${MASTERSOS_NOTICE_LIB:-/usr/lib/mastersos/notice-lib}" 2>/dev/null || notice_text() { printf '%s\n' "$1"; }
msg=$(notice_text 'This app is not available on this device')
notify-send --app-name=MastersOS --icon=dialog-information --expire-time=5000 "$msg" >/dev/null 2>&1 || :
printf '%s\n' "$msg" >&2
exit 126
