#!/bin/bash
# mastersos-update.service runs this: download and install the new version. School cache (plan 5 Task 12):
#   when the agent has update_mirror set, same-named transfers in /etc/sysupdate.d/ point [Source] at the
#   cache, and the agent leaves a copy of the originals (channel only, root unchanged) in
#   $var/sysupdate-fallback.d/. Without that directory (no cache set) this behaves exactly like running
#   systemd-sysupdate update. With it:
#   1. Update via the cache, bounded by $cache_timeout. If that fails (unreachable, 404, timeout, tampered
#      content failing verification...) retry once from the official source with --definitions= pointing at
#      the fallback directory, and write the outcome to $var/update-mirror-failed (the agent reports it as
#      update:mirror). The next round tries the cache first again; a round in which the cache works deletes
#      this record (not the stale / unknown ones of step 2).
#   2. A cache cannot alter or downgrade content (everything is signature-checked), but it can serve a stale
#      listing and so delay updates. After a successful cache round, ask the official source whether it has
#      something newer (check-new). The answer has three states: newer (exit 0 and a version on stdout),
#      none (exit 0 or 1 with empty stdout and empty stderr) and unknown (anything else: a message on stderr,
#      timeout, other exit codes). The first time "newer" is seen, $stale is written with the time. If it is
#      still true $grace seconds later, update from the official source and record "school cache stale". Only
#      a definitive "none" (cache caught up) deletes $stale and the stale record; "unknown" touches neither,
#      so a flaky or blocked official source cannot reset the clock. Unknown is tracked in $unknown; after
#      $unknown_grace seconds of it, "freshness unknown" is recorded. Any definitive answer clears it.
#      A timestamp file that is unparsable or lies in the future (clock set back) is rewritten with now.
# Resumable download (2026-11-05): systemd-sysupdate downloads straight into the inactive slot and starts over after any
#   interruption (lid closed, power cut, Wi-Fi gone), and it removes the old inactive slot before it starts, so a slow line
#   could spend days restarting a 1.6 GB download. Every update therefore goes through staged_update: with check-new it asks
#   the source (the [Source] Path= of the transfers sysupdate would use) which version is new, downloads SHA256SUMS and
#   SHA256SUMS.gpg, checks them with gpgv against the image's import-pubring.pgp, then downloads the version's files (the
#   UKI and the three partition files, exact names from the signed listing) with curl --continue-at into
#   $var/update-staging/<hash of the source URL>/, a part file per file kept across rounds and reboots, each moved into
#   place only when its sha256 matches. When all are there, sysupdate runs on copies of the same transfers whose
#   [Source] Path= is file://<that directory>/: it verifies the signature and every file again exactly as it does over
#   https, and writes the slot from local disk in minutes. After a successful update the staging tree is removed.
#   Without usable transfers (none, a source that is not http(s), sources that differ), with too little free space or a
#   check-new that cannot be judged, sysupdate runs directly as before.
# Restart prompt (2026-11-06): after a successful round, update_pending looks at the UKIs on the ESP (the truth of what the
#   next boot starts) and, when one newer than the running IMAGE_VERSION is waiting there, writes its version to
#   $pending (/run/mastersos-update-pending, 0644: /run is emptied by the reboot that applies it) and tells the user of the
#   active graphical session once per version; otherwise it removes the file. The agent reports the version
#   (StatusReport.os_pending_version). `update-run --remind` is the user unit mastersos-update-reminder.service: at the
#   start of a regular desktop session it shows the same notification, as that user. Neither can change the exit code.
# Paths, grace window and timeout can be overridden through environment variables for tests/update-run-test.sh.
set -euo pipefail

sysupdate=${MASTERSOS_SYSUPDATE:-/usr/lib/systemd/systemd-sysupdate}
var=${MASTERSOS_SYSTEM_VAR:-/var/lib/mastersos-system}
# The one place the staleness grace window (12 h, in seconds) is defined.
grace=${MASTERSOS_MIRROR_GRACE:-43200}
cache_timeout=${MASTERSOS_MIRROR_TIMEOUT:-45m}
fallback=$var/sysupdate-fallback.d
status=$var/update-mirror-failed
stale=$var/update-mirror-stale-since
unknown=$var/update-mirror-unknown-since
unknown_grace=${MASTERSOS_MIRROR_UNKNOWN_GRACE:-86400}

staging=$var/update-staging
staged_defs=${MASTERSOS_STAGED_DEFINITIONS:-/run/mastersos-update/definitions}
# where sysupdate looks without --definitions=, highest priority first (sysupdate.d(5))
defs_dirs=${MASTERSOS_SYSUPDATE_DIRS:-/etc/sysupdate.d /run/sysupdate.d /usr/local/lib/sysupdate.d /usr/lib/sysupdate.d}
keyring=${MASTERSOS_GPG_KEYRING:-/usr/lib/systemd/import-pubring.pgp}
# free space needed under $var before a download starts (the staged files count as free: they are reused)
min_free=${MASTERSOS_STAGING_MIN_FREE:-3221225472}
max_list=${MASTERSOS_STAGING_MAX_LIST_BYTES:-1048576}
max_file=${MASTERSOS_STAGING_MAX_FILE_BYTES:-4294967296}
# tests/update-run-test.sh serves a channel from a directory; on a Device a file:// source is local already and runs directly
protos=http,https
[ "${MASTERSOS_STAGING_FILE_URLS:-}" != 1 ] || protos=http,https,file

# the restart prompt (update_pending, remind)
pending=${MASTERSOS_UPDATE_PENDING:-/run/mastersos-update-pending}
NOTIFY_TIMEOUT=${MASTERSOS_NOTIFY_TIMEOUT:-10} # seconds; the session bus belongs to the user, a hung bus must not stall us

# write_status <text>: atomically replace the record with "<UTC time> <text>".
write_status() {
	printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >"$status.tmp" && mv -f -- "$status.tmp" "$status"
}

# newer <definitions dir or empty>: ask check-new; sets NEWER_STATE (newer | none | unknown) and NEWER_OUT
# (the version, for newer). Errors print to stderr while "no candidate" is silent, so stderr is the discriminator.
# SYSTEMD_LOG_LEVEL=warning drops sysupdate's info-level progress lines, which would otherwise make every
# answer "unknown"; errors are logged at warning or above and still come through.
newer() {
	local errf rc=0 err
	errf=$(mktemp)
	if [ -n "$1" ]; then
		NEWER_OUT=$(SYSTEMD_LOG_LEVEL=warning timeout 300 "$sysupdate" --definitions="$1" check-new 2>"$errf") || rc=$?
	else
		NEWER_OUT=$(SYSTEMD_LOG_LEVEL=warning timeout 300 "$sysupdate" check-new 2>"$errf") || rc=$?
	fi
	err=$(cat -- "$errf")
	rm -f -- "$errf"
	if [ "$rc" -eq 0 ] && [ -n "$NEWER_OUT" ]; then
		NEWER_STATE=newer
	elif [ "$rc" -le 1 ] && [ -z "$NEWER_OUT" ] && [ -z "$err" ]; then
		NEWER_STATE=none
	else
		NEWER_STATE=unknown
		NEWER_OUT=
	fi
}

# status_has <text>: does the current record contain it?
status_has() { grep -qF -- "$1" "$status" 2>/dev/null; }

# load_ts <file> <now>: sets TS to the epoch seconds stored in the file. Missing, unparsable or in the future
# (the clock went backwards): rewrite with now and return 1.
load_ts() {
	TS=$(cat -- "$1" 2>/dev/null || true)
	case $TS in '' | *[!0-9]*) ;; *) if [ "$TS" -le "$2" ]; then return 0; fi ;; esac
	TS=$2
	echo "$2" >"$1"
	return 1
}

# transfers <definitions dir or empty>: the *.transfer files sysupdate uses, one path per line (a name in a
# higher-priority directory hides the same name further down)
transfers() {
	local d f
	local -A seen=()
	if [ -n "$1" ]; then
		for f in "$1"/*.transfer; do [ -f "$f" ] && echo "$f"; done
		return 0
	fi
	for d in $defs_dirs; do
		for f in "$d"/*.transfer; do
			[ -f "$f" ] || continue
			[ -z "${seen[${f##*/}]:-}" ] || continue
			seen[${f##*/}]=1
			echo "$f"
		done
	done
}

# source_of <transfer>: "<Type> <Path>" of its [Source] section
source_of() {
	sed -nE '/^\[Source\]/,/^\[/{s/^(Type|Path)=[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1 \2/p}' "$1" |
		awk '$1 == "Type" { t = $2 } $1 == "Path" { p = $2 } END { print t, p }'
}

# get <url> <file> <max bytes>: one small file, downloaded whole
get() {
	rm -f -- "$2"
	curl --fail --silent --show-error --location --proto "=$protos" --proto-redir =https --max-filesize "$3" \
		--connect-timeout 30 --speed-limit 1024 --speed-time 120 --retry 3 --output "$2" "$1"
}

# fetch <url> <file> <sha256>: download into <file>.part, resuming what an earlier round left; <file> appears only with
# the right content. A part file that cannot be completed into the right bytes is dropped (the next round starts over).
fetch() {
	local part=$2.part got have rc=0
	# the cap is on the whole file, across every resumed round: curl may only add what is left of it
	have=$(stat -c %s "$part" 2>/dev/null || echo 0)
	if [ "$have" -ge "$max_file" ]; then
		rm -f -- "$part"
		have=0
	fi
	curl --fail --silent --show-error --location --proto "=$protos" --proto-redir =https \
		--max-filesize "$((max_file - have))" \
		--connect-timeout 30 --speed-limit 1024 --speed-time 300 --retry 5 --retry-delay 10 \
		--continue-at - --output "$part" "$1" || rc=$?
	# --max-filesize is only certain when the server sends a length: never keep more than the cap
	if [ "$(stat -c %s "$part" 2>/dev/null || echo 0)" -gt "$max_file" ]; then
		rm -f -- "$part"
		echo "update-run: ${1##*/} grew past ${max_file} bytes; dropped" >&2
		return 1
	fi
	if [ "$rc" -ne 0 ]; then
		# 33: the server cannot resume; 36: bad resume offset (the part is longer than the file); 63: past the size cap.
		# Either way start over.
		case $rc in 33 | 36 | 63) rm -f -- "$part" ;; esac
		echo "update-run: download of ${1##*/} stopped (curl exit code ${rc}) at $(stat -c %s "$part" 2>/dev/null || echo 0) bytes; the next round resumes it" >&2
		return 1
	fi
	got=$(sha256sum <"$part" | cut -d' ' -f1)
	if [ "$got" != "$3" ]; then
		rm -f -- "$part"
		echo "update-run: ${1##*/} does not match the signed SHA256SUMS (sha256 ${got}); dropped, the next round downloads it again" >&2
		return 1
	fi
	mv -f -- "$part" "$2"
}

# plain <definitions dir or empty>: sysupdate update without staging
plain() {
	if [ -n "$1" ]; then "$sysupdate" --definitions="$1" update; else "$sysupdate" update; fi
}

# staged_update <definitions dir or empty>: the resumable update described at the top. Exit code: 0 updated or nothing
# new, otherwise not updated this round (what was downloaded so far stays for the next one).
staged_update() {
	local defs=$1 f t u url="" v dir sums names n want have avail rc=0
	local -a files=()
	mapfile -t files < <(transfers "$defs")
	[ ${#files[@]} -gt 0 ] || {
		plain "$defs"
		return
	}
	for f in "${files[@]}"; do
		read -r t u < <(source_of "$f")
		if [ "$t" != url-file ] || { [ -n "$url" ] && [ "${u%/}" != "$url" ]; }; then
			echo "update-run: $f is not a url-file transfer from the same source; updating without staging" >&2
			plain "$defs"
			return
		fi
		url=${u%/}
	done
	# the scheme (tests/check-tree.sh item 10 keeps literal plain-http URLs out of the image tree)
	case ${url%%:*} in
	http | https) ;;
	file) [ "${MASTERSOS_STAGING_FILE_URLS:-}" = 1 ] || {
		plain "$defs"
		return
	} ;;
	*)
		plain "$defs"
		return
		;;
	esac

	# one directory per source: main() may stage from the school cache and from the official source in turn
	dir=$staging/$(printf '%s' "$url" | sha256sum | cut -c1-16)
	newer "$defs"
	case $NEWER_STATE in
	none)
		# only this source's download: the other one may be half way through a version this source has not got yet
		rm -rf -- "$dir"
		rmdir -- "$staging" 2>/dev/null || true
		return 0
		;;
	unknown)
		echo "update-run: cannot tell whether $url has a new version; updating without staging" >&2
		plain "$defs"
		return
		;;
	esac
	v=$NEWER_OUT
	[[ $v =~ ^[0-9A-Za-z][0-9A-Za-z._~+-]*$ ]] || {
		echo "update-run: check-new answered an unusable version '${v}'" >&2
		return 1
	}

	install -d -m 0700 "$staging" "$dir"
	# complete files count as free space (they are reused), part files do not
	have=$(find "$dir" -maxdepth 1 -type f ! -name '*.part' -printf '%s\n' | awk '{ n += $1 } END { print n + 0 }')
	avail=$(df --output=avail -B1 "$dir" | tail -n 1 | tr -d ' ')
	if [ $((avail + have)) -lt "$min_free" ]; then
		echo "update-run: only ${avail} bytes free under ${var}; updating without staging" >&2
		plain "$defs"
		return
	fi

	sums=$dir/.SHA256SUMS.new
	if ! get "$url/SHA256SUMS" "$sums" "$max_list" || ! get "$url/SHA256SUMS.gpg" "$sums.gpg" "$max_list"; then
		echo "update-run: cannot download SHA256SUMS from $url" >&2
		return 1
	fi
	if ! gpgv --homedir "$dir" --keyring "$keyring" "$sums.gpg" "$sums" >/dev/null 2>&1; then
		rm -f -- "$sums" "$sums.gpg"
		echo "update-run: SHA256SUMS from $url does not verify against $keyring" >&2
		return 1
	fi
	# the files of version v that the transfers match: the UKI and the partition files (MastersOS_<v>_<arch>.efi,
	# MastersOS_<v>_<arch>.usr-*.raw.zst)
	names=$(sed -nE 's/^[0-9a-f]{64} [ *]?([^ ]+)$/\1/p' "$sums" | awk -v p="MastersOS_${v}_" '
		index($0, p) == 1 && (/\.efi$/ || /\.raw\.zst$/) && /^[A-Za-z0-9._+-]+$/')
	[ -n "$names" ] || {
		echo "update-run: the signed SHA256SUMS lists no files of $v" >&2
		return 1
	}
	# files of other versions (a newer version came out meanwhile) go
	for f in "$dir"/*; do
		[ -e "$f" ] || continue
		n=${f##*/}
		n=${n%.part}
		grep -qxF -- "$n" <<<"$names" || rm -f -- "$f"
	done
	for n in $names; do
		want=$(awk -v n="$n" '$2 == n || $2 == "*" n { print $1; exit }' "$sums")
		if [ -f "$dir/$n" ] && [ "$(sha256sum <"$dir/$n" | cut -d' ' -f1)" = "$want" ]; then
			continue
		fi
		rm -f -- "$dir/$n"
		fetch "$url/$n" "$dir/$n" "$want" || return 1
	done
	mv -f -- "$sums" "$dir/SHA256SUMS"
	mv -f -- "$sums.gpg" "$dir/SHA256SUMS.gpg"
	echo "update-run: $v from $url is downloaded and checked; installing it" >&2

	rm -rf -- "$staged_defs"
	install -d -m 0700 "$staged_defs"
	for f in "${files[@]}"; do
		sed -E '/^\[Source\]/,/^\[/{s#^Path=.*$#Path=file://'"$dir"'/#}' "$f" >"$staged_defs/${f##*/}" || {
			echo "update-run: cannot write $staged_defs/${f##*/}" >&2
			return 1
		}
	done
	"$sysupdate" --definitions="$staged_defs" update || rc=$?
	if [ "$rc" -eq 0 ]; then
		rm -rf -- "$staging"
	else
		echo "update-run: installing $v from the downloaded files failed (exit code ${rc})" >&2
	fi
	return "$rc"
}

main() {
	local rc=0 rc2=0 w v now since

	# No fallback directory: no cache is set, so a failure is just a failure.
	if ! compgen -G "$fallback/*.transfer" >/dev/null; then
		staged_update "" || rc=$?
		return "$rc"
	fi

	newer ""
	w=""
	[ "$NEWER_STATE" = newer ] && w=$NEWER_OUT
	timeout --kill-after=60 "$cache_timeout" "$BASH" "$0" --staged-update "" || rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "update-run: update via the school cache failed (exit code ${rc}), retrying from the official source" >&2
		staged_update "$fallback" || rc2=$?
		if [ "$rc2" -eq 0 ]; then
			write_status "school cache not used: sysupdate exit code ${rc}; this round updated from the official source"
		else
			write_status "both the school cache and the official source failed: cache exit code ${rc}, official exit code ${rc2}"
		fi
		return "$rc2"
	fi
	# The cache worked: drop a "cache not used" record, but keep stale / unknown ones until a definitive answer.
	if ! status_has "school cache stale" && ! status_has "freshness unknown"; then
		rm -f -- "$status"
	fi

	# Is the cache behind the official source?
	now=$(date +%s)
	newer "$fallback"
	case $NEWER_STATE in
	none)
		rm -f -- "$stale" "$unknown"
		if status_has "school cache stale" || status_has "freshness unknown"; then
			rm -f -- "$status"
		fi
		return 0
		;;
	unknown)
		load_ts "$unknown" "$now" || true
		if [ $((now - TS)) -gt "$unknown_grace" ] && ! status_has "school cache stale"; then
			write_status "school cache: freshness unknown for over 24h (official source unreachable)"
		fi
		return 0
		;;
	esac
	v=$NEWER_OUT
	rm -f -- "$unknown"
	if status_has "freshness unknown"; then
		rm -f -- "$status"
	fi
	if ! load_ts "$stale" "$now"; then
		echo "update-run: the official source has ${v} which the school cache does not offer yet" >&2
		return 0
	fi
	since=$TS
	if [ $((now - since)) -lt "$grace" ]; then
		return 0
	fi
	echo "update-run: the school cache has been behind for over ${grace}s, updating from the official source" >&2
	staged_update "$fallback" || rc2=$?
	w=${w:-nothing newer than installed}
	if [ "$rc2" -eq 0 ]; then
		write_status "school cache stale: official has ${v}, cache offers ${w}; this round updated from the official source"
	else
		write_status "school cache stale: official has ${v}, cache offers ${w}; update from the official source failed (exit code ${rc2})"
	fi
	return "$rc2"
}

# --- restart prompt -------------------------------------------------------------------------------------------------------
# ver_ok <v>: a release version YYYYMMDD.N
ver_ok() { [[ $1 =~ ^[0-9]{8}\.[0-9]{1,9}$ ]]; }

# ver_gt <a> <b>: a > b, both ver_ok; by date, then by N as a number (20261105.10 > 20261105.9)
ver_gt() {
	local a1=${1%%.*} a2=${1#*.} b1=${2%%.*} b2=${2#*.}
	((10#$a1 > 10#$b1 || (10#$a1 == 10#$b1 && 10#$a2 > 10#$b2)))
}

# running_version: IMAGE_VERSION of the booted system
running_version() {
	if [ -n "${MASTERSOS_IMAGE_VERSION:-}" ]; then
		echo "$MASTERSOS_IMAGE_VERSION"
		return 0
	fi
	(
		# shellcheck disable=SC1091
		. /usr/lib/os-release 2>/dev/null && echo "${IMAGE_VERSION:-}"
	) || true
}

# boot_path: where sysupdate's 20-uki transfer writes (PathRelativeTo=boot); /boot when bootctl cannot tell
boot_path() {
	local b
	if [ -n "${MASTERSOS_BOOT_PATH:-}" ]; then
		echo "$MASTERSOS_BOOT_PATH"
		return 0
	fi
	b=$(timeout 20 bootctl --print-boot-path 2>/dev/null) || b=""
	echo "${b:-/boot}"
}

# pending_version <running version>: prints the highest version among the UKIs in <boot>/EFI/Linux that can still boot,
# when it is newer than the running one; nothing otherwise. 20-uki.transfer names them MastersOS_<v>_x86-64+<left>-<done>.efi,
# MastersOS_<v>_x86-64+<left>.efi or MastersOS_<v>_x86-64.efi; tries left 0 is a version that used up its boot attempts
# and was rolled back from.
pending_version() {
	local cur=$1 f n v best=""
	ver_ok "$cur" || return 0
	for f in "$(boot_path)"/EFI/Linux/MastersOS_*.efi; do
		[ -f "$f" ] || continue
		n=${f##*/}
		[[ $n =~ ^MastersOS_([0-9]{8}\.[0-9]{1,9})_x86-64(\+([0-9]{1,4})(-[0-9]{1,4})?)?\.efi$ ]] || continue
		v=${BASH_REMATCH[1]}
		[ -z "${BASH_REMATCH[2]}" ] || [ "$((10#${BASH_REMATCH[3]}))" -gt 0 ] || continue
		if [ -z "$best" ] || ver_gt "$v" "$best"; then best=$v; fi
	done
	if [ -n "$best" ] && ver_gt "$best" "$cur"; then echo "$best"; fi
	return 0
}

# notify_text <key> <lang> -> the text for the key in zh / th, English otherwise (integrity's scheme)
notify_text() {
	case $1:$2 in
	update-ready:zh*) echo "系统更新已准备好。重新启动电脑即可完成安装。" ;;
	update-ready:th*) echo "การอัปเดตระบบพร้อมแล้ว รีสตาร์ทคอมพิวเตอร์เพื่อติดตั้งให้เสร็จสมบูรณ์" ;;
	update-ready:*) echo "A system update is ready. Restart the computer to finish installing it." ;;
	*) return 1 ;;
	esac
}

# notify_lang: LANG, else the system locale
notify_lang() {
	if [ -n "${LANG:-}" ]; then
		echo "$LANG"
		return 0
	fi
	sed -nE 's/^LANG=//p' "${MASTERSOS_LOCALE_CONF:-/etc/locale.conf}" 2>/dev/null | tr -d '"' | head -n 1 || true
}

# notify_user <key>: show a desktop notification to the user of the active graphical session; no such session = skip
# (integrity's notify_user)
notify_user() {
	local key=$1 text loginctl=${MASTERSOS_LOGINCTL:-loginctl} runuser=${MASTERSOS_RUNUSER:-runuser} notify=${MASTERSOS_NOTIFY:-notify-send}
	local id line active type name uid class
	text=$(notify_text "$key" "$(notify_lang)") || return 0
	while read -r id _; do
		[ -n "$id" ] || continue
		active="" type="" name="" uid="" class=""
		while read -r line; do
			case $line in
			Active=*) active=${line#Active=} ;;
			Type=*) type=${line#Type=} ;;
			Class=*) class=${line#Class=} ;;
			Name=*) name=${line#Name=} ;;
			User=*) uid=${line#User=} ;;
			esac
		done < <("$loginctl" show-session "$id" -p Active -p Type -p Class -p Name -p User 2>/dev/null || true)
		if [ "$active" != yes ] || [ "$class" != user ]; then continue; fi # not the GDM greeter (Class=greeter)
		[ "$type" = wayland ] || [ "$type" = x11 ] || continue
		if [ -z "$name" ] || ! [[ $uid =~ ^[0-9]+$ ]]; then continue; fi
		timeout -k 2 "$NOTIFY_TIMEOUT" "$runuser" -u "$name" -- env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
			"$notify" --app-name=MastersOS --urgency=normal "MastersOS" "$text" ||
			echo "update-run: notify-send for $name failed" >&2
		return 0
	done < <("$loginctl" list-sessions --no-legend 2>/dev/null || true)
	return 0
}

# update_pending: write or remove $pending (see the top); notify when the waiting version is not the one $pending had
update_pending() {
	local cur v old=""
	cur=$(running_version)
	if ! ver_ok "$cur"; then
		echo "update-run: no release IMAGE_VERSION in os-release ('${cur}'); no restart prompt" >&2
		rm -f -- "$pending"
		return 0
	fi
	v=$(pending_version "$cur")
	if [ -z "$v" ]; then
		rm -f -- "$pending"
		return 0
	fi
	old=$(head -c 64 -- "$pending" 2>/dev/null) || old=""
	[ "$old" != "$v" ] || return 0
	if ! { printf '%s\n' "$v" >"$pending.tmp" && chmod 0644 -- "$pending.tmp" && mv -f -- "$pending.tmp" "$pending"; }; then
		rm -f -- "$pending.tmp"
		echo "update-run: cannot write $pending" >&2
		return 0
	fi
	echo "update-run: $v is installed and starts at the next restart" >&2
	notify_user update-ready
}

# remind: mastersos-update-reminder.service at the start of a desktop session, as that user (its own session bus)
remind() {
	local v cur text notify=${MASTERSOS_NOTIFY:-notify-send}
	# locked-app accounts get nothing (as in browser-wait); their session pulls in no reminder anyway
	case ${USER:-$(id -un 2>/dev/null || :)} in
	kiosk-*) return 0 ;;
	esac
	v=$(head -c 64 -- "$pending" 2>/dev/null) || v=""
	ver_ok "$v" || return 0
	cur=$(running_version)
	if ver_ok "$cur" && ! ver_gt "$v" "$cur"; then return 0; fi
	text=$(notify_text update-ready "$(notify_lang)") || return 0
	timeout -k 2 "$NOTIFY_TIMEOUT" "$notify" --app-name=MastersOS --urgency=normal "MastersOS" "$text" ||
		echo "update-run: notify-send failed" >&2
	return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	# --staged-update <dir or "">: main runs the school-cache attempt through this, under timeout(1)
	if [ "${1:-}" = --staged-update ]; then
		staged_update "${2:-}"
	elif [ "${1:-}" = --remind ]; then
		remind || true
	else
		# main keeps set -e: a subshell started as a plain statement is not a context in which -e is ignored (main || x
		# would be). The restart prompt runs only after a round that succeeded and never changes the exit code.
		set +e
		(
			set -e
			main "$@"
		)
		rc=$?
		set -e
		if [ "$rc" -eq 0 ]; then
			(update_pending) || echo "update-run: the restart prompt failed" >&2
		fi
		exit "$rc"
	fi
fi
