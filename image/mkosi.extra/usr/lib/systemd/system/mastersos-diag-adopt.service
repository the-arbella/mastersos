# Developer diagnostics (docs/specs/2026-11-03-diagnostics-design.md), first boot only: the installer's marker
# /var/lib/mastersos-seed/debug-install (d held at the installer's start) becomes the switch /var/lib/mastersos-diag/enabled on
# the encrypted root, and the marker is deleted. On later boots mastersos-diag-setup deletes any marker found there instead.
# Enabled by the sysinit.target.wants link in /usr/lib, not by a preset.
[Unit]
Description=MastersOS developer diagnostics: take over the installer's switch
DefaultDependencies=no
ConditionFirstBoot=yes
RequiresMountsFor=/var/lib/mastersos-seed /var/lib
After=local-fs.target
Before=mastersos-diag-setup.service first-boot-complete.target sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mastersos/diag-setup adopt
