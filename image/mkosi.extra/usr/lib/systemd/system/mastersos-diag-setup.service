# Developer diagnostics switch (docs/specs/2026-11-03-diagnostics-design.md): with /var/lib/mastersos-seed/debug.conf, writes
# /run/mastersos/diag.env and the NetworkManager logging drop-in, and turns on GDM's debug, before those services start
# (their 90-mastersos-diag.conf drop-ins order them after this unit). After tmpfiles: /etc/gdm3 is a copy path it fills on
# the first boot. Without the switch it writes nothing.
# Enabled by the sysinit.target.wants link in /usr/lib, not by a preset.
[Unit]
Description=MastersOS developer diagnostics setup
DefaultDependencies=no
RequiresMountsFor=/var/lib/mastersos-seed
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target NetworkManager.service wpa_supplicant.service gdm.service authd.service authd-oidc.service mastersos-agent.service mastersos-agent-local.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mastersos/diag-setup
