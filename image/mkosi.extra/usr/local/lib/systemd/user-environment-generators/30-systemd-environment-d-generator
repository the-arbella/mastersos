#!/bin/bash
# On a learning-mode device the user manager's environment comes from the system's environment.d only (locked-session
# hardening, 2026-11-10). systemd's own generator of the same name (/usr/lib/systemd/user-environment-generators, which this
# file masks: the /usr/local directory comes first) also reads $XDG_CONFIG_HOME/environment.d, ~/.config/environment.d by
# default. A student can save a file there from the browser, and a DCONF_PROFILE or GSETTINGS_BACKEND line in it switches
# every dconf lock of the locked sessions off. In learning mode, run the same generator with a configuration home that does
# not exist: it still reads /etc, /run, /usr/local/lib and /usr/lib environment.d and prints only what those files set.
# The mode is mastersos-agent's session-mode file (root 0644, `learning` or `full`, the device's Group decides). Full mode
# (teachers' devices) and a device with no settings yet run the generator unchanged, as on Ubuntu. Any other content counts
# as learning (towards the lock). The environment is fixed when
# the user manager starts: a device switched to learning keeps a running manager's environment until it stops (the user
# signs out of every session, or the machine restarts). Tested by image/tests/user-env-test.sh.
set -euo pipefail
mode_file=/var/lib/mastersos-public/session-mode
# Settings format 3 (user layer): the agent points the `session` link at the signed-in person's user config, whose
# session-mode applies only to a user manager of the uid in session/uid; any other one (a tty login, systemd-run,
# machinectl), or no readable uid, is locked. The file above is read only without the link (format 1/2); under format 3
# it always reads `learning` (what an older image after a rollback sees).
session_dir=/var/lib/mastersos-public/session
orig=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
# The login screen is not a person's session. gdm runs it as an account of its own whose home it creates under
# /run/gdm3/home at start, and hands it DCONF_PROFILE=gdm and its data directories through that home's environment.d.
# Without them the login screen reads the ordinary profile, starts as a desktop (gnome-shell --mode=user) and nobody can
# sign in. So that account runs the generator unchanged in every mode. The home comes from the account database, never
# from $HOME: only root makes accounts, and no person's home is under gdm's runtime directory.
greeter_home=/run/gdm3/home
acct_home=$(getent passwd "$UID" | cut -d: -f6) || acct_home=
case "$acct_home" in "$greeter_home"/?*) exec "$orig" "$@" ;; esac
mode=
if [ -L "$session_dir" ] || [ -e "$session_dir" ]; then
	mode=learning
	owner=$(cat "$session_dir/uid" 2>/dev/null) || owner=
	if [ -n "$owner" ] && [ "$owner" = "$UID" ] && [ -e "$session_dir/session-mode" ]; then
		mode=$(tr -d '[:space:]' <"$session_dir/session-mode" | tr '[:upper:]' '[:lower:]') || mode=learning
		[ -n "$mode" ] || mode=learning
	fi
elif [ -e "$mode_file" ]; then
	mode=$(tr -d '[:space:]' <"$mode_file" | tr '[:upper:]' '[:lower:]') || mode=learning
	[ -n "$mode" ] || mode=learning
fi
# No cross-check with the dconf locks: the agent publishes session-mode tighten-first, loosen-last (invariant 1), so the
# order is guaranteed there.
case "$mode" in
'' | full) exec "$orig" "$@" ;;
*) XDG_CONFIG_HOME=/nonexistent exec "$orig" "$@" ;;
esac
