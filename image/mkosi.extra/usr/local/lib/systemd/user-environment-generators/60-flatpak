#!/bin/bash
# Flatpak's exports in the session's XDG_DATA_DIRS: the system installation only (locked-session hardening, 2026-11-10).
# Flatpak's own generator of the same name (/usr/lib/systemd/user-environment-generators, masked by this file) puts the
# user's ~/.local/share/flatpak/exports/share in front of every other data directory. gnome-shell treats extensions found
# in XDG_DATA_DIRS as system extensions and the first copy of a uuid wins, so a student could save a look-alike of
# mastersos-managed@mastersos.org there and have it run inside the shell under the locked profile. MastersOS installs
# Flatpaks system-wide (mastersos-agent's flatpak step); per-user installs no longer show in the app grid.
# Tested by image/tests/user-env-test.sh.
set -euo pipefail
export GIO_USE_VFS=local
exec flatpak --print-updated-env --print-system-only
