# The sign-in card's Chrome (mastersos-login-browser@.service, AppArmorProfile=). This browser shows a website on the login
# screen, before anyone has signed in, so a Chrome exploit must get no further than this: no execution outside Chrome, no
# files but Chrome's own, what it needs to draw on the greeter's Wayland socket and its throwaway profile in the unit's
# private /tmp. Everything not listed is denied. Attached by systemd only: the distribution's `chrome` profile keeps
# /opt/google/chrome/chrome for every other Chrome on the machine.
abi <abi/5.0>,
include <tunables/global>

profile mastersos-login-browser flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/fonts>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  # Chrome's sandbox: a user namespace, then chroot and a drop of privileges inside it.
  userns,
  capability sys_admin,
  capability sys_chroot,
  capability sys_ptrace,
  capability setuid,
  capability setgid,
  # systemd's change_onexec stacks on the distribution's `chrome` label once Chrome is exec'd (that one is unconfined, so
  # this profile alone decides), and the processes see each other under the stacked name.
  ptrace (read, trace) peer=chrome//&mastersos-login-browser,
  signal (send, receive) peer=chrome//&mastersos-login-browser,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix,

  # The launcher script and the small tools Chrome's wrapper runs.
  /usr/lib/mastersos/login-browser r,
  /{usr/,}bin/bash ix,
  # Ubuntu's coreutils are uutils behind symlinks, except rm; AppArmor sees the target.
  /usr/lib/cargo/bin/coreutils/{cat,dirname,head,id,mkdir,readlink,tail,touch} ix,
  /usr/bin/gnurm ix,
  /usr/bin/google-chrome-stable r,

  # Chrome itself. No other executable: not a shell a renderer could reach, not xdg-open.
  /opt/google/chrome/ r,
  /opt/google/chrome/** r,
  /opt/google/chrome/google-chrome ix,
  /opt/google/chrome/chrome ix,
  /opt/google/chrome/chrome_crashpad_handler ix,

  # The greeter's display, and the URL the extension leaves.
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/wayland-[0-9]* rw,
  owner /run/user/[0-9]*/wayland-[0-9]*.lock r,
  owner /run/user/[0-9]*/mastersos-login-url rw,
  owner /run/user/[0-9]*/dconf/ rw,
  owner /run/user/[0-9]*/dconf/user rw,

  # The throwaway profile (PrivateTmp=).
  /tmp/ r,
  /var/tmp/ r,
  owner /tmp/** rwlk,
  owner /dev/shm/** rw,
  /dev/shm/ r,

  # Policy, certificates and display basics.
  /etc/opt/chrome/ r,
  /etc/opt/chrome/** r,
  /etc/ld.so.cache r,
  /etc/dconf/** r,
  /etc/dconf/db/* mr,
  /etc/localtime r,
  /etc/locale.conf r,
  /etc/machine-id r,
  /var/lib/dbus/machine-id r,
  /usr/share/** r,
  /usr/lib/x86_64-linux-gnu/** mr,
  /dev/null rw,
  /dev/urandom r,
  /dev/dri/ r,
  /dev/dri/* rw,

  # What Chrome probes about itself and the machine.
  @{PROC}/ r,
  @{PROC}/@{pid}/** r,
  owner @{PROC}/@{pid}/oom_score_adj rw,
  owner @{PROC}/@{pid}/setgroups rw,
  owner @{PROC}/@{pid}/{uid,gid}_map rw,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/clear_refs w,
  @{PROC}/sys/** r,
  @{PROC}/{cpuinfo,meminfo,stat,uptime,version} r,
  /sys/devices/** r,
  /sys/bus/ r,
  /sys/bus/** r,
  /sys/class/ r,
  /sys/class/** r,
  /sys/fs/cgroup/** r,

  # Spelled out for the review: none of this is in the list above anyway.
  deny /home/** rwlkmx,
  deny /root/** rwlkmx,
  deny /var/lib/authd/** rwlkmx,
  deny /var/lib/authd-oidc/** rwlkmx,
  deny /var/lib/mastersos-system/** rwlkmx,
  deny /etc/authd/** rwlkmx,
  deny /etc/shadow rwlkmx,

  include if exists <local/mastersos-login-browser>
}
