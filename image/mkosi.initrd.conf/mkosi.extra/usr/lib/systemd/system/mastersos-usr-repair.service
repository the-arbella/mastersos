# /usr self-repair in the initrd (usr-self-repair Task 3 skeleton; the repair itself comes in Task 6).
# Runs once udev has coldplugged the disks and before the active slot's /usr is opened: it must finish before
# systemd-veritysetup@usr.service maps the data partition (a repair writes that partition) and before sysusr-usr.mount.
# Pulled in by initrd.target.wants/ (every boot; the script exits 0 at once on machines without a golden copy).
# ConditionPathExists: the script needs LoaderDevicePartUUID to find the ESP and the boot disk.
# No FailureAction=: whatever happens, the script exits 0 and the boot goes on. TimeoutStartSec leaves room for
# rewriting a slot (about 2 GB) in Task 6.
# Measured (Task 3, image 20261027.2, VM 165 and 170; lab/results/2026-10-27-usr-repair/t3-spike.txt): this ordering holds as
# written; the unit starts at ~2.05 s and finishes (~0.4 s) before systemd-veritysetup@usr.service starts. udevadm wait on the
# by-partuuid links, then `mount -t vfat /dev/disk/by-partuuid/<LoaderDevicePartUUID>` works in the initrd (vfat and nls_cp437
# built in, nls_iso8859-1 a module); no "volume was not properly unmounted" afterwards. The active slot's partitions carry the GPT
# read-only attribute but blockdev --getro is 0 for all three here. Task 6 keeps this unit as it is.
[Unit]
Description=MastersOS: check and repair the /usr slot from the golden copy (initrd)
DefaultDependencies=no
ConditionPathExists=/sys/firmware/efi/efivars
After=systemd-udevd.service systemd-udev-trigger.service
# Ordering only: the script picks Plymouth or the console with plymouth --ping, so Plymouth must be up before it asks (when
# the splash started later it would cover the "do not power off" text for the whole repair).
After=plymouth-start.service
Before=systemd-veritysetup@usr.service sysusr-usr.mount initrd-usr-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
TimeoutStartSec=10min
ExecStart=/usr/lib/mastersos/usr-repair
