+
+func TestMastersOSBCP47Tags(t *testing.T) {
+	for in, want := range map[string]string{
+		"th_TH.UTF-8":  "th-TH",
+		"th_TH":        "th-TH",
+		"zh_CN":        "zh-CN",
+		"sr_RS@latin":  "sr-RS",
+		"fil_PH.UTF-8": "fil-PH",
+		"en":           "en",
+		"C":            "",
+		"C.UTF-8":      "",
+		"POSIX":        "",
+		"":             "",
+		"th_th":        "",
+		"th_TH_x":      "",
+		"t\nh":         "",
+		"th&x=y":       "",
+	} {
+		require.Equal(t, want, broker.BCP47Tag(in), "locale %q", in)
+	}
+}
+
+func TestMastersOSSystemLangFallsBackToEnvironment(t *testing.T) {
+	broker.SetSystemLocaleFiles(t, filepath.Join(t.TempDir(), "absent"))
+	t.Setenv("LANG", "ar_SA.UTF-8")
+	require.Equal(t, "ar_SA.UTF-8", broker.SystemLang())
+}
+
+// The school's page accepted a different account from the person picked on the greeter. The greeter matches this text to
+// show its refusal, so a changed message would turn a refusal into a generic failure.
+func TestMastersOSCardOnlyDeniesAnotherAccount(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := cardOnlyBrokerWith(t, map[string]testutils.EndpointHandler{
+		"/token": testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+			IDTokenClaims: []map[string]interface{}{{"sub": "other-user-id", "email": "someone-else@email.com"}},
+		}),
+	})
+
+	sessionID, _ := newSessionForTests(t, b, "test-user@email.com", "")
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	signInOnCard(t, b, sessionID)
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthDenied, access, "data: %s", data)
+	require.Contains(t, data, "does not match the authenticated user", "the login screen matches this text for its refusal")
+	require.Contains(t, data, "test-user@email.com", "the refusal names the account that was asked for")
+	require.Contains(t, data, "someone-else@email.com", "and the one that signed in")
+	_, statErr := os.Stat(b.TokenPathForSession(sessionID))
+	require.ErrorIs(t, statErr, os.ErrNotExist, "a refused login must not leave a token for the requested account")
+}
