+package broker_test
+
+// MastersOS carried patch (image/patches/authd-oidc/0004-card-only-login.patch). These tests set the process environment,
+// so none of them is parallel; parallel tests only resume after every serial test has finished.
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker/authmodes"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/password"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/token"
+	"github.com/stretchr/testify/require"
+)
+
+const cardOnlyAddress = "127.0.0.1:31397"
+
+func cardOnlyBroker(t *testing.T) *broker.Broker {
+	t.Helper()
+	return newBrokerForTests(t, &brokerForTestConfig{
+		Config:                 broker.Config{DataDir: t.TempDir()},
+		ownerAllowed:           true,
+		firstUserBecomesOwner:  true,
+		supportsFetchingGroups: true,
+		listenAddress:          cardOnlyAddress,
+		customHandlers: map[string]testutils.EndpointHandler{
+			"/token": testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+				IDTokenClaims: []map[string]interface{}{{"sub": "saved-user-id"}},
+			}),
+		},
+	})
+}
+
+// signInOnCard selects the web mode and plays the browser: the redirect the school's page would send.
+func signInOnCard(t *testing.T, b *broker.Broker, sessionID string) {
+	t.Helper()
+	require.NoError(t, b.SetAvailableMode(sessionID, authmodes.DeviceQr))
+	layout, err := b.SelectAuthenticationMode(sessionID, authmodes.DeviceQr)
+	require.NoError(t, err, "selecting the web mode should start the sign-in")
+	u, err := url.Parse(layout["content"])
+	require.NoError(t, err)
+	res, err := http.Get("http://127.0.0.1:48123/callback?code=c&state=" + u.Query().Get("state"))
+	require.NoError(t, err)
+	require.NoError(t, res.Body.Close())
+	require.Equal(t, http.StatusOK, res.StatusCode)
+}
+
+func TestMastersOSCardOnlyFirstLoginHasNoLocalPassword(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := cardOnlyBroker(t)
+	sessionID, _ := newSessionForTests(t, b, "", "")
+
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	signInOnCard(t, b, sessionID)
+
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+	require.True(t, json.Valid([]byte(data)))
+	require.Contains(t, data, `"userinfo"`)
+	require.Empty(t, b.GetNextAuthModes(sessionID), "nothing follows the school's page")
+	_, err = os.Stat(b.PasswordFilepathForSession(sessionID))
+	require.ErrorIs(t, err, os.ErrNotExist, "no local password may exist after a card login")
+}
+
+func TestMastersOSCardOnlyIgnoresAndRemovesAnOldLocalPassword(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := cardOnlyBroker(t)
+	sessionID, _ := newSessionForTests(t, b, "", "")
+	generateAndStoreCachedInfo(t, tokenOptions{}, b.TokenPathForSession(sessionID))
+	require.NoError(t, password.HashAndStorePassword("password", b.PasswordFilepathForSession(sessionID)))
+
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	signInOnCard(t, b, sessionID)
+
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+	_, err = os.Stat(b.PasswordFilepathForSession(sessionID))
+	require.ErrorIs(t, err, os.ErrNotExist, "the old hash should be gone")
+}
+
+func TestMastersOSCardOnlyRefusesPasswordMode(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := cardOnlyBroker(t)
+	sessionID, _ := newSessionForTests(t, b, "", "")
+	generateAndStoreCachedInfo(t, tokenOptions{}, b.TokenPathForSession(sessionID))
+	require.NoError(t, password.HashAndStorePassword("password", b.PasswordFilepathForSession(sessionID)))
+
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	_, err := b.SelectAuthenticationMode(sessionID, authmodes.Password)
+	require.Error(t, err, "a client must not be able to pick the local password by name")
+}
+
+func TestMastersOSCardOnlyWithoutProviderNoSession(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := newBrokerForTests(t, &brokerForTestConfig{
+		Config:       broker.Config{DataDir: t.TempDir()},
+		ownerAllowed: true,
+		issuerURL:    "http://127.0.0.1:1",
+	})
+	_, _, err := b.NewSession("test-user@email.com", "some lang", "login", "")
+	require.ErrorContains(t, err, "Error connecting to provider", "the login screen matches this text for its offline card")
+}
+
+// withoutRefreshToken answers like the provider's token endpoint with no offline_access granted.
+func withoutRefreshToken(next testutils.EndpointHandler) testutils.EndpointHandler {
+	return func(w http.ResponseWriter, r *http.Request) {
+		rec := httptest.NewRecorder()
+		next(rec, r)
+		var body map[string]interface{}
+		if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		delete(body, "refresh_token")
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(body)
+	}
+}
+
+func cardOnlyBrokerWith(t *testing.T, handlers map[string]testutils.EndpointHandler) *broker.Broker {
+	t.Helper()
+	return newBrokerForTests(t, &brokerForTestConfig{
+		Config:                 broker.Config{DataDir: t.TempDir()},
+		ownerAllowed:           true,
+		firstUserBecomesOwner:  true,
+		supportsFetchingGroups: true,
+		listenAddress:          cardOnlyAddress,
+		customHandlers:         handlers,
+	})
+}
+
+func cardOnlyTokenHandler() testutils.EndpointHandler {
+	return testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+		IDTokenClaims: []map[string]interface{}{{"sub": "saved-user-id"}, {"sub": "saved-user-id"}, {"sub": "saved-user-id"}},
+	})
+}
+
+func requireCardGranted(t *testing.T, b *broker.Broker, sessionID string) {
+	t.Helper()
+	signInOnCard(t, b, sessionID)
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+}
+
+func TestMastersOSCardOnlyLoginsNeedNoRefreshToken(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := cardOnlyBrokerWith(t, map[string]testutils.EndpointHandler{"/token": withoutRefreshToken(cardOnlyTokenHandler())})
+
+	sessionID, _ := newSessionForTests(t, b, "", "")
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	requireCardGranted(t, b, sessionID)
+	// The login moves the cache to a directory named after the provider ID, so the path is only known now.
+	tokenPath := b.TokenPathForSession(sessionID)
+	info, err := token.LoadAuthInfo(tokenPath)
+	require.NoError(t, err)
+	require.Empty(t, info.Token.RefreshToken, "the provider issued none")
+
+	// The next login finds a cached token that cannot be refreshed, and goes to the card as the first one did.
+	sessionID, _ = newSessionForTests(t, b, "", "")
+	require.Equal(t, tokenPath, b.TokenPathForSession(sessionID), "the second login must see the first one's cache")
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	requireCardGranted(t, b, sessionID)
+	require.Empty(t, b.GetNextAuthModes(sessionID), "nothing may follow the school's page")
+}
+
+func TestMastersOSCardOnlyExpiredCacheDoesNotDeadEnd(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, opts := range map[string]tokenOptions{
+		"no refresh token":      {noRefreshToken: true, expired: true},
+		"expired refresh token": {refreshTokenExpired: true, expired: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			b := cardOnlyBrokerWith(t, map[string]testutils.EndpointHandler{"/token": withoutRefreshToken(cardOnlyTokenHandler())})
+			sessionID, _ := newSessionForTests(t, b, "", "")
+			generateAndStoreCachedInfo(t, opts, b.TokenPathForSession(sessionID))
+			require.NoError(t, password.HashAndStorePassword("password", b.PasswordFilepathForSession(sessionID)))
+
+			requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+			requireCardGranted(t, b, sessionID)
+
+			info, err := token.LoadAuthInfo(b.TokenPathForSession(sessionID))
+			require.NoError(t, err)
+			require.Empty(t, info.Token.RefreshToken, "a stored refresh token must not outlive the first card login")
+			require.True(t, info.Token.Expiry.After(time.Now()), "the fresh token replaces the cached one")
+		})
+	}
+}
+
+func TestMastersOSCardOnlyNeedsNoDeviceEndpoint(t *testing.T) {
+	serverURL := "http://" + cardOnlyAddress
+	handlers := map[string]testutils.EndpointHandler{
+		"/.well-known/openid-configuration": testutils.OpenIDHandlerWithNoDeviceEndpoint(serverURL),
+		"/token":                            cardOnlyTokenHandler(),
+	}
+
+	t.Run("offered on the card", func(t *testing.T) {
+		t.Setenv("MASTERSOS_AUTH_CODE", "1")
+		b := cardOnlyBrokerWith(t, handlers)
+		sessionID, _ := newSessionForTests(t, b, "", "")
+		requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+		requireCardGranted(t, b, sessionID)
+	})
+
+	t.Run("still required without the card", func(t *testing.T) {
+		t.Setenv("MASTERSOS_AUTH_CODE", "")
+		b := cardOnlyBrokerWith(t, handlers)
+		sessionID, _ := newSessionForTests(t, b, "", "")
+		_, err := b.GetAuthenticationModes(sessionID, supportedLayouts)
+		require.ErrorContains(t, err, "no authentication modes available")
+	})
+}
+
+func TestMastersOSCardOnlySendsLanguageToThePage(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	t.Setenv("LANG", "de_DE.UTF-8")
+
+	dir := t.TempDir()
+	localeConf := filepath.Join(dir, "locale.conf")
+	require.NoError(t, os.WriteFile(localeConf, []byte("# managed\nLC_TIME=en_GB.UTF-8\nLANG=\"th_TH.UTF-8\"\n"), 0o600))
+	broker.SetSystemLocaleFiles(t, filepath.Join(dir, "absent"), localeConf)
+
+	for name, tc := range map[string]struct {
+		lang, want string
+		noSystem   bool
+	}{
+		"system beats a stale session":     {lang: "zh_CN", want: "th-TH"},
+		"session names no language":        {lang: "C", want: "th-TH"},
+		"session did not give a lang":      {lang: "", want: "th-TH"},
+		"session when the system has none": {lang: "zh_CN", want: "zh-CN", noSystem: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if tc.noSystem {
+				broker.SetSystemLocaleFiles(t, filepath.Join(dir, "absent"))
+				t.Setenv("LANG", "")
+			}
+			b := cardOnlyBroker(t)
+			sessionID, _, err := b.NewSession("test-user@email.com", tc.lang, "login", "")
+			require.NoError(t, err)
+			requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+			require.NoError(t, b.SetAvailableMode(sessionID, authmodes.DeviceQr))
+			layout, err := b.SelectAuthenticationMode(sessionID, authmodes.DeviceQr)
+			require.NoError(t, err)
+			u, err := url.Parse(layout["content"])
+			require.NoError(t, err)
+			require.Equal(t, tc.want, u.Query().Get("ui_locales"))
+			require.Equal(t, "test-user@email.com", u.Query().Get("login_hint"))
+			b.CancelIsAuthenticated(sessionID)
+		})
+	}
