@@ -0,0 +1,19 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0004-card-only-login.patch): the helpers its tests reach.
+
+import "testing"
+
+// BCP47Tag and SystemLang expose the language lookup for tests.
+var (
+	BCP47Tag   = bcp47Tag
+	SystemLang = systemLang
+)
+
+// SetSystemLocaleFiles points the system language lookup at paths for the length of the test.
+func SetSystemLocaleFiles(t *testing.T, paths ...string) {
+	t.Helper()
+	saved := systemLocaleFiles
+	systemLocaleFiles = paths
+	t.Cleanup(func() { systemLocaleFiles = saved })
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_cardonly_test.go b/authd-oidc-brokers/internal/broker/mastersos_cardonly_test.go
