diff --git a/authd-oidc-brokers/internal/broker/mastersos_cardonly.go b/authd-oidc-brokers/internal/broker/mastersos_cardonly.go
new file mode 100644
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_cardonly.go
@@ -0,0 +1,95 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0004-card-only-login.patch): with MASTERSOS_AUTH_CODE=1 the school's
+// page is the only way in. The broker offers no local password, asks for none after the page, and refuses to start a
+// session when the identity provider cannot be reached (the login screen says so), so there is no offline login. A hash
+// left by an older version is deleted at the next login: nothing reads it any more.
+//
+// Nothing here needs a refresh token: the password path was the only reader of a cached token at login, so a provider
+// that issues none (no offline_access requested) logs in the same way every time, through its page. The device
+// authorization endpoint is not needed either. The page gets the login screen's language through ui_locales.
+
+import (
+	"context"
+	"errors"
+	"io/fs"
+	"os"
+	"strings"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/token"
+	"github.com/canonical/authd/log"
+	"golang.org/x/oauth2"
+)
+
+// systemLocaleFiles are read in order for LANG: localectl writes the first. The broker's own LANG comes last because it
+// is frozen at boot, and the login screen changes the language without a reboot.
+var systemLocaleFiles = []string{"/etc/locale.conf", "/etc/default/locale"}
+
+// cardAuthOptions carries the language to the school's page; without a usable one the page picks its own. The system
+// language wins: the login screen changes it without restarting GDM, whose session worker keeps the old LANG.
+func cardAuthOptions(sessionLang string) []oauth2.AuthCodeOption {
+	tag := bcp47Tag(systemLang())
+	if tag == "" {
+		tag = bcp47Tag(sessionLang)
+	}
+	if tag == "" {
+		return nil
+	}
+	return []oauth2.AuthCodeOption{oauth2.SetAuthURLParam("ui_locales", tag)}
+}
+
+// systemLang is the system's LANG, or "" when it is not set.
+func systemLang() string {
+	for _, path := range systemLocaleFiles {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+		for _, line := range strings.Split(string(data), "\n") {
+			if value, ok := strings.CutPrefix(strings.TrimSpace(line), "LANG="); ok {
+				return strings.Trim(value, `"'`)
+			}
+		}
+	}
+	return os.Getenv("LANG")
+}
+
+// bcp47Tag turns a POSIX locale (th_TH.UTF-8, sr_RS@latin, zh_CN) into a language tag (th-TH, sr-RS, zh-CN). "" for
+// anything else, which includes C and POSIX: they name no language.
+func bcp47Tag(locale string) string {
+	if i := strings.IndexAny(locale, ".@"); i >= 0 {
+		locale = locale[:i]
+	}
+	language, region, hasRegion := strings.Cut(locale, "_")
+	if len(language) < 2 || len(language) > 3 || !asciiIn(language, 'a', 'z') {
+		return ""
+	}
+	if !hasRegion {
+		return language
+	}
+	if len(region) != 2 || !asciiIn(region, 'A', 'Z') {
+		return ""
+	}
+	return language + "-" + region
+}
+
+func asciiIn(s string, low, high byte) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < low || s[i] > high {
+			return false
+		}
+	}
+	return true
+}
+
+// finishCardLogin ends a login that went through the school's page.
+func (b *Broker) finishCardLogin(session *session, authInfo *token.AuthCachedInfo) (string, isAuthenticatedDataResponse) {
+	access, data := b.finishAuth(session, authInfo)
+	if access != AuthGranted {
+		return access, data
+	}
+	if err := os.Remove(session.passwordPath); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		log.Warningf(context.Background(), "Could not remove the old local password of user %q: %v", session.username, err)
+	}
+	return access, data
+}
