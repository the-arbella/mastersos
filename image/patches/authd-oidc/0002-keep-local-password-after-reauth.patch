From 79c51cee7b7242732cbe2d71d9275009dbfa5165 Mon Sep 17 00:00:00 2001
From: MastersOS <mastersos@khundavid.com>
Date: Tue, 20 Oct 2026 10:39:24 +0700
Subject: [PATCH] broker: keep the verified local password after a forced
 re-login

After a refused refresh the user re-authenticates with the device code, and
deviceAuth always continues with the newpassword mode, so the user has to
define the local password again and the stored hash is replaced, although the
same identity typed its correct local password a moment earlier in the same
session.

Remember the provider ID whose local password passwordAuth verified. When a
device-code login in that login session returns the same provider ID and the
password file exists, finish the authentication and keep the stored hash, as
the passwordless Entra flow already does for returning users. First logins,
device auth chosen directly and any other identity still define a local
password.

Carried by MastersOS (mastersos/image/patches/authd-oidc/) on top of oidc-0.5.2.
---
 authd-oidc-brokers/internal/broker/broker.go  |  18 +++
 .../broker/mastersos_keep_password_test.go       | 136 ++++++++++++++++++
 2 files changed, 154 insertions(+)
 create mode 100644 authd-oidc-brokers/internal/broker/mastersos_keep_password_test.go

diff --git a/authd-oidc-brokers/internal/broker/broker.go b/authd-oidc-brokers/internal/broker/broker.go
index f553268d..45f7f21e 100644
--- a/authd-oidc-brokers/internal/broker/broker.go
+++ b/authd-oidc-brokers/internal/broker/broker.go
@@ -129,6 +129,10 @@ type session struct {
 	// send it there again.
 	entraAuthFidoPasswordFallbackAttempted bool
 	fidoPIN                                string // security key PIN, kept in memory only while the FIDO exchange runs
+	// MastersOS: provider ID of the user whose existing local password was verified in this login session
+	// (set by passwordAuth before the online refresh). A device-code re-login of that same identity then
+	// keeps the local password instead of asking for a new one.
+	localPasswordVerifiedFor string
 
 	isAuthenticating *isAuthenticatedCtx
 }
@@ -1462,6 +1466,18 @@ func (b *Broker) deviceAuth(ctx context.Context, session *session) (string, isAu
 		return AuthDenied, errorMessageForDisplay(err, "Failed to retrieve groups from Microsoft Graph API")
 	}
 
+	// MastersOS: a re-login forced by a refused refresh, right after this same identity typed its correct local
+	// password, keeps that password (as the passwordless Entra flow does for returning users) instead of
+	// asking for a new one. First logins, device auth chosen directly and any other identity still define
+	// a local password.
+	// (authd 0.6 still opens login sessions with the old mode name "auth", so test for "not a password change".)
+	isPasswordChange := session.mode == sessionmode.ChangePassword || session.mode == sessionmode.ChangePasswordOld
+	if !isPasswordChange && session.localPasswordVerifiedFor != "" &&
+		session.localPasswordVerifiedFor == authInfo.UserInfo.ProviderID && passwordFileExists(*session) {
+		log.Noticef(context.Background(), "Re-authenticated user %q after a refused refresh, keeping the local password verified in this session", session.username)
+		return b.finishAuth(session, authInfo)
+	}
+
 	// Store the auth info in the session so that we can use it when handling the
 	// next IsAuthenticated call for the new password mode.
 	session.authInfo = authInfo
@@ -1497,6 +1513,8 @@ func (b *Broker) passwordAuth(ctx context.Context, session *session, secret stri
 		return AuthNext, nil
 	}
 
+	session.localPasswordVerifiedFor = authInfo.UserInfo.ProviderID
+
 	// Refresh the token on every online login (even if it has not expired) to
 	// re-verify the account with the provider. This refresh is also the live
 	// disabled/revoked-user check. Tokens obtained via the Entra auth flow are issued by the
diff --git a/authd-oidc-brokers/internal/broker/mastersos_keep_password_test.go b/authd-oidc-brokers/internal/broker/mastersos_keep_password_test.go
new file mode 100644
index 00000000..787cd3e1
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_keep_password_test.go
@@ -0,0 +1,136 @@
+package broker_test
+
+// MastersOS carried patch (mastersos/image/patches/authd-oidc/0002-keep-local-password-after-reauth.patch): a device-code
+// re-login forced by a refused refresh keeps the local password that the same identity verified in this session;
+// every other device-code login still asks for a new local password.
+
+import (
+	"bytes"
+	"fmt"
+	"net/http"
+	"os"
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker/authmodes"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker/sessionmode"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/password"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+// refusingRefreshTokenHandler refuses refresh_token grants as Dex does when a newer login replaced the token, and
+// answers every other grant (the device code) with a token whose "sub" is sub.
+func refusingRefreshTokenHandler(serverURL, sub string) testutils.EndpointHandler {
+	device := testutils.TokenHandler(serverURL, &testutils.TokenHandlerOptions{
+		IDTokenClaims: []map[string]interface{}{{"sub": sub}},
+	})
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.FormValue("grant_type") == "refresh_token" {
+			w.Header().Add("Content-Type", "application/json")
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`{"error":"invalid_request","error_description":"Refresh token is invalid or has already been claimed by another client."}`))
+			return
+		}
+		device(w, r)
+	}
+}
+
+func TestMastersOSReauthKeepsVerifiedLocalPassword(t *testing.T) {
+	t.Parallel()
+
+	const correctPassword = "password"
+	// generateCachedInfo caches the user with ProviderID "saved-user-id"
+	const cachedSub = "saved-user-id"
+
+	tests := map[string]struct {
+		address string
+		// the "sub" of the device-code login
+		deviceSub string
+		// the user types the local password first and the refresh is refused (otherwise: device auth chosen directly)
+		passwordFirst bool
+		// no cached token and no local password (first login on this machine)
+		firstLogin bool
+		// session mode (default sessionmode.Login)
+		mode string
+
+		wantAccess string
+	}{
+		"Refused_refresh_then_device_code_for_the_same_identity_keeps_the_local_password": {
+			address: "127.0.0.1:31392", deviceSub: cachedSub, passwordFirst: true,
+			wantAccess: broker.AuthGranted,
+		},
+		"Same_identity_keeps_the_local_password_with_the_old_login_mode_name": {
+			address: "127.0.0.1:31396", deviceSub: cachedSub, passwordFirst: true, mode: sessionmode.LoginOld,
+			wantAccess: broker.AuthGranted,
+		},
+		"Refused_refresh_then_device_code_for_another_identity_asks_for_a_new_password": {
+			address: "127.0.0.1:31393", deviceSub: "other-user-id", passwordFirst: true,
+			wantAccess: broker.AuthNext,
+		},
+		"Device_code_chosen_directly_asks_for_a_new_password": {
+			address: "127.0.0.1:31394", deviceSub: cachedSub,
+			wantAccess: broker.AuthNext,
+		},
+		"First_login_asks_for_a_local_password": {
+			address: "127.0.0.1:31395", deviceSub: cachedSub, firstLogin: true,
+			wantAccess: broker.AuthNext,
+		},
+	}
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			b := newBrokerForTests(t, &brokerForTestConfig{
+				Config:                 broker.Config{DataDir: t.TempDir()},
+				ownerAllowed:           true,
+				firstUserBecomesOwner:  true,
+				supportsFetchingGroups: true,
+				listenAddress:          tc.address,
+				customHandlers: map[string]testutils.EndpointHandler{
+					"/token": refusingRefreshTokenHandler("http://"+tc.address, tc.deviceSub),
+				},
+			})
+
+			if tc.mode == "" {
+				tc.mode = sessionmode.Login
+			}
+			sessionID, key := newSessionForTests(t, b, "", tc.mode)
+			var passwordBefore []byte
+			if !tc.firstLogin {
+				generateAndStoreCachedInfo(t, tokenOptions{}, b.TokenPathForSession(sessionID))
+				require.NoError(t, password.HashAndStorePassword(correctPassword, b.PasswordFilepathForSession(sessionID)),
+					"Setup: HashAndStorePassword should not have returned an error")
+				var err error
+				passwordBefore, err = os.ReadFile(b.PasswordFilepathForSession(sessionID))
+				require.NoError(t, err, "Setup: ReadFile should not have returned an error")
+			}
+
+			if tc.passwordFirst {
+				updateAuthModes(t, b, sessionID, authmodes.Password)
+				authData := fmt.Sprintf(`{"%s":"%s"}`, broker.AuthDataSecret, encryptSecret(t, correctPassword, key))
+				access, data, err := b.IsAuthenticated(sessionID, authData)
+				require.NoError(t, err, "IsAuthenticated should not have returned an error")
+				require.Equal(t, broker.AuthNext, access, "a refused refresh should ask for re-authentication, data: %s", data)
+			}
+
+			updateAuthModes(t, b, sessionID, authmodes.DeviceQr)
+			access, data, err := b.IsAuthenticated(sessionID, "{}")
+			require.NoError(t, err, "IsAuthenticated should not have returned an error")
+			require.Equal(t, tc.wantAccess, access, "unexpected access after the device code, data: %s", data)
+
+			if tc.wantAccess == broker.AuthNext {
+				require.Equal(t, []string{authmodes.NewPassword}, b.GetNextAuthModes(sessionID),
+					"the device code login should be followed by defining a local password")
+			} else {
+				require.Contains(t, data, `"userinfo"`, "a granted login returns the user info")
+			}
+
+			if !tc.firstLogin {
+				passwordAfter, err := os.ReadFile(b.PasswordFilepathForSession(sessionID))
+				require.NoError(t, err, "the local password should still exist")
+				require.True(t, bytes.Equal(passwordBefore, passwordAfter), "the local password should be unchanged")
+			}
+		})
+	}
+}
