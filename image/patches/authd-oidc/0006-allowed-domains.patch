diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains.go b/authd-oidc-brokers/internal/broker/mastersos_domains.go
new file mode 100644
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_domains.go
@@ -0,0 +1,102 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch).
+//
+// authd registers a user (name, uid, groups in its database) as soon as the broker grants access, before PAM's account
+// stage runs, so a refusal there still leaves a local user behind. This patch lets the broker itself refuse accounts
+// outside the school's email domains, before access is granted: no authd user, no token cache.
+//
+// The domains are in a plain file beside the configuration, mastersos-allowed-domains in the directory of broker.conf
+// (/etc/authd/oidc/mastersos-allowed-domains), one domain per line; blank lines and lines starting with '#' are skipped,
+// ASCII case is ignored. It is deliberately not a key of broker.conf or broker.conf.d: a broker without this patch
+// refuses to start on an unknown key, while it never reads this file, so going back to an older image keeps the school's
+// sign-in working (with the older image's PAM check as its only domain check).
+//
+// No file: no domain filter, exactly as upstream. With the file (even an empty one), a user passes only when listed by
+// name in allowed_users (compared case-insensitively here, as the school's administrators are written in lower case) or
+// when the part of the user name after its last '@' equals one of the domains. ALL and OWNER in allowed_users apply only
+// to users who pass. The file is read once, when the broker starts; whoever changes it restarts the broker.
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// mastersosDomainsFile is the file's name, in the directory of broker.conf.
+const mastersosDomainsFile = "mastersos-allowed-domains"
+
+// mastersosLegacyDomainsKey is the [users] key an earlier version of this patch read (images built from 143866c7 until
+// this version). It is accepted, so that a drop-in still carrying it does not stop the broker until the agent rewrites
+// it, and otherwise ignored.
+const mastersosLegacyDomainsKey = "allowed_domains"
+
+// mastersosMaxDomainsFile caps what is read: the agent writes at most a few hundred short lines.
+const mastersosMaxDomainsFile = 1 << 20
+
+// mastersosDomainFilter is the content of the domain file; the zero value (no file) filters nothing.
+type mastersosDomainFilter struct {
+	active  bool
+	domains []string
+}
+
+func mastersosDomainsPath(cfgPath string) string {
+	return filepath.Join(filepath.Dir(cfgPath), mastersosDomainsFile)
+}
+
+// mastersosReadDomains reads the domain file. A missing file is no filter; a file that cannot be read is an error (the
+// broker does not start rather than let everyone through).
+func mastersosReadDomains(path string) (mastersosDomainFilter, error) {
+	content, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return mastersosDomainFilter{}, nil
+	}
+	if err != nil {
+		return mastersosDomainFilter{}, fmt.Errorf("could not read the allowed domains %q: %v", path, err)
+	}
+	if len(content) > mastersosMaxDomainsFile {
+		return mastersosDomainFilter{}, fmt.Errorf("the allowed domains %q are larger than %d bytes", path, mastersosMaxDomainsFile)
+	}
+	f := mastersosDomainFilter{active: true}
+	s := bufio.NewScanner(bytes.NewReader(content))
+	s.Buffer(make([]byte, 0, 4096), mastersosMaxDomainsFile)
+	for s.Scan() {
+		d := strings.ToLower(strings.TrimSpace(s.Text()))
+		if d != "" && !strings.HasPrefix(d, "#") {
+			f.domains = append(f.domains, d)
+		}
+	}
+	if err := s.Err(); err != nil {
+		return mastersosDomainFilter{}, fmt.Errorf("could not read the allowed domains %q: %v", path, err)
+	}
+	return f, nil
+}
+
+// mastersosAllowedByDomain reports whether userName passes the domain file: always without one; otherwise when it is listed
+// by name in allowed_users (in any ASCII case) or belongs to one of the domains. Only call this with the ownerMutex locked
+// (for reading).
+func (uc *userConfig) mastersosAllowedByDomain(userName string) bool {
+	if !uc.mastersosDomains.active {
+		return true
+	}
+	lower := strings.ToLower(userName)
+	if _, ok := uc.allowedUsers[lower]; ok {
+		return true
+	}
+	at := strings.LastIndexByte(lower, '@')
+	if at < 0 {
+		return false
+	}
+	domain := lower[at+1:]
+	for _, d := range uc.mastersosDomains.domains {
+		if d == domain {
+			return true
+		}
+	}
+	return false
+}
