+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch): the [users] allowed_domains key.
+
+import (
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+func mastersosParse(t *testing.T, users string) userConfig {
+	t.Helper()
+	main := configFile{path: "broker.conf", content: []byte("[oidc]\n\n[users]\nallowed_users = ALL\n")}
+	dropIn := configFile{
+		path:    "broker.conf.d/10-mastersos.conf",
+		content: []byte("[oidc]\nissuer = https://issuer.example\nclient_id = laptops\n\n[users]\n" + users),
+	}
+	uc, err := parseConfig(main, []configFile{dropIn}, &testutils.MockProvider{}, false)
+	require.NoError(t, err, "allowed_domains must be a known key: an unknown one stops the broker from starting")
+	return uc
+}
+
+// The agent's drop-in: the school's administrators by name, everyone else only from the school's domains.
+func TestMastersOSAllowedDomainsLimitAllUsers(t *testing.T) {
+	uc := mastersosParse(t, "allowed_users = ALL, it@vendor.example\nallowed_domains = school.example, Staff.School.Example\n")
+	require.Equal(t, []string{"school.example", "staff.school.example"}, uc.allowedDomains)
+
+	for name, want := range map[string]bool{
+		"ann@school.example":         true,
+		"bob@staff.school.example":   true,
+		"Ann@SCHOOL.example":         true,
+		"it@vendor.example":          true,
+		"IT@Vendor.example":          true,
+		"evil.test@school.example":   true,
+		"someone@gmail.com":          false,
+		"guardian@other.example":     false,
+		"x@sub.school.example":       false,
+		"x@school.example.evil.test": false,
+		"x@school.example@evil.test": false,
+		"school.example":             false,
+		"":                           false,
+	} {
+		require.Equal(t, want, uc.userNameIsAllowed(name), "%q", name)
+	}
+}
+
+// Without the key (an old drop-in, a school without allowed_domains) ALL means everyone, as upstream.
+func TestMastersOSNoAllowedDomainsKeepsAll(t *testing.T) {
+	for _, users := range []string{
+		"allowed_users = ALL\n",
+		"allowed_users = ALL\nallowed_domains =\n",
+		"allowed_users = ALL\nallowed_domains = , \n",
+	} {
+		uc := mastersosParse(t, users)
+		require.Empty(t, uc.allowedDomains, "%q", users)
+		require.True(t, uc.userNameIsAllowed("someone@gmail.com"), "%q", users)
+	}
+}
+
+// Without ALL only the listed users pass, whatever their domain.
+func TestMastersOSAllowedDomainsWithoutAll(t *testing.T) {
+	uc := mastersosParse(t, "allowed_users = it@vendor.example\nallowed_domains = school.example\n")
+	require.True(t, uc.userNameIsAllowed("it@vendor.example"))
+	require.False(t, uc.userNameIsAllowed("ann@school.example"), "a domain alone does not stand in for ALL")
+	require.False(t, uc.userNameIsAllowed("someone@gmail.com"))
+}
+
+func TestMastersOSAllowedDomainsSurviveClone(t *testing.T) {
+	uc := mastersosParse(t, "allowed_users = ALL\nallowed_domains = school.example\n")
+	c := cloneUserConfig(uc)
+	c.allowedDomains[0] = "other.example"
+	require.Equal(t, []string{"school.example"}, uc.allowedDomains)
+}
