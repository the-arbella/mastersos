@@ -0,0 +1,6 @@
+package broker
+
+// SetMastersOSAllowedDomains turns on the domain file of patch 0006 with these domains, for the broker tests.
+func (cfg *Config) SetMastersOSAllowedDomains(domains []string) {
+	cfg.mastersosDomains = mastersosDomainFilter{active: true, domains: domains}
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains_internal_test.go b/authd-oidc-brokers/internal/broker/mastersos_domains_internal_test.go
new file mode 100644
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_domains_internal_test.go
@@ -0,0 +1,146 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch): the school's domains, read from
+// mastersos-allowed-domains beside broker.conf, and the marker comment in the drop-in that makes the file required.
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+// The agent's drop-in for a school with domains: only keys and values any broker of this tag accepts, with or without
+// this patch, plus the marker, a comment to a broker without it.
+const mastersosDropIn = "# Generated by mastersos-agent\n" + mastersosRequiredMarker +
+	"\n[oidc]\nissuer = https://issuer.example\nclient_id = laptops\n\n[users]\nallowed_users = ALL, it@vendor.example\n"
+
+// The agent's drop-in for a school without domains: no marker.
+const mastersosDropInNoDomains = "[oidc]\nissuer = https://issuer.example\nclient_id = laptops\n\n[users]\nallowed_users = ALL\n"
+
+// mastersosLoad writes broker.conf, broker.conf.d/10-mastersos.conf and, unless domains is nil, the domain file, and
+// loads them the way the broker does when it starts.
+func mastersosLoad(t *testing.T, dropIn string, domains *string) Config {
+	t.Helper()
+	dir := t.TempDir()
+	cfgPath := filepath.Join(dir, "broker.conf")
+	require.NoError(t, os.WriteFile(cfgPath, []byte("[oidc]\n\n[users]\nallowed_users = ALL\n"), 0o600))
+	require.NoError(t, os.Mkdir(cfgPath+".d", 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(cfgPath+".d", "10-mastersos.conf"), []byte(dropIn), 0o600))
+	if domains != nil {
+		require.NoError(t, os.WriteFile(filepath.Join(dir, mastersosDomainsFile), []byte(*domains), 0o644))
+	}
+	cfg, err := loadBrokerConfig(Config{ConfigFile: cfgPath}, &testutils.MockProvider{})
+	require.NoError(t, err, "the drop-in must parse strictly: an unknown key stops the broker from starting")
+	return cfg
+}
+
+func ptr(s string) *string { return &s }
+
+// The drop-in parses as upstream; the domains come from the file: administrators by name, others only from the domains.
+func TestMastersOSAllowedDomainsLimitAllUsers(t *testing.T) {
+	cfg := mastersosLoad(t, mastersosDropIn, ptr("# written by mastersos-agent\nschool.example\r\n\n  Staff.School.Example  \n"))
+	require.True(t, cfg.allUsersAllowed)
+	require.Equal(t, []string{"school.example", "staff.school.example"}, cfg.mastersosDomains.domains)
+
+	for name, want := range map[string]bool{
+		"ann@school.example":         true,
+		"bob@staff.school.example":   true,
+		"Ann@SCHOOL.example":         true,
+		"it@vendor.example":          true,
+		"IT@Vendor.example":          true,
+		"evil.test@school.example":   true,
+		"someone@gmail.com":          false,
+		"guardian@other.example":     false,
+		"x@sub.school.example":       false,
+		"x@school.example.evil.test": false,
+		"x@school.example@evil.test": false,
+		"school.example":             false,
+		"":                           false,
+	} {
+		require.Equal(t, want, cfg.userNameIsAllowed(name), "%q", name)
+	}
+}
+
+// Neither file nor marker (a school without domains): ALL means everyone, as upstream.
+func TestMastersOSNoDomainFileKeepsAll(t *testing.T) {
+	cfg := mastersosLoad(t, mastersosDropInNoDomains, nil)
+	require.False(t, cfg.mastersosDomains.active)
+	require.True(t, cfg.userNameIsAllowed("someone@gmail.com"))
+}
+
+// The marker asks for the file and it is gone (deleted at runtime, never written): only the users listed by name pass.
+// ALL never becomes everyone because a file is missing.
+func TestMastersOSMissingRequiredFileFailsClosed(t *testing.T) {
+	cfg := mastersosLoad(t, mastersosDropIn, nil)
+	require.True(t, cfg.mastersosDomains.active)
+	require.True(t, cfg.userNameIsAllowed("it@vendor.example"))
+	require.False(t, cfg.userNameIsAllowed("ann@school.example"))
+	require.False(t, cfg.userNameIsAllowed("someone@gmail.com"))
+}
+
+// A file without any domain (every domain of the school was invalid) lets only the users listed by name through.
+func TestMastersOSEmptyDomainFileLetsOnlyListedUsers(t *testing.T) {
+	cfg := mastersosLoad(t, mastersosDropIn, ptr("# no valid domain\n\n"))
+	require.True(t, cfg.mastersosDomains.active)
+	require.True(t, cfg.userNameIsAllowed("it@vendor.example"))
+	require.False(t, cfg.userNameIsAllowed("ann@school.example"))
+}
+
+// A file that is there but cannot be read (or is too large) filters like an empty one, marker or not: never everyone.
+func TestMastersOSUnreadableDomainFileFailsClosed(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, mastersosDomainsFile)
+	require.NoError(t, os.Mkdir(path, 0o755))
+	require.Equal(t, mastersosDomainFilter{active: true}, mastersosReadDomains(path, false))
+
+	require.NoError(t, os.Remove(path))
+	require.NoError(t, os.WriteFile(path, make([]byte, mastersosMaxDomainsFile+1), 0o644))
+	require.Equal(t, mastersosDomainFilter{active: true}, mastersosReadDomains(path, false))
+}
+
+// The marker counts only as a whole line of a file in broker.conf.d.
+func TestMastersOSRequiredMarker(t *testing.T) {
+	dir := t.TempDir()
+	require.False(t, mastersosRequired(filepath.Join(dir, "absent")))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "10-mastersos.conf"), []byte("# mastersos: allowed domains\n[users]\n"), 0o600))
+	require.False(t, mastersosRequired(dir))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "20-other.conf"), []byte("[users]\n  "+mastersosRequiredMarker+"  \r\n"), 0o600))
+	require.True(t, mastersosRequired(dir))
+}
+
+// Without ALL only the listed users pass, whatever their domain.
+func TestMastersOSAllowedDomainsWithoutAll(t *testing.T) {
+	uc := userConfig{
+		allowedUsers:     map[string]struct{}{"it@vendor.example": {}},
+		mastersosDomains: mastersosDomainFilter{active: true, domains: []string{"school.example"}},
+	}
+	uc.ownerMutex = new(sync.RWMutex)
+	require.True(t, uc.userNameIsAllowed("it@vendor.example"))
+	require.False(t, uc.userNameIsAllowed("ann@school.example"), "a domain alone does not stand in for ALL")
+}
+
+func TestMastersOSAllowedDomainsSurviveClone(t *testing.T) {
+	uc := userConfig{mastersosDomains: mastersosDomainFilter{active: true, domains: []string{"school.example"}}}
+	c := cloneUserConfig(uc)
+	c.mastersosDomains.domains[0] = "other.example"
+	require.Equal(t, []string{"school.example"}, uc.mastersosDomains.domains)
+	require.True(t, c.mastersosDomains.active)
+}
+
+// A drop-in from the earlier version of the patch (allowed_domains in [users]) still starts the broker; the key does
+// nothing: only the file filters.
+func TestMastersOSLegacyDomainsKeyIsIgnored(t *testing.T) {
+	cfg := mastersosLoad(t, mastersosDropInNoDomains+"allowed_domains = school.example\n", nil)
+	require.False(t, cfg.mastersosDomains.active)
+	require.True(t, cfg.userNameIsAllowed("someone@gmail.com"))
+}
+
+// The file sits beside broker.conf, outside broker.conf.d: a broker without this patch never reads it.
+func TestMastersOSDomainFileIsOutsideTheConfig(t *testing.T) {
+	require.Equal(t, "/etc/authd/oidc/mastersos-allowed-domains", mastersosDomainsPath("/etc/authd/oidc/broker.conf"))
+	require.NotEqual(t, GetDropInDir("/etc/authd/oidc/broker.conf"), filepath.Dir(mastersosDomainsPath("/etc/authd/oidc/broker.conf")))
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains_test.go b/authd-oidc-brokers/internal/broker/mastersos_domains_test.go
