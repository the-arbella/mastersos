diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains.go b/authd-oidc-brokers/internal/broker/mastersos_domains.go
new file mode 100644
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_domains.go
@@ -0,0 +1,150 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch).
+//
+// authd registers a user (name, uid, groups in its database) as soon as the broker grants access, before PAM's account
+// stage runs, so a refusal there still leaves a local user behind. This patch lets the broker itself refuse accounts
+// outside the school's email domains, before access is granted: no authd user, no token cache.
+//
+// The domains are in a plain file beside the configuration, mastersos-allowed-domains in the directory of broker.conf
+// (/etc/authd/oidc/mastersos-allowed-domains), one domain per line; blank lines and lines starting with '#' are skipped,
+// ASCII case is ignored. It is deliberately not a key of broker.conf or broker.conf.d: a broker without this patch
+// refuses to start on an unknown key, while it never reads this file, so going back to an older image keeps the school's
+// sign-in working (with the older image's PAM check as its only domain check).
+//
+// Whether the file must be there is said by the drop-in that grants ALL, in a comment line (mastersosRequiredMarker): a
+// broker without this patch reads it as a comment, so the drop-in still starts it; this one then refuses everyone not
+// listed by name in allowed_users while the file is missing or unreadable. The file going away, or not being written,
+// never turns ALL into everyone.
+//
+// The filter is on when the file is there or the marker asks for it. Then a user passes only when listed by name in
+// allowed_users (compared case-insensitively here, as the school's administrators are written in lower case) or when the
+// part of the user name after its last '@' equals one of the domains read from the file. ALL and OWNER in allowed_users
+// apply only to users who pass. With neither file nor marker nothing changes, exactly as upstream. The file and the marker
+// are read once, when the broker starts; whoever changes them restarts the broker.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/canonical/authd/log"
+)
+
+// mastersosDomainsFile is the file's name, in the directory of broker.conf.
+const mastersosDomainsFile = "mastersos-allowed-domains"
+
+// mastersosRequiredMarker, a whole line of a broker.conf.d file, says the domain file must be there.
+const mastersosRequiredMarker = "# mastersos: allowed domains required (patch 0006)"
+
+// mastersosLegacyDomainsKey is the [users] key an earlier version of this patch read (images built from 143866c7 until
+// this version). It is accepted, so that a drop-in still carrying it does not stop the broker until the agent rewrites
+// it, and otherwise ignored.
+const mastersosLegacyDomainsKey = "allowed_domains"
+
+// mastersosMaxDomainsFile caps what is read: the agent writes at most a few hundred short lines.
+const mastersosMaxDomainsFile = 1 << 20
+
+// mastersosDomainFilter is the content of the domain file; the zero value (no file, no marker) filters nothing.
+type mastersosDomainFilter struct {
+	active  bool
+	domains []string
+}
+
+func mastersosDomainsPath(cfgPath string) string {
+	return filepath.Join(filepath.Dir(cfgPath), mastersosDomainsFile)
+}
+
+// mastersosRequired reports whether any file in the drop-in directory carries mastersosRequiredMarker. The broker has
+// already parsed every one of them, so a directory that cannot be read here counts as requiring the file.
+func mastersosRequired(dropInDir string) bool {
+	entries, err := os.ReadDir(dropInDir)
+	if errors.Is(err, fs.ErrNotExist) {
+		return false
+	}
+	if err != nil {
+		return true
+	}
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		content, err := os.ReadFile(filepath.Join(dropInDir, e.Name()))
+		if err != nil {
+			return true
+		}
+		for _, line := range strings.Split(string(content), "\n") {
+			if strings.TrimSpace(line) == mastersosRequiredMarker {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// mastersosReadDomains reads the domain file. Missing: the filter is on (with no domain) only when required. There but
+// unreadable or too large: on, with no domain, so only the users listed by name pass (never everyone).
+func mastersosReadDomains(path string, required bool) mastersosDomainFilter {
+	content, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		if required {
+			log.Warningf(context.Background(), "%s is missing but required: only the users named in allowed_users may sign in", path)
+		}
+		return mastersosDomainFilter{active: required}
+	}
+	if err == nil && len(content) > mastersosMaxDomainsFile {
+		err = errors.New("too large")
+	}
+	if err != nil {
+		log.Warningf(context.Background(), "could not read %s (%v): only the users named in allowed_users may sign in", path, err)
+		return mastersosDomainFilter{active: true}
+	}
+	f := mastersosDomainFilter{active: true}
+	s := bufio.NewScanner(bytes.NewReader(content))
+	s.Buffer(make([]byte, 0, 4096), mastersosMaxDomainsFile)
+	for s.Scan() {
+		d := strings.ToLower(strings.TrimSpace(s.Text()))
+		if d != "" && !strings.HasPrefix(d, "#") {
+			f.domains = append(f.domains, d)
+		}
+	}
+	if err := s.Err(); err != nil {
+		log.Warningf(context.Background(), "could not read %s (%v): only the users named in allowed_users may sign in", path, err)
+		return mastersosDomainFilter{active: true}
+	}
+	return f
+}
+
+// mastersosLoadDomains is what the broker reads at start: the marker in broker.conf.d, then the domain file.
+func mastersosLoadDomains(cfgPath string) mastersosDomainFilter {
+	return mastersosReadDomains(mastersosDomainsPath(cfgPath), mastersosRequired(GetDropInDir(cfgPath)))
+}
+
+// mastersosAllowedByDomain reports whether userName passes the domain filter: always when it is off; otherwise when it is
+// listed by name in allowed_users (in any ASCII case) or belongs to one of the domains. Only call this with the ownerMutex
+// locked (for reading).
+func (uc *userConfig) mastersosAllowedByDomain(userName string) bool {
+	if !uc.mastersosDomains.active {
+		return true
+	}
+	lower := strings.ToLower(userName)
+	if _, ok := uc.allowedUsers[lower]; ok {
+		return true
+	}
+	at := strings.LastIndexByte(lower, '@')
+	if at < 0 {
+		return false
+	}
+	domain := lower[at+1:]
+	for _, d := range uc.mastersosDomains.domains {
+		if d == domain {
+			return true
+		}
+	}
+	return false
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains_export_test.go b/authd-oidc-brokers/internal/broker/mastersos_domains_export_test.go
