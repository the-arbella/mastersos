+++ b/authd-oidc-brokers/internal/broker/mastersos_domains_test.go
@@ -0,0 +1,60 @@
+package broker_test
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch): a user outside the school's domain file is denied
+// before access is granted, so authd never registers them. Not parallel: these tests set the process environment.
+
+import (
+	"os"
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker/authmodes"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+func domainsBroker(t *testing.T, email string, domains []string) *broker.Broker {
+	t.Helper()
+	cfg := &brokerForTestConfig{
+		Config:                 broker.Config{DataDir: t.TempDir()},
+		allUsersAllowed:        true,
+		supportsFetchingGroups: true,
+		listenAddress:          cardOnlyAddress,
+		customHandlers: map[string]testutils.EndpointHandler{
+			"/token": testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+				IDTokenClaims: []map[string]interface{}{{"sub": "user-id", "email": email}},
+			}),
+		},
+	}
+	cfg.SetMastersOSAllowedDomains(domains)
+	return newBrokerForTests(t, cfg)
+}
+
+func TestMastersOSOtherDomainIsDeniedBeforeGrant(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := domainsBroker(t, "someone@gmail.com", []string{"school.example", "staff.school.example"})
+
+	sessionID, _ := newSessionForTests(t, b, "someone@gmail.com", "")
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	signInOnCard(t, b, sessionID)
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthDenied, access, "data: %s", data)
+	require.Contains(t, data, "not allowed in broker configuration", "the login screen matches this text for its refusal")
+	require.NotContains(t, data, "userinfo", "a denied login hands authd no user to register")
+	_, statErr := os.Stat(b.TokenPathForSession(sessionID))
+	require.ErrorIs(t, statErr, os.ErrNotExist, "a refused login must not leave a token")
+}
+
+func TestMastersOSSchoolDomainIsGranted(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := domainsBroker(t, "teacher@staff.school.example", []string{"school.example", "staff.school.example"})
+
+	sessionID, _ := newSessionForTests(t, b, "teacher@staff.school.example", "")
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	signInOnCard(t, b, sessionID)
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+	require.Contains(t, data, "teacher@staff.school.example")
+}
