diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains.go b/authd-oidc-brokers/internal/broker/mastersos_domains.go
new file mode 100644
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_domains.go
@@ -0,0 +1,54 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0006-allowed-domains.patch).
+//
+// [users] allowed_domains = school.ac.th, staff.school.ac.th limits who the broker lets through to the school's email
+// domains. authd registers a user (name, uid, groups in its database) as soon as the broker grants access, before PAM's
+// account stage runs, so a refusal there still leaves a local user behind. Refusing here, before access is granted,
+// leaves nothing: no authd user and no token cache.
+//
+// A user passes when listed by name in allowed_users (compared case-insensitively here, as the school's administrators
+// are written in lower case), or when the part after the last '@' of the user name equals one of the domains (ASCII case
+// is ignored). Everything else in allowed_users (ALL, OWNER) applies only to users who pass this check. Without the key,
+// or with an empty value, nothing changes.
+
+import (
+	"strings"
+
+	"gopkg.in/ini.v1"
+)
+
+// mastersosAllowedDomainsKey is the key in the [users] section.
+const mastersosAllowedDomainsKey = "allowed_domains"
+
+// mastersosParseDomains reads allowed_domains: comma separated, trimmed, lower case, empty entries dropped.
+func mastersosParseDomains(users *ini.Section) []string {
+	var out []string
+	for _, d := range users.Key(mastersosAllowedDomainsKey).Strings(",") {
+		d = strings.ToLower(strings.TrimSpace(d))
+		if d != "" {
+			out = append(out, d)
+		}
+	}
+	return out
+}
+
+// mastersosAllowedByDomain reports whether userName is listed by name (in any ASCII case) or belongs to one of the
+// allowed domains. Only call this with the ownerMutex locked (for reading).
+func (uc *userConfig) mastersosAllowedByDomain(userName string) bool {
+	lower := strings.ToLower(userName)
+	if _, ok := uc.allowedUsers[lower]; ok {
+		return true
+	}
+	at := strings.LastIndexByte(lower, '@')
+	if at < 0 {
+		return false
+	}
+	domain := lower[at+1:]
+	for _, d := range uc.allowedDomains {
+		if d == domain {
+			return true
+		}
+	}
+	return false
+}
