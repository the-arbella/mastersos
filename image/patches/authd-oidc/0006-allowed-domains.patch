+package broker
+
+// SetMastersOSAllowedDomains sets the [users] allowed_domains of patch 0006 for the broker tests.
+func (cfg *Config) SetMastersOSAllowedDomains(domains []string) {
+	cfg.allowedDomains = domains
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_domains_internal_test.go b/authd-oidc-brokers/internal/broker/mastersos_domains_internal_test.go
