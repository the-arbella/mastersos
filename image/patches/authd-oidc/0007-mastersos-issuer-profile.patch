+// A login_name of the wrong shape never becomes a user name (nor, later, a file name).
+func TestMastersOSBadLoginNameIsDenied(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, loginName := range map[string]interface{}{
+		"upper case":          "Alice@school.example",
+		"slash":               "a/b@school.example",
+		"two at signs":        "a@b@c",
+		"empty":               "",
+		"local part too long": strings.Repeat("a", 65) + "@school.example",
+		"no at sign":          "alice",
+		"empty domain":        "alice@",
+		"empty local part":    "@school.example",
+		"not a string":        42,
+		"missing":             nil,
+	} {
+		t.Run(name, func(t *testing.T) {
+			claims := withEmail(schoolClaims(""))
+			if loginName == nil {
+				delete(claims, "login_name")
+			} else {
+				claims["login_name"] = loginName
+			}
+			b := profileBroker(t, claims, withProfile(mastersosOrg))
+
+			sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+			access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+			requireDeniedBeforeGrant(t, b, sessionID, access, data)
+			require.Contains(t, data, "no valid login name", "the shape refuses it, before the requested name is compared")
+		})
+	}
+}
