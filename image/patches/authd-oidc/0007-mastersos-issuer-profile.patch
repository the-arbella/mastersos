+++ b/authd-oidc-brokers/internal/broker/mastersos_profile_export_test.go
@@ -0,0 +1,19 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the helpers its broker tests reach.
+
+// SetMastersOSProfile turns on the issuer profile of patch 0007 with this expected organisation ("" denies every login).
+func (cfg *Config) SetMastersOSProfile(org string) {
+	cfg.mastersosProfile = mastersosProfile{active: true, org: org}
+}
+
+// LoadMastersOSProfile reads the profile the way the broker does at start, for a broker.conf at cfgPath.
+func (cfg *Config) LoadMastersOSProfile(cfgPath string) {
+	cfg.mastersosProfile = mastersosLoadProfile(cfgPath)
+}
+
+// MastersOSExpectedOrgFile and MastersOSProfileMarker are the file name and the drop-in marker line.
+const (
+	MastersOSExpectedOrgFile = mastersosExpectedOrgFile
+	MastersOSProfileMarker   = mastersosProfileMarker
+)
diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile_internal_test.go b/authd-oidc-brokers/internal/broker/mastersos_profile_internal_test.go
new file mode 100644
index 0000000..ad1030c
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_profile_internal_test.go
@@ -0,0 +1,174 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the expected-org file beside
+// broker.conf, the marker that makes it required, the scopes, and the shape of login_name.
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+const testOrg = "0193abcd-ef01-7000-8000-00000000a001"
+
+// profileLoad writes broker.conf, a drop-in (with the marker when marked) and, unless org is nil, the expected-org file,
+// then loads them the way the broker does when it starts.
+func profileLoad(t *testing.T, marked bool, org *string) Config {
+	t.Helper()
+	dir := t.TempDir()
+	cfgPath := filepath.Join(dir, "broker.conf")
+	require.NoError(t, os.WriteFile(cfgPath, []byte("[oidc]\n\n[users]\nallowed_users = ALL\n"), 0o600))
+	require.NoError(t, os.Mkdir(cfgPath+".d", 0o700))
+	dropIn := "# Generated by mastersos-agent\n[oidc]\nissuer = https://issuer.example\nclient_id = laptops\n"
+	if marked {
+		dropIn = "# Generated by mastersos-agent\n" + mastersosProfileMarker + "\n[oidc]\nissuer = https://issuer.example\nclient_id = laptops\n"
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(cfgPath+".d", "10-mastersos.conf"), []byte(dropIn), 0o600))
+	if org != nil {
+		require.NoError(t, os.WriteFile(filepath.Join(dir, mastersosExpectedOrgFile), []byte(*org), 0o644))
+	}
+	cfg, err := loadBrokerConfig(Config{ConfigFile: cfgPath}, &testutils.MockProvider{})
+	require.NoError(t, err, "the drop-in with the marker must parse strictly: the marker is a comment")
+	return cfg
+}
+
+func TestMastersOSProfileOffWithoutFileAndMarker(t *testing.T) {
+	cfg := profileLoad(t, false, nil)
+	require.Equal(t, mastersosProfile{}, cfg.mastersosProfile)
+	require.Nil(t, mastersosScopes(cfg.mastersosProfile))
+}
+
+func TestMastersOSProfileReadsTheExpectedOrg(t *testing.T) {
+	for name, content := range map[string]string{
+		"bare":                testOrg,
+		"newline":             testOrg + "\n",
+		"comments and blanks": "# written by mastersos-agent\n\n  " + testOrg + "  \r\n# end\n",
+	} {
+		for _, marked := range []bool{true, false} {
+			cfg := profileLoad(t, marked, &content)
+			require.Equal(t, mastersosProfile{active: true, org: testOrg}, cfg.mastersosProfile, "%s, marked %v", name, marked)
+		}
+	}
+}
+
+// Marker without a usable file, or a file that is there but unusable: on, with no organisation, so everyone is denied.
+func TestMastersOSProfileFailsClosed(t *testing.T) {
+	require.Equal(t, mastersosProfile{active: true}, profileLoad(t, true, nil).mastersosProfile, "marker, no file")
+	for name, content := range map[string]string{
+		"empty":         "",
+		"only comments": "# no school id\n",
+		"upper case":    strings.ToUpper(testOrg),
+		"two ids":       testOrg + "\n" + testOrg + "\n",
+		"trailing text": testOrg + " x",
+		"short":         testOrg[:35],
+		"not hex":       "0193abcg-ef01-7000-8000-00000000a001",
+		"no dashes":     strings.ReplaceAll(testOrg, "-", "") + "1234",
+		"braces":        "{" + testOrg + "}",
+		"too large":     "#" + strings.Repeat(" ", mastersosMaxExpectedOrgFile) + "\n" + testOrg,
+	} {
+		require.Equal(t, mastersosProfile{active: true}, profileLoad(t, true, &content).mastersosProfile, name)
+		require.Equal(t, mastersosProfile{active: true}, profileLoad(t, false, &content).mastersosProfile, "%s without the marker", name)
+	}
+
+	path := filepath.Join(t.TempDir(), mastersosExpectedOrgFile)
+	require.NoError(t, os.Mkdir(path, 0o755))
+	require.Equal(t, mastersosProfile{active: true}, mastersosReadProfile(path, false), "unreadable")
+}
+
+func TestMastersOSProfileMarkerIsAWholeLine(t *testing.T) {
+	dir := t.TempDir()
+	require.False(t, mastersosProfileRequired(filepath.Join(dir, "absent")))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "10-mastersos.conf"), []byte("# mastersos: issuer profile\n"+mastersosRequiredMarker+"\n"), 0o600))
+	require.False(t, mastersosProfileRequired(dir), "patch 0006's marker is not this one")
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "20-other.conf"), []byte("[oidc]\n  "+mastersosProfileMarker+"  \r\n"), 0o600))
+	require.True(t, mastersosProfileRequired(dir))
+}
+
+func TestMastersOSExpectedOrgFileIsOutsideTheConfig(t *testing.T) {
+	require.Equal(t, "/etc/authd/oidc/mastersos-expected-org", mastersosExpectedOrgPath("/etc/authd/oidc/broker.conf"))
+}
+
+func TestMastersOSScopes(t *testing.T) {
+	require.Equal(t, []string{"mastersos.facts", "org:" + testOrg}, mastersosScopes(mastersosProfile{active: true, org: testOrg}))
+	require.Nil(t, mastersosScopes(mastersosProfile{}))
+	require.Nil(t, mastersosScopes(mastersosProfile{active: true}), "no organisation to ask for: the login is denied anyway")
+}
+
+func TestMastersOSLoginNameShape(t *testing.T) {
+	for name, want := range map[string]bool{
+		"alice@school.example":                      true,
+		"a.b_c-d9@sub.school.example":               true,
+		strings.Repeat("a", 64) + "@school.example": true,
+		"a@" + strings.Repeat("b", 253):             true,
+		strings.Repeat("a", 65) + "@school.example": false,
+		"a@" + strings.Repeat("b", 254):             false,
+		"Alice@school.example":                      false,
+		"alice@School.example":                      false,
+		"a/b@school.example":                        false,
+		"alice@school/example":                      false,
+		"a@b@c":                                     false,
+		"alice":                                     false,
+		"":                                          false,
+		"@school.example":                           false,
+		"alice@":                                    false,
+		"al ice@school.example":                     false,
+		"alice@school.example\n":                    false,
+		"alice@school_example":                      false,
+		"ålice@school.example":                      false,
+		"alice@school.example\x00":                  false,
+	} {
+		require.Equal(t, want, mastersosLoginNameValid(name), "%q", name)
+	}
+}
+
+// claimsMap stands in for a verified ID token.
+type claimsMap map[string]interface{}
+
+func (c claimsMap) Claims(v any) error {
+	b, err := json.Marshal(c)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(b, v)
+}
+
+func TestMastersOSUserInfoFromClaims(t *testing.T) {
+	p := mastersosProfile{active: true, org: testOrg}
+	u, c, err := mastersosUserInfoFromClaims(p, claimsMap{
+		"sub": "alice-id", "org": testOrg, "login_name": "alice@school.example",
+		"email": "other@elsewhere.example", "name": "Alice", "home": "/home/alice", "shell": "/bin/sh",
+	})
+	require.NoError(t, err)
+	require.Equal(t, "alice@school.example", u.Name, "login_name, never email")
+	require.Equal(t, "alice-id", u.ProviderID)
+	require.Equal(t, "Alice", u.Gecos)
+	require.Equal(t, "/home/alice", u.Home)
+	require.Equal(t, "/bin/sh", u.Shell)
+	require.Equal(t, mastersosIDClaims{Sub: "alice-id", Org: testOrg, LoginName: "alice@school.example"}, c)
+
+	u, _, err = mastersosUserInfoFromClaims(p, claimsMap{"sub": "alice-id", "org": testOrg, "login_name": "alice@school.example"})
+	require.NoError(t, err)
+	require.Equal(t, "alice@school.example", u.Home, "the broker puts it under its home base directory, as for email names")
+	require.Equal(t, "/usr/bin/bash", u.Shell)
+
+	for name, tc := range map[string]struct {
+		p      mastersosProfile
+		claims claimsMap
+		want   string
+	}{
+		"no expected org": {mastersosProfile{active: true}, claimsMap{"sub": "s", "org": testOrg, "login_name": "a@b"}, "not set up"},
+		"other org":       {p, claimsMap{"sub": "s", "org": "x", "login_name": "a@b"}, "not a member of this school"},
+		"no org":          {p, claimsMap{"sub": "s", "login_name": "a@b"}, "not a member of this school"},
+		"no sub":          {p, claimsMap{"org": testOrg, "login_name": "a@b"}, "sub"},
+		"bad login_name":  {p, claimsMap{"sub": "s", "org": testOrg, "login_name": "A@b"}, "login name"},
+		"no login_name":   {p, claimsMap{"sub": "s", "org": testOrg}, "login name"},
+	} {
+		_, _, err := mastersosUserInfoFromClaims(tc.p, tc.claims)
+		require.ErrorContains(t, err, tc.want, name)
+	}
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile_test.go b/authd-oidc-brokers/internal/broker/mastersos_profile_test.go
new file mode 100644
index 0000000..b7b137c
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_profile_test.go
@@ -0,0 +1,303 @@
+package broker_test
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): with the school's issuer
+// profile on, the local user name is the ID token's login_name, the request asks for the school's organisation and the
+// facts scope, and an account of another organisation is denied before access is granted, so authd registers nobody.
+// Not parallel: these tests set the process environment and share the card's fixed ports.
+
+import (
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker/authmodes"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+const (
+	mastersosOrg      = "0193abcd-ef01-7000-8000-00000000a001"
+	mastersosOtherOrg = "0193abcd-ef01-7000-8000-00000000a002"
+)
+
+// profileBroker is a card-only broker whose provider issues one ID token with these claims. Unless the claims carry an
+// email (withEmail), the token has neither email nor email_verified: the issuer profile needs neither. setup turns the
+// profile on (or leaves it off).
+func profileBroker(t *testing.T, claims map[string]interface{}, setup func(cfg *brokerForTestConfig)) *broker.Broker {
+	t.Helper()
+	var deleted []string
+	if _, ok := claims["email"]; !ok {
+		deleted = []string{"email", "email_verified"}
+	}
+	cfg := &brokerForTestConfig{
+		Config:                 broker.Config{DataDir: t.TempDir()},
+		allUsersAllowed:        true,
+		supportsFetchingGroups: true,
+		listenAddress:          cardOnlyAddress,
+		customHandlers: map[string]testutils.EndpointHandler{
+			"/token": testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+				IDTokenClaims: []map[string]interface{}{claims},
+				DeleteClaims:  deleted,
+			}),
+		},
+	}
+	if setup != nil {
+		setup(cfg)
+	}
+	return newBrokerForTests(t, cfg)
+}
+
+// schoolClaims are the claims of a member of mastersosOrg.
+func schoolClaims(loginName string) map[string]interface{} {
+	return map[string]interface{}{"sub": "alice-id", "org": mastersosOrg, "login_name": loginName}
+}
+
+// withEmail adds a verified email equal to the requested name: a broker that fell back to email names would grant this
+// token, so a denial test using it proves the profile, not a missing email, refused the login.
+func withEmail(claims map[string]interface{}) map[string]interface{} {
+	claims["email"] = "alice@school.example"
+	claims["email_verified"] = true
+	return claims
+}
+
+func withProfile(org string) func(cfg *brokerForTestConfig) {
+	return func(cfg *brokerForTestConfig) { cfg.SetMastersOSProfile(org) }
+}
+
+// cardURL selects the web mode and returns the school's page the card would open, without signing in.
+func cardURL(t *testing.T, b *broker.Broker, sessionID string) *url.URL {
+	t.Helper()
+	requireAuthModes(t, b, sessionID, authmodes.DeviceQr)
+	require.NoError(t, b.SetAvailableMode(sessionID, authmodes.DeviceQr))
+	layout, err := b.SelectAuthenticationMode(sessionID, authmodes.DeviceQr)
+	require.NoError(t, err, "selecting the web mode should start the sign-in")
+	u, err := url.Parse(layout["content"])
+	require.NoError(t, err)
+	return u
+}
+
+// finishOnCard plays the browser coming back from the page at u, and returns what the broker answers.
+func finishOnCard(t *testing.T, b *broker.Broker, sessionID string, u *url.URL) (string, string) {
+	t.Helper()
+	res, err := http.Get("http://127.0.0.1:48123/callback?code=c&state=" + u.Query().Get("state"))
+	require.NoError(t, err)
+	require.NoError(t, res.Body.Close())
+	require.Equal(t, http.StatusOK, res.StatusCode)
+	access, data, err := b.IsAuthenticated(sessionID, "{}")
+	require.NoError(t, err)
+	return access, data
+}
+
+// requireDeniedBeforeGrant checks a refusal that leaves authd nothing to register and no token behind.
+func requireDeniedBeforeGrant(t *testing.T, b *broker.Broker, sessionID, access, data string) {
+	t.Helper()
+	require.Equal(t, broker.AuthDenied, access, "data: %s", data)
+	require.NotContains(t, data, "userinfo", "a denied login hands authd no user to register")
+	_, statErr := os.Stat(b.TokenPathForSession(sessionID))
+	require.ErrorIs(t, statErr, os.ErrNotExist, "a refused login must not leave a token")
+}
+
+func scopesOf(u *url.URL) []string {
+	return strings.Fields(u.Query().Get("scope"))
+}
+
+// Without the profile nothing changes: the name is the email, and the request asks for nothing of the school's.
+func TestMastersOSNoProfileKeepsEmailNames(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := newBrokerForTests(t, &brokerForTestConfig{
+		Config:                 broker.Config{DataDir: t.TempDir()},
+		allUsersAllowed:        true,
+		supportsFetchingGroups: true,
+		listenAddress:          cardOnlyAddress,
+		customHandlers: map[string]testutils.EndpointHandler{
+			"/token": testutils.TokenHandler("http://"+cardOnlyAddress, &testutils.TokenHandlerOptions{
+				IDTokenClaims: []map[string]interface{}{{"sub": "user-id", "login_name": "alice@school.example", "org": mastersosOrg}},
+			}),
+		},
+	})
+
+	sessionID, _ := newSessionForTests(t, b, "test-user@email.com", "")
+	u := cardURL(t, b, sessionID)
+	for _, s := range scopesOf(u) {
+		require.NotEqual(t, "mastersos.facts", s)
+		require.False(t, strings.HasPrefix(s, "org:"), "scope %q", s)
+	}
+	access, data := finishOnCard(t, b, sessionID, u)
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+	require.Contains(t, data, "test-user@email.com")
+	require.NotContains(t, data, "alice@school.example", "login_name means nothing without the profile")
+}
+
+// The profile takes the user name from login_name, with no email and no email_verified in the token. The domain filter
+// of patch 0006 checks that name.
+func TestMastersOSLoginNameIsTheUserName(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := profileBroker(t, schoolClaims("alice@school.example"), func(cfg *brokerForTestConfig) {
+		cfg.SetMastersOSProfile(mastersosOrg)
+		cfg.SetMastersOSAllowedDomains([]string{"school.example"})
+	})
+
+	sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+	access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+	require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+	require.Contains(t, data, `"name":"alice@school.example"`)
+	require.Contains(t, data, "alice-id")
+}
+
+// The request asks for the facts and for the school's organisation; the login hint stays the requested name.
+func TestMastersOSScopesCarryTheOrganisation(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := profileBroker(t, schoolClaims("alice@school.example"), withProfile(mastersosOrg))
+
+	sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+	u := cardURL(t, b, sessionID)
+	scopes := scopesOf(u)
+	require.Contains(t, scopes, "openid")
+	require.Contains(t, scopes, "mastersos.facts")
+	require.Contains(t, scopes, "org:"+mastersosOrg)
+	require.Equal(t, "alice@school.example", u.Query().Get("login_hint"))
+	b.CancelIsAuthenticated(sessionID)
+}
+
+func TestMastersOSOtherOrganisationIsDeniedBeforeGrant(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, org := range map[string]interface{}{
+		"another organisation": mastersosOtherOrg,
+		"no org claim":         nil,
+		"org not a string":     42,
+		"org in another case":  strings.ToUpper(mastersosOrg),
+	} {
+		t.Run(name, func(t *testing.T) {
+			claims := withEmail(schoolClaims("alice@school.example"))
+			if org == nil {
+				delete(claims, "org")
+			} else {
+				claims["org"] = org
+			}
+			b := profileBroker(t, claims, withProfile(mastersosOrg))
+
+			sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+			access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+			requireDeniedBeforeGrant(t, b, sessionID, access, data)
+			require.Contains(t, data, "not a member of this school")
+		})
+	}
+}
+
+// The drop-in says the profile is on, and the expected organisation cannot be known: everyone is denied, and nobody
+// falls back to email names.
+func TestMastersOSMissingExpectedOrgDeniesEveryone(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, write := range map[string]func(t *testing.T, path string){
+		"file absent":        func(*testing.T, string) {},
+		"file unreadable":    func(t *testing.T, path string) { require.NoError(t, os.Mkdir(path, 0o755)) },
+		"file empty":         writeFile(""),
+		"only comments":      writeFile("# written by mastersos-agent\n# no school id\n\n"),
+		"not a uuid":         writeFile("school\n"),
+		"upper case uuid":    writeFile(strings.ToUpper(mastersosOrg) + "\n"),
+		"two uuids":          writeFile(mastersosOrg + "\n" + mastersosOtherOrg + "\n"),
+		"uuid with trailing": writeFile(mastersosOrg + " x\n"),
+		"too large":          writeFile("# " + strings.Repeat("x", 4096) + "\n" + mastersosOrg + "\n"),
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			cfgPath := filepath.Join(dir, "broker.conf")
+			require.NoError(t, os.Mkdir(cfgPath+".d", 0o700))
+			require.NoError(t, os.WriteFile(filepath.Join(cfgPath+".d", "10-mastersos.conf"),
+				[]byte("# Generated by mastersos-agent\n"+broker.MastersOSProfileMarker+"\n[users]\nallowed_users = ALL\n"), 0o600))
+			write(t, filepath.Join(dir, broker.MastersOSExpectedOrgFile))
+
+			b := profileBroker(t, withEmail(schoolClaims("alice@school.example")), func(cfg *brokerForTestConfig) {
+				cfg.LoadMastersOSProfile(cfgPath)
+			})
+			sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+			access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+			requireDeniedBeforeGrant(t, b, sessionID, access, data)
+			require.Contains(t, data, "not set up on this device", "the profile refused it, not a missing email")
+		})
+	}
+
+	// The token above is one an email-name broker grants: so none of the denials can come from falling back to email.
+	t.Run("same token granted without the profile", func(t *testing.T) {
+		b := profileBroker(t, withEmail(schoolClaims("alice@school.example")), nil)
+		sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+		access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+		require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+		require.Contains(t, data, `"name":"alice@school.example"`)
+	})
+
+	// The same layout with a good file signs in: the denials above come from the file, not from the setup.
+	t.Run("good file", func(t *testing.T) {
+		dir := t.TempDir()
+		cfgPath := filepath.Join(dir, "broker.conf")
+		require.NoError(t, os.Mkdir(cfgPath+".d", 0o700))
+		require.NoError(t, os.WriteFile(filepath.Join(cfgPath+".d", "10-mastersos.conf"),
+			[]byte(broker.MastersOSProfileMarker+"\n"), 0o600))
+		writeFile("# written by mastersos-agent\n"+mastersosOrg+"\n")(t, filepath.Join(dir, broker.MastersOSExpectedOrgFile))
+
+		b := profileBroker(t, schoolClaims("alice@school.example"), func(cfg *brokerForTestConfig) {
+			cfg.LoadMastersOSProfile(cfgPath)
+		})
+		sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+		access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+		require.Equal(t, broker.AuthGranted, access, "data: %s", data)
+		require.Contains(t, data, `"name":"alice@school.example"`)
+	})
+}
+
+func writeFile(content string) func(t *testing.T, path string) {
+	return func(t *testing.T, path string) {
+		t.Helper()
+		require.NoError(t, os.WriteFile(path, []byte(content), 0o644))
+	}
+}
+
+// A login_name of the wrong shape never becomes a user name (nor, later, a file name).
+func TestMastersOSBadLoginNameIsDenied(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, loginName := range map[string]interface{}{
+		"upper case":          "Alice@school.example",
+		"slash":               "a/b@school.example",
+		"two at signs":        "a@b@c",
+		"empty":               "",
+		"local part too long": strings.Repeat("a", 65) + "@school.example",
+		"no at sign":          "alice",
+		"empty domain":        "alice@",
+		"empty local part":    "@school.example",
+		"not a string":        42,
+		"missing":             nil,
+	} {
+		t.Run(name, func(t *testing.T) {
+			claims := withEmail(schoolClaims(""))
+			if loginName == nil {
+				delete(claims, "login_name")
+			} else {
+				claims["login_name"] = loginName
+			}
+			b := profileBroker(t, claims, withProfile(mastersosOrg))
+
+			sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+			access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+			requireDeniedBeforeGrant(t, b, sessionID, access, data)
+			require.Contains(t, data, "no valid login name", "the shape refuses it, before the requested name is compared")
+		})
+	}
+}
+
+// The school's page signed in another person than the one picked on the greeter: upstream's refusal, which the login
+// screen's refusalKind matches, comparing login_name.
+func TestMastersOSWrongAccountComparesLoginName(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := profileBroker(t, schoolClaims("alice@school.example"), withProfile(mastersosOrg))
+
+	sessionID, _ := newSessionForTests(t, b, "bob@school.example", "")
+	access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+	requireDeniedBeforeGrant(t, b, sessionID, access, data)
+	require.Contains(t, data, "does not match the authenticated user", "the login screen matches this text for its refusal")
+	require.Contains(t, data, "bob@school.example")
+	require.Contains(t, data, "alice@school.example")
+}
