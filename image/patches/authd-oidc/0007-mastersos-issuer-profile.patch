+// The request asks for the facts and for the school's organisation; the login hint stays the requested name.
+func TestMastersOSScopesCarryTheOrganisation(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	b := profileBroker(t, schoolClaims("alice@school.example"), withProfile(mastersosOrg))
+
+	sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+	u := cardURL(t, b, sessionID)
+	scopes := scopesOf(u)
+	require.Contains(t, scopes, "openid")
+	require.Contains(t, scopes, "mastersos.facts")
+	require.Contains(t, scopes, "org:"+mastersosOrg)
+	require.Equal(t, "alice@school.example", u.Query().Get("login_hint"))
+	b.CancelIsAuthenticated(sessionID)
+}
