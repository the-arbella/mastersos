diff --git a/authd-oidc-brokers/internal/broker/mastersos_facts.go b/authd-oidc-brokers/internal/broker/mastersos_facts.go
new file mode 100644
index 0000000..7ab8858
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_facts.go
@@ -0,0 +1,274 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the facts hand-off.
+//
+// With the issuer profile on, a granted card login asks the issuer's userinfo endpoint, with this login's access token,
+// for the person's facts (scope mastersos.facts) and leaves them for pam-session in <mastersosFactsDir>/<login_name>.json,
+// mode 0600, written by rename. The file is one of
+//
+//	{"version":1,"user":"<login_name>","granted_at":<unix seconds>,"facts":{...}}
+//	{"version":1,"user":"<login_name>","granted_at":<unix seconds>,"error":"<text>"}
+//
+// facts keeps only sub, org, org_role, org_nodes, classes and age_band, as the issuer sent them; userinfo whose sub or
+// org is not the verified ID token's gives the error form, as does a failed, slow (over mastersosUserinfoTimeout) or too
+// large (over 64 KiB) answer. The error text is the broker's own: never the answer's body, never a token.
+//
+// The hand-off is consumed once: NewSession deletes the file of the user it starts for (login or unlock), so a login
+// whose facts could not be fetched never hands over an earlier login's. The facts never decide the login: nothing here
+// can deny it.
+//
+// Only a directory that is root's own (owner mastersosFactsDirUID, mode exactly 0700, not a symlink) is written to or
+// deleted from, and only under a name derived from a login_name of the checked shape, which has no '/'.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"net/http"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/canonical/authd/log"
+	"github.com/coreos/go-oidc/v3/oidc"
+	"golang.org/x/oauth2"
+)
+
+// mastersosFactsDir is created by tmpfiles (root, 0700). Package variables so that tests, running as an ordinary user,
+// can point the hand-off at their own directory and keep the userinfo timeout short.
+var (
+	mastersosFactsDir        = "/run/mastersos/facts"
+	mastersosFactsDirUID     = 0
+	mastersosUserinfoTimeout = 5 * time.Second
+)
+
+// mastersosMaxUserinfo caps the userinfo answer.
+const mastersosMaxUserinfo = 64 * 1024
+
+// mastersosFactKeys are the userinfo keys handed over.
+var mastersosFactKeys = []string{"sub", "org", "org_role", "org_nodes", "classes", "age_band"}
+
+var errMastersosUserinfoTooLarge = errors.New("userinfo response is larger than 64 KiB")
+
+// mastersosFactsError is a failed fetch: text goes into the file, err only into the log.
+type mastersosFactsError struct {
+	text string
+	err  error
+}
+
+func (e *mastersosFactsError) Error() string {
+	if e.err == nil {
+		return e.text
+	}
+	return e.text + ": " + e.err.Error()
+}
+
+type mastersosFactsFile struct {
+	Version   int                        `json:"version"`
+	User      string                     `json:"user"`
+	GrantedAt int64                      `json:"granted_at"`
+	Facts     map[string]json.RawMessage `json:"facts,omitempty"`
+	Error     string                     `json:"error,omitempty"`
+}
+
+// mastersosFactsDirCheck reports why dir must not be used: not a real directory (a symlink is not followed), not owned
+// by mastersosFactsDirUID, or a mode other than exactly 0700.
+func mastersosFactsDirCheck(dir string) error {
+	fi, err := os.Lstat(dir)
+	if err != nil {
+		return err
+	}
+	if fi.Mode() != fs.ModeDir|0o700 {
+		return fmt.Errorf("%s is not a directory of mode 0700 (%s)", dir, fi.Mode())
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok || int(st.Uid) != mastersosFactsDirUID {
+		return fmt.Errorf("%s is not owned by uid %d", dir, mastersosFactsDirUID)
+	}
+	return nil
+}
+
+// mastersosForgetFacts deletes the facts file of userName, a login_name, at the start of an authentication. Anything
+// else (a name of another shape, a directory that fails the checks) deletes nothing.
+func mastersosForgetFacts(userName string) {
+	if !mastersosLoginNameValid(userName) {
+		return
+	}
+	dir := mastersosFactsDir
+	if err := mastersosFactsDirCheck(dir); err != nil {
+		log.Debugf(context.Background(), "Not deleting earlier facts of %q: %v", userName, err)
+		return
+	}
+	if err := os.Remove(filepath.Join(dir, userName+".json")); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		log.Warningf(context.Background(), "Could not delete the earlier facts of %q: %v", userName, err)
+	}
+}
+
+// mastersosWriteFacts hands the facts of a granted login to pam-session. It never fails the login: every problem ends in
+// the error form, or, when the file cannot be written at all, in no file (pam-session then falls back).
+func (b *Broker) mastersosWriteFacts(ctx context.Context, session *session, claims mastersosIDClaims, t *oauth2.Token) {
+	if !mastersosLoginNameValid(claims.LoginName) {
+		log.Warningf(context.Background(), "Not handing over facts: the login name %q does not have the expected shape", claims.LoginName)
+		return
+	}
+	content := mastersosFactsFile{Version: 1, User: claims.LoginName, GrantedAt: time.Now().Unix()}
+	facts, err := mastersosFetchFacts(ctx, session, claims, t)
+	if err != nil {
+		var fe *mastersosFactsError
+		if !errors.As(err, &fe) {
+			fe = &mastersosFactsError{text: "could not get the facts", err: err}
+		}
+		log.Warningf(context.Background(), "No facts for %q: %v", claims.LoginName, fe)
+		content.Error = fe.text
+	} else {
+		content.Facts = facts
+	}
+	if err := mastersosWriteFactsFile(mastersosFactsDir, content); err != nil {
+		log.Warningf(context.Background(), "Could not hand over the facts of %q: %v", claims.LoginName, err)
+	}
+}
+
+// mastersosFetchFacts asks the userinfo endpoint with this login's access token, within mastersosUserinfoTimeout and
+// mastersosMaxUserinfo.
+func mastersosFetchFacts(ctx context.Context, session *session, claims mastersosIDClaims, t *oauth2.Token) (map[string]json.RawMessage, error) {
+	if session.oidcServer == nil {
+		return nil, &mastersosFactsError{text: "the issuer is not reachable"}
+	}
+	if t == nil || t.AccessToken == "" {
+		return nil, &mastersosFactsError{text: "the login has no access token"}
+	}
+	ctx, cancel := context.WithTimeout(ctx, mastersosUserinfoTimeout)
+	defer cancel()
+
+	base := http.DefaultTransport
+	if c, ok := ctx.Value(oauth2.HTTPClient).(*http.Client); ok && c != nil && c.Transport != nil {
+		base = c.Transport
+	}
+	status := 0
+	client := &http.Client{Transport: mastersosCappedTransport{base: base, status: &status}}
+
+	userInfo, err := session.oidcServer.UserInfo(oidc.ClientContext(ctx, client), oauth2.StaticTokenSource(t))
+	switch {
+	case errors.Is(err, errMastersosUserinfoTooLarge):
+		return nil, &mastersosFactsError{text: "the userinfo response is too large"}
+	case err != nil && ctx.Err() != nil:
+		return nil, &mastersosFactsError{text: "the userinfo request did not finish in time"}
+	case err != nil && status != 0 && status != http.StatusOK:
+		// go-oidc's error carries the answer's body: only the status is logged.
+		return nil, &mastersosFactsError{text: "the userinfo request failed", err: fmt.Errorf("HTTP status %d", status)}
+	case err != nil:
+		return nil, &mastersosFactsError{text: "the userinfo request failed", err: err}
+	}
+
+	var raw map[string]json.RawMessage
+	if err := userInfo.Claims(&raw); err != nil || raw == nil {
+		return nil, &mastersosFactsError{text: "the userinfo response is not a JSON object"}
+	}
+	return mastersosFactsFrom(raw, claims)
+}
+
+// mastersosFactsFrom keeps the six facts of a userinfo answer whose sub and org are the ID token's.
+func mastersosFactsFrom(raw map[string]json.RawMessage, claims mastersosIDClaims) (map[string]json.RawMessage, error) {
+	var sub, org string
+	if json.Unmarshal(raw["sub"], &sub) != nil || json.Unmarshal(raw["org"], &org) != nil ||
+		sub == "" || org == "" || sub != claims.Sub || org != claims.Org {
+		return nil, &mastersosFactsError{text: "the userinfo sub or org does not match the ID token"}
+	}
+	facts := make(map[string]json.RawMessage, len(mastersosFactKeys))
+	for _, k := range mastersosFactKeys {
+		if v, ok := raw[k]; ok {
+			facts[k] = v
+		}
+	}
+	return facts, nil
+}
+
+// mastersosWriteFactsFile writes content to dir/<user>.json by rename, after the directory checks.
+func mastersosWriteFactsFile(dir string, content mastersosFactsFile) (err error) {
+	if !mastersosLoginNameValid(content.User) {
+		return fmt.Errorf("the login name %q does not have the expected shape", content.User)
+	}
+	if err := mastersosFactsDirCheck(dir); err != nil {
+		return err
+	}
+	data, err := json.Marshal(content)
+	if err != nil {
+		return err
+	}
+
+	f, err := os.CreateTemp(dir, ".facts-*")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	defer func() {
+		if err != nil {
+			_ = f.Close()
+			_ = os.Remove(tmp)
+		}
+	}()
+	if err = f.Chmod(0o600); err != nil {
+		return err
+	}
+	if _, err = f.Write(data); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmp, filepath.Join(dir, content.User+".json"))
+}
+
+// mastersosCappedTransport makes every response body fail, instead of growing, past mastersosMaxUserinfo.
+// It records the last status in status.
+type mastersosCappedTransport struct {
+	base   http.RoundTripper
+	status *int
+}
+
+func (c mastersosCappedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	resp, err := c.base.RoundTrip(req)
+	if err != nil {
+		return nil, err
+	}
+	*c.status = resp.StatusCode
+	if resp.ContentLength > mastersosMaxUserinfo {
+		_ = resp.Body.Close()
+		return nil, errMastersosUserinfoTooLarge
+	}
+	resp.Body = mastersosCapBody(resp.Body)
+	return resp, nil
+}
+
+// mastersosCapBody reads at most mastersosMaxUserinfo bytes of body, and fails on one more: never a silent truncation.
+func mastersosCapBody(body io.ReadCloser) io.ReadCloser {
+	return &mastersosCappedBody{ReadCloser: body}
+}
+
+type mastersosCappedBody struct {
+	io.ReadCloser
+	n int64
+}
+
+func (c *mastersosCappedBody) Read(p []byte) (int, error) {
+	room := mastersosMaxUserinfo + 1 - c.n
+	if room <= 0 {
+		return 0, errMastersosUserinfoTooLarge
+	}
+	if int64(len(p)) > room {
+		p = p[:room]
+	}
+	n, err := c.ReadCloser.Read(p)
+	c.n += int64(n)
+	if c.n > mastersosMaxUserinfo {
+		return n, errMastersosUserinfoTooLarge
+	}
+	return n, err
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_facts_export_test.go b/authd-oidc-brokers/internal/broker/mastersos_facts_export_test.go
