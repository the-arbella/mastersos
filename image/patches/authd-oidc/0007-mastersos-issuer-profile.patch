index 0000000..48192a1
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_facts_export_test.go
@@ -0,0 +1,24 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the helpers its facts tests reach.
+
+import (
+	"testing"
+	"time"
+)
+
+// SetMastersOSFacts points the facts hand-off at dir, owned by ownerUID (tests run as an ordinary user), with this
+// userinfo timeout. The previous values come back when the test ends.
+func SetMastersOSFacts(t testing.TB, dir string, ownerUID int, timeout time.Duration) {
+	t.Helper()
+	oldDir, oldUID, oldTimeout := mastersosFactsDir, mastersosFactsDirUID, mastersosUserinfoTimeout
+	t.Cleanup(func() {
+		mastersosFactsDir, mastersosFactsDirUID, mastersosUserinfoTimeout = oldDir, oldUID, oldTimeout
+	})
+	mastersosFactsDir, mastersosFactsDirUID, mastersosUserinfoTimeout = dir, ownerUID, timeout
+}
+
+// MastersOSForgetFacts deletes a user's facts file the way NewSession does.
+func MastersOSForgetFacts(userName string) {
+	mastersosForgetFacts(userName)
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_facts_internal_test.go b/authd-oidc-brokers/internal/broker/mastersos_facts_internal_test.go
