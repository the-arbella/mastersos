diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile.go b/authd-oidc-brokers/internal/broker/mastersos_profile.go
new file mode 100644
index 0000000..2f058de
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_profile.go
@@ -0,0 +1,200 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the school's issuer profile.
+//
+// A MastersOS issuer names every person with a login_name claim (lowercase, one '@', admin-controlled, never reused) and
+// says which organisation the person belongs to with an org claim. With the profile on, the broker:
+//   - asks for the scopes mastersos.facts and org:<the school's id>;
+//   - takes the local user name from login_name instead of email, and needs neither email nor email_verified;
+//   - denies, before access is granted (so authd registers nobody), a token whose org is not the school's id or whose
+//     login_name is not of the expected shape.
+// Everything keyed on the user name stays as it is: the requested account must equal the authenticated one (upstream's
+// VerifyUsername, now comparing login_name), patch 0006's allowed domains, admin_users and the login hint.
+//
+// The school's id is in a plain file beside the configuration, mastersos-expected-org in the directory of broker.conf
+// (/etc/authd/oidc/mastersos-expected-org): exactly one lowercase UUID line, plus blank lines and lines starting with
+// '#'. As with patch 0006's domain file, it is not a key of broker.conf.d (a broker without this patch would refuse to
+// start), and the drop-in says the file is required with a comment line (mastersosProfileMarker). The profile is on when
+// the file is there or the marker asks for it. On, with no usable id (file missing, unreadable, too large, or not exactly
+// one lowercase UUID), every login is denied: a broker that was told to use the profile never falls back to email names.
+// With neither file nor marker nothing changes, exactly as upstream. Both are read once, when the broker starts.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	providerErrors "github.com/canonical/authd/authd-oidc-brokers/internal/providers/errors"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/providers/info"
+	"github.com/canonical/authd/log"
+	"github.com/coreos/go-oidc/v3/oidc"
+)
+
+// mastersosExpectedOrgFile is the file's name, in the directory of broker.conf.
+const mastersosExpectedOrgFile = "mastersos-expected-org"
+
+// mastersosProfileMarker, a whole line of a broker.conf.d file, says the issuer profile is on.
+const mastersosProfileMarker = "# mastersos: issuer profile required (patch 0007)"
+
+// mastersosMaxExpectedOrgFile caps what is read: the agent writes one id and a comment or two.
+const mastersosMaxExpectedOrgFile = 4096
+
+// mastersosFactsScope asks the issuer for the person's facts at its userinfo endpoint.
+const mastersosFactsScope = "mastersos.facts"
+
+var (
+	mastersosUUID      = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+	mastersosLoginName = regexp.MustCompile(`^[a-z0-9._-]{1,64}@[a-z0-9.-]{1,253}$`)
+)
+
+// mastersosProfile is the issuer profile; the zero value (no file, no marker) is off. Active with an empty org denies
+// every login.
+type mastersosProfile struct {
+	active bool
+	org    string
+}
+
+// mastersosIDClaims are the profile's claims of a verified ID token.
+type mastersosIDClaims struct {
+	Sub       string
+	Org       string
+	LoginName string
+}
+
+func mastersosExpectedOrgPath(cfgPath string) string {
+	return filepath.Join(filepath.Dir(cfgPath), mastersosExpectedOrgFile)
+}
+
+// mastersosProfileRequired reports whether any file in the drop-in directory carries mastersosProfileMarker. The broker
+// has already parsed every one of them, so a directory or file that cannot be read here counts as requiring the profile.
+func mastersosProfileRequired(dropInDir string) bool {
+	entries, err := os.ReadDir(dropInDir)
+	if errors.Is(err, fs.ErrNotExist) {
+		return false
+	}
+	if err != nil {
+		return true
+	}
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		content, err := os.ReadFile(filepath.Join(dropInDir, e.Name()))
+		if err != nil {
+			return true
+		}
+		for _, line := range strings.Split(string(content), "\n") {
+			if strings.TrimSpace(line) == mastersosProfileMarker {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// mastersosReadProfile reads the expected-org file. Missing: on (with no id) only when required. There but unusable: on,
+// with no id, marker or not.
+func mastersosReadProfile(path string, required bool) mastersosProfile {
+	const denyAll = "every school sign-in is denied"
+	content, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		if required {
+			log.Warningf(context.Background(), "%s is missing but the issuer profile is on: %s", path, denyAll)
+		}
+		return mastersosProfile{active: required}
+	}
+	if err == nil && len(content) > mastersosMaxExpectedOrgFile {
+		err = errors.New("too large")
+	}
+	if err != nil {
+		log.Warningf(context.Background(), "could not read %s (%v): %s", path, err, denyAll)
+		return mastersosProfile{active: true}
+	}
+	var ids []string
+	s := bufio.NewScanner(bytes.NewReader(content))
+	for s.Scan() {
+		line := strings.TrimSpace(s.Text())
+		if line != "" && !strings.HasPrefix(line, "#") {
+			ids = append(ids, line)
+		}
+	}
+	if s.Err() != nil || len(ids) != 1 || !mastersosUUID.MatchString(ids[0]) {
+		log.Warningf(context.Background(), "%s does not hold exactly one lowercase UUID: %s", path, denyAll)
+		return mastersosProfile{active: true}
+	}
+	return mastersosProfile{active: true, org: ids[0]}
+}
+
+// mastersosLoadProfile is what the broker reads at start: the marker in broker.conf.d, then the expected-org file.
+func mastersosLoadProfile(cfgPath string) mastersosProfile {
+	return mastersosReadProfile(mastersosExpectedOrgPath(cfgPath), mastersosProfileRequired(GetDropInDir(cfgPath)))
+}
+
+// mastersosScopes are the scopes the profile adds to the authorization request: none when it is off, or when there is
+// no organisation to ask for (every login is then denied after the page, with the broker's own message).
+func mastersosScopes(p mastersosProfile) []string {
+	if !p.active || p.org == "" {
+		return nil
+	}
+	return []string{mastersosFactsScope, "org:" + p.org}
+}
+
+// mastersosLoginNameValid reports whether name has the shape of a login_name: lowercase, exactly one '@', a local part of
+// [a-z0-9._-]{1,64} and a domain of [a-z0-9.-]{1,253}. Such a name has no '/', so it is safe as a file name too.
+func mastersosLoginNameValid(name string) bool {
+	return mastersosLoginName.MatchString(name)
+}
+
+// mastersosUserInfo is used instead of the provider's GetUserInfo when the profile is on, with the verified ID token.
+func mastersosUserInfo(p mastersosProfile, idToken *oidc.IDToken) (info.User, mastersosIDClaims, error) {
+	if idToken == nil {
+		return info.User{}, mastersosIDClaims{}, mastersosDenial("Authentication failure: no ID token", errors.New("the issuer profile needs an ID token"))
+	}
+	return mastersosUserInfoFromClaims(p, idToken)
+}
+
+// mastersosUserInfoFromClaims fills the info.User fields genericprovider.GetUserInfo fills (name, home, provider ID,
+// shell, gecos), with the name from login_name. Every error is for display: the login screen shows it as the refusal.
+func mastersosUserInfoFromClaims(p mastersosProfile, claimer info.Claimer) (info.User, mastersosIDClaims, error) {
+	if p.org == "" {
+		return info.User{}, mastersosIDClaims{}, mastersosDenial("Authentication failure: school sign-in is not set up on this device",
+			errors.New("the issuer profile is on but the expected organisation is unknown"))
+	}
+
+	var claims map[string]interface{}
+	if err := claimer.Claims(&claims); err != nil {
+		return info.User{}, mastersosIDClaims{}, fmt.Errorf("failed to get ID token claims: %v", err)
+	}
+	sub, _ := claims["sub"].(string)
+	org, _ := claims["org"].(string)
+	loginName, _ := claims["login_name"].(string)
+	idClaims := mastersosIDClaims{Sub: sub, Org: org, LoginName: loginName}
+
+	if sub == "" {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: the ID token has no sub claim", errors.New("missing sub"))
+	}
+	if org != p.org {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: this account is not a member of this school",
+			fmt.Errorf("org %q is not the expected %q", org, p.org))
+	}
+	if !mastersosLoginNameValid(loginName) {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: this account has no valid login name",
+			fmt.Errorf("login_name %q does not have the expected shape", loginName))
+	}
+
+	home, _ := claims["home"].(string)
+	shell, _ := claims["shell"].(string)
+	gecos, _ := claims["name"].(string)
+	return info.NewUser(loginName, home, sub, shell, gecos, nil), idClaims, nil
+}
+
+func mastersosDenial(message string, err error) error {
+	return &providerErrors.ForDisplayError{Message: message, Err: err}
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile_export_test.go b/authd-oidc-brokers/internal/broker/mastersos_profile_export_test.go
new file mode 100644
index 0000000..29cd410
