--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_facts_internal_test.go
@@ -0,0 +1,64 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the userinfo body cap and the
+// facts kept from a userinfo answer.
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The cap is exactly 64 KiB: a body of that size is read whole, one byte more is an error (never a silent truncation).
+func TestMastersOSUserinfoBodyCap(t *testing.T) {
+	body := bytes.Repeat([]byte("x"), mastersosMaxUserinfo)
+	got, err := io.ReadAll(mastersosCapBody(io.NopCloser(bytes.NewReader(body))))
+	require.NoError(t, err)
+	require.Len(t, got, mastersosMaxUserinfo)
+
+	_, err = io.ReadAll(mastersosCapBody(io.NopCloser(bytes.NewReader(append(body, 'x')))))
+	require.True(t, errors.Is(err, errMastersosUserinfoTooLarge), "err: %v", err)
+	require.Equal(t, 64*1024, mastersosMaxUserinfo)
+}
+
+// Only the six facts are kept, with their values as the issuer sent them; sub and org must be the ID token's strings.
+func TestMastersOSFactsFromUserinfo(t *testing.T) {
+	claims := mastersosIDClaims{Sub: "alice-id", Org: testOrg, LoginName: "alice@school.example"}
+	raw := func(s string) map[string]json.RawMessage {
+		var m map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal([]byte(s), &m))
+		return m
+	}
+
+	facts, err := mastersosFactsFrom(raw(`{"sub":"alice-id","org":"`+testOrg+`","org_role":"member","org_nodes":[],`+
+		`"classes":[{"id":"c","role":"student","x":1}],"age_band":null,"name":"Alice","email":"a@b"}`), claims)
+	require.NoError(t, err)
+	out, err := json.Marshal(facts)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"sub":"alice-id","org":"`+testOrg+`","org_role":"member","org_nodes":[],`+
+		`"classes":[{"id":"c","role":"student","x":1}],"age_band":null}`, string(out))
+
+	facts, err = mastersosFactsFrom(raw(`{"sub":"alice-id","org":"`+testOrg+`"}`), claims)
+	require.NoError(t, err)
+	require.Len(t, facts, 2, "absent facts stay absent")
+
+	for _, bad := range []string{
+		`{"sub":"bob-id","org":"` + testOrg + `"}`,
+		`{"sub":"alice-id","org":"` + strings.ToUpper(testOrg) + `"}`,
+		`{"org":"` + testOrg + `"}`,
+		`{"sub":"alice-id"}`,
+		`{"sub":null,"org":"` + testOrg + `"}`,
+		`{"sub":["alice-id"],"org":"` + testOrg + `"}`,
+	} {
+		_, err := mastersosFactsFrom(raw(bad), claims)
+		require.Error(t, err, "userinfo %s", bad)
+	}
+
+	_, err = mastersosFactsFrom(raw(`{"sub":"","org":""}`), mastersosIDClaims{LoginName: "alice@school.example"})
+	require.Error(t, err, "empty claims never match")
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_facts_test.go b/authd-oidc-brokers/internal/broker/mastersos_facts_test.go
new file mode 100644
index 0000000..4a0d41a
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_facts_test.go
@@ -0,0 +1,408 @@
+package broker_test
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): after a card login is granted
+// with the issuer profile on, the broker fetches the person's facts from the userinfo endpoint and leaves them for
+// pam-session in <facts dir>/<login_name>.json, consumed once: NewSession deletes the file of the user it starts for.
+// Not parallel: these tests change package settings and share the card's fixed ports.
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/canonical/authd/authd-oidc-brokers/internal/broker"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/testutils"
+	"github.com/stretchr/testify/require"
+)
+
+const aliceFile = "alice@school.example.json"
+
+// userinfoRecorder is a /userinfo endpoint that counts its requests and remembers their Authorization header.
+type userinfoRecorder struct {
+	mu      sync.Mutex
+	calls   int
+	auth    string
+	respond func(w http.ResponseWriter, r *http.Request)
+}
+
+func (u *userinfoRecorder) handler(w http.ResponseWriter, r *http.Request) {
+	u.mu.Lock()
+	u.calls++
+	u.auth = r.Header.Get("Authorization")
+	u.mu.Unlock()
+	u.respond(w, r)
+}
+
+func (u *userinfoRecorder) count() int {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return u.calls
+}
+
+func respondJSON(body map[string]interface{}) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		data, _ := json.Marshal(body)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(data)
+	}
+}
+
+func respondRaw(status int, body string) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}
+}
+
+// schoolFacts is what the issuer answers at userinfo for alice: the six facts and a key the hand-off drops.
+func schoolFacts() map[string]interface{} {
+	return map[string]interface{}{
+		"sub":       "alice-id",
+		"org":       mastersosOrg,
+		"org_role":  "member",
+		"org_nodes": []interface{}{"node-1", "node-2"},
+		"classes":   []interface{}{map[string]interface{}{"id": "class-1", "role": "student"}},
+		"age_band":  "13-17",
+		"name":      "Alice Example",
+	}
+}
+
+const schoolFactsJSON = `{"sub":"alice-id","org":"` + mastersosOrg + `","org_role":"member","org_nodes":["node-1","node-2"],` +
+	`"classes":[{"id":"class-1","role":"student"}],"age_band":"13-17"}`
+
+// newFactsDir makes a facts directory the way tmpfiles does (0700, owned by the user running the test) and points the
+// broker at it.
+func newFactsDir(t *testing.T) string {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), "facts")
+	require.NoError(t, os.Mkdir(dir, 0o700))
+	require.NoError(t, os.Chmod(dir, 0o700))
+	broker.SetMastersOSFacts(t, dir, os.Getuid(), 5*time.Second)
+	return dir
+}
+
+// factsBroker is profileBroker with the /userinfo endpoint answering through rec.
+func factsBroker(t *testing.T, claims map[string]interface{}, rec *userinfoRecorder, profile bool) *broker.Broker {
+	t.Helper()
+	return profileBroker(t, claims, func(cfg *brokerForTestConfig) {
+		cfg.customHandlers["/userinfo"] = testutils.EndpointHandler(rec.handler)
+		if profile {
+			cfg.SetMastersOSProfile(mastersosOrg)
+		}
+	})
+}
+
+// loginAlice signs alice in on the card and requires the login to be granted.
+func loginAlice(t *testing.T, b *broker.Broker) {
+	t.Helper()
+	sessionID, _ := newSessionForTests(t, b, "alice@school.example", "")
+	access, data := finishOnCard(t, b, sessionID, cardURL(t, b, sessionID))
+	require.Equal(t, broker.AuthGranted, access, "the facts never decide the login; data: %s", data)
+}
+
+// readFacts reads a facts file, checks its mode and the fields both forms share, and returns its raw content and keys.
+func readFacts(t *testing.T, path string) (string, map[string]json.RawMessage) {
+	t.Helper()
+	fi, err := os.Lstat(path)
+	require.NoError(t, err, "the facts file should be there")
+	require.True(t, fi.Mode().IsRegular(), "the facts file should be a regular file")
+	require.Equal(t, os.FileMode(0o600), fi.Mode().Perm(), "the facts file should be 0600")
+	content, err := os.ReadFile(path)
+	require.NoError(t, err)
+
+	var got map[string]json.RawMessage
+	require.NoError(t, json.Unmarshal(content, &got), "content: %s", content)
+	require.JSONEq(t, `1`, string(got["version"]))
+	require.JSONEq(t, `"alice@school.example"`, string(got["user"]))
+	var grantedAt int64
+	require.NoError(t, json.Unmarshal(got["granted_at"], &grantedAt))
+	require.InDelta(t, time.Now().Unix(), grantedAt, 5, "granted_at is the grant's time in unix seconds")
+	return string(content), got
+}
+
+// requireErrorForm checks the error form: an error text and no facts.
+func requireErrorForm(t *testing.T, path string) string {
+	t.Helper()
+	content, got := readFacts(t, path)
+	require.NotContains(t, got, "facts", "a failed fetch hands over no facts; content: %s", content)
+	var text string
+	require.NoError(t, json.Unmarshal(got["error"], &text), "content: %s", content)
+	require.NotEmpty(t, text)
+	require.Len(t, got, 4, "version, user, granted_at and error; content: %s", content)
+	return content
+}
+
+// dirNames lists a directory's entries.
+func dirNames(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+	var names []string
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	return names
+}
+
+// oldFacts leaves alice's facts of an earlier login behind.
+func oldFacts(t *testing.T, dir string) {
+	t.Helper()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, aliceFile),
+		[]byte(`{"version":1,"user":"alice@school.example","granted_at":1,"facts":{"sub":"alice-id","org_role":"old"}}`), 0o600))
+}
+
+func TestMastersOSFactsWrittenAfterGrant(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	rec := &userinfoRecorder{respond: respondJSON(schoolFacts())}
+	b := factsBroker(t, schoolClaims("alice@school.example"), rec, true)
+	dir := newFactsDir(t)
+
+	loginAlice(t, b)
+
+	require.Equal(t, 1, rec.count(), "one userinfo request per login")
+	require.Equal(t, "Bearer accesstoken", rec.auth, "userinfo is asked with this login's access token")
+	require.Equal(t, []string{aliceFile}, dirNames(t, dir), "only the facts file, no temporary file left")
+	content, got := readFacts(t, filepath.Join(dir, aliceFile))
+	require.Len(t, got, 4, "version, user, granted_at and facts; content: %s", content)
+	require.NotContains(t, got, "error")
+	require.JSONEq(t, schoolFactsJSON, string(got["facts"]), "the six facts, as the issuer sent them")
+	require.NotContains(t, content, "Alice Example", "keys other than the six are dropped")
+}
+
+// Every authentication starts by deleting that user's facts: a later failure can never hand over an earlier login's.
+func TestMastersOSFactsDeletedAtNewSession(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, requested := range map[string]string{
+		"login":                  "alice@school.example",
+		"name typed in capitals": "Alice@School.Example",
+	} {
+		t.Run(name, func(t *testing.T) {
+			rec := &userinfoRecorder{respond: respondJSON(schoolFacts())}
+			b := factsBroker(t, schoolClaims("alice@school.example"), rec, true)
+			dir := newFactsDir(t)
+			oldFacts(t, dir)
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "bob@school.example.json"), []byte(`{"version":1}`), 0o600))
+
+			newSessionForTests(t, b, requested, "")
+
+			require.NoFileExists(t, filepath.Join(dir, aliceFile), "the user's earlier facts are gone at NewSession")
+			require.FileExists(t, filepath.Join(dir, "bob@school.example.json"), "another user's facts stay")
+			require.Zero(t, rec.count(), "NewSession asks userinfo nothing")
+		})
+	}
+}
+
+func TestMastersOSUserinfoFailureWritesError(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	const marker = "USERINFO-BODY-MARKER"
+	tooLarge := `{"sub":"alice-id","org":"` + mastersosOrg + `","age_band":"13-17","padding":"` + strings.Repeat("x", 70*1024) + `"}`
+	validThenSpace := `{"sub":"alice-id","org":"` + mastersosOrg + `","age_band":"13-17"}` + strings.Repeat(" ", 70*1024)
+
+	for name, tc := range map[string]struct {
+		respond func(w http.ResponseWriter, r *http.Request)
+		timeout time.Duration
+	}{
+		"status 500": {respond: respondRaw(http.StatusInternalServerError, `{"error":"`+marker+`"}`)},
+		"status 401": {respond: respondRaw(http.StatusUnauthorized, marker)},
+		"timeout": {
+			timeout: 200 * time.Millisecond,
+			respond: func(w http.ResponseWriter, r *http.Request) {
+				select {
+				case <-r.Context().Done():
+				case <-time.After(10 * time.Second):
+				}
+				respondJSON(schoolFacts())(w, r)
+			},
+		},
+		"body over 64 KiB":                    {respond: respondRaw(http.StatusOK, tooLarge)},
+		"valid object then over 64 KiB space": {respond: respondRaw(http.StatusOK, validThenSpace)},
+		"not json":                            {respond: respondRaw(http.StatusOK, marker)},
+		"not an object":                       {respond: respondRaw(http.StatusOK, `["alice-id"]`)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			rec := &userinfoRecorder{respond: tc.respond}
+			b := factsBroker(t, schoolClaims("alice@school.example"), rec, true)
+			dir := newFactsDir(t)
+			if tc.timeout != 0 {
+				broker.SetMastersOSFacts(t, dir, os.Getuid(), tc.timeout)
+			}
+			oldFacts(t, dir)
+
+			start := time.Now()
+			loginAlice(t, b)
+			require.Less(t, time.Since(start), 5*time.Second, "the userinfo timeout bounds the login")
+
+			require.Equal(t, 1, rec.count())
+			content := requireErrorForm(t, filepath.Join(dir, aliceFile))
+			require.NotContains(t, content, marker, "the error never carries the userinfo body")
+			require.NotContains(t, content, "accesstoken", "the error never carries a token")
+			require.NotContains(t, content, "old", "the earlier login's facts are not reused")
+			require.Equal(t, []string{aliceFile}, dirNames(t, dir), "no temporary file left")
+		})
+	}
+}
+
+// Userinfo that names another person or organisation than the verified ID token hands over nobody's facts.
+func TestMastersOSUserinfoSubjectMismatchWritesError(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, change := range map[string]func(f map[string]interface{}){
+		"another sub":      func(f map[string]interface{}) { f["sub"] = "bob-id" },
+		"another org":      func(f map[string]interface{}) { f["org"] = mastersosOtherOrg },
+		"org in capitals":  func(f map[string]interface{}) { f["org"] = strings.ToUpper(mastersosOrg) },
+		"no sub":           func(f map[string]interface{}) { delete(f, "sub") },
+		"no org":           func(f map[string]interface{}) { delete(f, "org") },
+		"sub not a string": func(f map[string]interface{}) { f["sub"] = 7 },
+		"org not a string": func(f map[string]interface{}) { f["org"] = []interface{}{mastersosOrg} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			f := schoolFacts()
+			f["org_role"] = "staff-of-someone-else"
+			change(f)
+			rec := &userinfoRecorder{respond: respondJSON(f)}
+			b := factsBroker(t, schoolClaims("alice@school.example"), rec, true)
+			dir := newFactsDir(t)
+
+			loginAlice(t, b)
+
+			require.Equal(t, 1, rec.count())
+			content := requireErrorForm(t, filepath.Join(dir, aliceFile))
+			require.NotContains(t, content, "staff-of-someone-else", "another person's facts are never handed over")
+		})
+	}
+}
+
+// A facts directory that is not root's own 0700 directory gets nothing, anywhere; the login is still granted.
+func TestMastersOSFactsNeverLeaveTheDirectory(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	for name, setup := range map[string]func(t *testing.T, parent string) (dir, watched string, uid int){
+		"directory is a symlink": func(t *testing.T, parent string) (string, string, int) {
+			target := filepath.Join(parent, "target")
+			require.NoError(t, os.Mkdir(target, 0o700))
+			require.NoError(t, os.Chmod(target, 0o700))
+			link := filepath.Join(parent, "facts")
+			require.NoError(t, os.Symlink(target, link))
+			return link, target, os.Getuid()
+		},
+		"directory of another user": func(t *testing.T, parent string) (string, string, int) {
+			dir := filepath.Join(parent, "facts")
+			require.NoError(t, os.Mkdir(dir, 0o700))
+			require.NoError(t, os.Chmod(dir, 0o700))
+			return dir, dir, os.Getuid() + 1
+		},
+		"directory 0750": func(t *testing.T, parent string) (string, string, int) {
+			dir := filepath.Join(parent, "facts")
+			require.NoError(t, os.Mkdir(dir, 0o700))
+			require.NoError(t, os.Chmod(dir, 0o750))
+			return dir, dir, os.Getuid()
+		},
+		"directory 0777": func(t *testing.T, parent string) (string, string, int) {
+			dir := filepath.Join(parent, "facts")
+			require.NoError(t, os.Mkdir(dir, 0o700))
+			require.NoError(t, os.Chmod(dir, 0o777))
+			return dir, dir, os.Getuid()
+		},
+		"directory sticky": func(t *testing.T, parent string) (string, string, int) {
+			dir := filepath.Join(parent, "facts")
+			require.NoError(t, os.Mkdir(dir, 0o700))
+			require.NoError(t, os.Chmod(dir, 0o700|os.ModeSticky))
+			return dir, dir, os.Getuid()
+		},
+		"a regular file": func(t *testing.T, parent string) (string, string, int) {
+			dir := filepath.Join(parent, "facts")
+			require.NoError(t, os.WriteFile(dir, nil, 0o700))
+			return dir, parent, os.Getuid()
+		},
+		"missing": func(t *testing.T, parent string) (string, string, int) {
+			return filepath.Join(parent, "facts"), parent, os.Getuid()
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			rec := &userinfoRecorder{respond: respondJSON(schoolFacts())}
+			b := factsBroker(t, schoolClaims("alice@school.example"), rec, true)
+			parent := t.TempDir()
+			dir, watched, uid := setup(t, parent)
+			before := dirNames(t, parent)
+			broker.SetMastersOSFacts(t, dir, uid, 5*time.Second)
+
+			loginAlice(t, b)
+
+			require.Equal(t, before, dirNames(t, parent), "nothing new beside the directory")
+			if watched != parent {
+				require.Empty(t, dirNames(t, watched), "nothing written inside the directory")
+			}
+		})
+	}
+}
+
+// Without the profile there is no hand-off: no userinfo request, no file written, none deleted.
+func TestMastersOSNoProfileWritesNoFacts(t *testing.T) {
+	t.Setenv("MASTERSOS_AUTH_CODE", "1")
+	rec := &userinfoRecorder{respond: respondJSON(schoolFacts())}
+	b := factsBroker(t, withEmail(schoolClaims("alice@school.example")), rec, false)
+	dir := newFactsDir(t)
+	oldFacts(t, dir)
+	before, err := os.ReadFile(filepath.Join(dir, aliceFile))
+	require.NoError(t, err)
+
+	loginAlice(t, b)
+
+	require.Zero(t, rec.count(), "no userinfo request without the profile")
+	require.Equal(t, []string{aliceFile}, dirNames(t, dir), "no file written")
+	after, err := os.ReadFile(filepath.Join(dir, aliceFile))
+	require.NoError(t, err, "no file deleted")
+	require.Equal(t, before, after)
+}
+
+// Deleting a user's facts touches only <facts dir>/<login_name>.json, and only in a directory that passes the checks.
+func TestMastersOSForgetFactsStaysInTheDirectory(t *testing.T) {
+	parent := t.TempDir()
+	dir := filepath.Join(parent, "facts")
+	require.NoError(t, os.Mkdir(dir, 0o700))
+	require.NoError(t, os.Chmod(dir, 0o700))
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "a"), 0o700))
+	files := []string{
+		filepath.Join(parent, "x.json"),
+		filepath.Join(parent, "x@school.example.json"),
+		filepath.Join(dir, "a", "b@school.example.json"),
+		filepath.Join(dir, "x.json"),
+		filepath.Join(dir, "Alice@school.example.json"),
+	}
+	for _, f := range files {
+		require.NoError(t, os.WriteFile(f, []byte("{}"), 0o600))
+	}
+	broker.SetMastersOSFacts(t, dir, os.Getuid(), 5*time.Second)
+
+	for _, name := range []string{"../x", "../x@school.example", "a/b@school.example", "x", "Alice@school.example",
+		"", "/x@school.example", "..", "alice@school.example/../../x"} {
+		broker.MastersOSForgetFacts(name)
+	}
+	for _, f := range files {
+		require.FileExists(t, f, "a name that is not a login_name removes nothing")
+	}
+
+	// A login_name in a directory that fails the checks: nothing is removed either.
+	target := filepath.Join(parent, "target")
+	require.NoError(t, os.Mkdir(target, 0o700))
+	require.NoError(t, os.Chmod(target, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(target, aliceFile), []byte("{}"), 0o600))
+	link := filepath.Join(parent, "link")
+	require.NoError(t, os.Symlink(target, link))
+	broker.SetMastersOSFacts(t, link, os.Getuid(), 5*time.Second)
+	broker.MastersOSForgetFacts("alice@school.example")
+	require.FileExists(t, filepath.Join(target, aliceFile), "a symlinked directory is not followed")
+
+	broker.SetMastersOSFacts(t, target, os.Getuid()+1, 5*time.Second)
+	broker.MastersOSForgetFacts("alice@school.example")
+	require.FileExists(t, filepath.Join(target, aliceFile), "a directory of another owner is left alone")
+
+	// The control: the same login_name in a good directory is removed.
+	broker.SetMastersOSFacts(t, target, os.Getuid(), 5*time.Second)
+	broker.MastersOSForgetFacts("alice@school.example")
+	require.NoFileExists(t, filepath.Join(target, aliceFile))
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile.go b/authd-oidc-brokers/internal/broker/mastersos_profile.go
new file mode 100644
index 0000000..2f058de
--- /dev/null
+++ b/authd-oidc-brokers/internal/broker/mastersos_profile.go
@@ -0,0 +1,200 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0007-mastersos-issuer-profile.patch): the school's issuer profile.
+//
+// A MastersOS issuer names every person with a login_name claim (lowercase, one '@', admin-controlled, never reused) and
+// says which organisation the person belongs to with an org claim. With the profile on, the broker:
+//   - asks for the scopes mastersos.facts and org:<the school's id>;
+//   - takes the local user name from login_name instead of email, and needs neither email nor email_verified;
+//   - denies, before access is granted (so authd registers nobody), a token whose org is not the school's id or whose
+//     login_name is not of the expected shape.
+// Everything keyed on the user name stays as it is: the requested account must equal the authenticated one (upstream's
+// VerifyUsername, now comparing login_name), patch 0006's allowed domains, admin_users and the login hint.
+//
+// The school's id is in a plain file beside the configuration, mastersos-expected-org in the directory of broker.conf
+// (/etc/authd/oidc/mastersos-expected-org): exactly one lowercase UUID line, plus blank lines and lines starting with
+// '#'. As with patch 0006's domain file, it is not a key of broker.conf.d (a broker without this patch would refuse to
+// start), and the drop-in says the file is required with a comment line (mastersosProfileMarker). The profile is on when
+// the file is there or the marker asks for it. On, with no usable id (file missing, unreadable, too large, or not exactly
+// one lowercase UUID), every login is denied: a broker that was told to use the profile never falls back to email names.
+// With neither file nor marker nothing changes, exactly as upstream. Both are read once, when the broker starts.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	providerErrors "github.com/canonical/authd/authd-oidc-brokers/internal/providers/errors"
+	"github.com/canonical/authd/authd-oidc-brokers/internal/providers/info"
+	"github.com/canonical/authd/log"
+	"github.com/coreos/go-oidc/v3/oidc"
+)
+
+// mastersosExpectedOrgFile is the file's name, in the directory of broker.conf.
+const mastersosExpectedOrgFile = "mastersos-expected-org"
+
+// mastersosProfileMarker, a whole line of a broker.conf.d file, says the issuer profile is on.
+const mastersosProfileMarker = "# mastersos: issuer profile required (patch 0007)"
+
+// mastersosMaxExpectedOrgFile caps what is read: the agent writes one id and a comment or two.
+const mastersosMaxExpectedOrgFile = 4096
+
+// mastersosFactsScope asks the issuer for the person's facts at its userinfo endpoint.
+const mastersosFactsScope = "mastersos.facts"
+
+var (
+	mastersosUUID      = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+	mastersosLoginName = regexp.MustCompile(`^[a-z0-9._-]{1,64}@[a-z0-9.-]{1,253}$`)
+)
+
+// mastersosProfile is the issuer profile; the zero value (no file, no marker) is off. Active with an empty org denies
+// every login.
+type mastersosProfile struct {
+	active bool
+	org    string
+}
+
+// mastersosIDClaims are the profile's claims of a verified ID token.
+type mastersosIDClaims struct {
+	Sub       string
+	Org       string
+	LoginName string
+}
+
+func mastersosExpectedOrgPath(cfgPath string) string {
+	return filepath.Join(filepath.Dir(cfgPath), mastersosExpectedOrgFile)
+}
+
+// mastersosProfileRequired reports whether any file in the drop-in directory carries mastersosProfileMarker. The broker
+// has already parsed every one of them, so a directory or file that cannot be read here counts as requiring the profile.
+func mastersosProfileRequired(dropInDir string) bool {
+	entries, err := os.ReadDir(dropInDir)
+	if errors.Is(err, fs.ErrNotExist) {
+		return false
+	}
+	if err != nil {
+		return true
+	}
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		content, err := os.ReadFile(filepath.Join(dropInDir, e.Name()))
+		if err != nil {
+			return true
+		}
+		for _, line := range strings.Split(string(content), "\n") {
+			if strings.TrimSpace(line) == mastersosProfileMarker {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// mastersosReadProfile reads the expected-org file. Missing: on (with no id) only when required. There but unusable: on,
+// with no id, marker or not.
+func mastersosReadProfile(path string, required bool) mastersosProfile {
+	const denyAll = "every school sign-in is denied"
+	content, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		if required {
+			log.Warningf(context.Background(), "%s is missing but the issuer profile is on: %s", path, denyAll)
+		}
+		return mastersosProfile{active: required}
+	}
+	if err == nil && len(content) > mastersosMaxExpectedOrgFile {
+		err = errors.New("too large")
+	}
+	if err != nil {
+		log.Warningf(context.Background(), "could not read %s (%v): %s", path, err, denyAll)
+		return mastersosProfile{active: true}
+	}
+	var ids []string
+	s := bufio.NewScanner(bytes.NewReader(content))
+	for s.Scan() {
+		line := strings.TrimSpace(s.Text())
+		if line != "" && !strings.HasPrefix(line, "#") {
+			ids = append(ids, line)
+		}
+	}
+	if s.Err() != nil || len(ids) != 1 || !mastersosUUID.MatchString(ids[0]) {
+		log.Warningf(context.Background(), "%s does not hold exactly one lowercase UUID: %s", path, denyAll)
+		return mastersosProfile{active: true}
+	}
+	return mastersosProfile{active: true, org: ids[0]}
+}
+
+// mastersosLoadProfile is what the broker reads at start: the marker in broker.conf.d, then the expected-org file.
+func mastersosLoadProfile(cfgPath string) mastersosProfile {
+	return mastersosReadProfile(mastersosExpectedOrgPath(cfgPath), mastersosProfileRequired(GetDropInDir(cfgPath)))
+}
+
+// mastersosScopes are the scopes the profile adds to the authorization request: none when it is off, or when there is
+// no organisation to ask for (every login is then denied after the page, with the broker's own message).
+func mastersosScopes(p mastersosProfile) []string {
+	if !p.active || p.org == "" {
+		return nil
+	}
+	return []string{mastersosFactsScope, "org:" + p.org}
+}
+
+// mastersosLoginNameValid reports whether name has the shape of a login_name: lowercase, exactly one '@', a local part of
+// [a-z0-9._-]{1,64} and a domain of [a-z0-9.-]{1,253}. Such a name has no '/', so it is safe as a file name too.
+func mastersosLoginNameValid(name string) bool {
+	return mastersosLoginName.MatchString(name)
+}
+
+// mastersosUserInfo is used instead of the provider's GetUserInfo when the profile is on, with the verified ID token.
+func mastersosUserInfo(p mastersosProfile, idToken *oidc.IDToken) (info.User, mastersosIDClaims, error) {
+	if idToken == nil {
+		return info.User{}, mastersosIDClaims{}, mastersosDenial("Authentication failure: no ID token", errors.New("the issuer profile needs an ID token"))
+	}
+	return mastersosUserInfoFromClaims(p, idToken)
+}
+
+// mastersosUserInfoFromClaims fills the info.User fields genericprovider.GetUserInfo fills (name, home, provider ID,
+// shell, gecos), with the name from login_name. Every error is for display: the login screen shows it as the refusal.
+func mastersosUserInfoFromClaims(p mastersosProfile, claimer info.Claimer) (info.User, mastersosIDClaims, error) {
+	if p.org == "" {
+		return info.User{}, mastersosIDClaims{}, mastersosDenial("Authentication failure: school sign-in is not set up on this device",
+			errors.New("the issuer profile is on but the expected organisation is unknown"))
+	}
+
+	var claims map[string]interface{}
+	if err := claimer.Claims(&claims); err != nil {
+		return info.User{}, mastersosIDClaims{}, fmt.Errorf("failed to get ID token claims: %v", err)
+	}
+	sub, _ := claims["sub"].(string)
+	org, _ := claims["org"].(string)
+	loginName, _ := claims["login_name"].(string)
+	idClaims := mastersosIDClaims{Sub: sub, Org: org, LoginName: loginName}
+
+	if sub == "" {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: the ID token has no sub claim", errors.New("missing sub"))
+	}
+	if org != p.org {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: this account is not a member of this school",
+			fmt.Errorf("org %q is not the expected %q", org, p.org))
+	}
+	if !mastersosLoginNameValid(loginName) {
+		return info.User{}, idClaims, mastersosDenial("Authentication failure: this account has no valid login name",
+			fmt.Errorf("login_name %q does not have the expected shape", loginName))
+	}
+
+	home, _ := claims["home"].(string)
+	shell, _ := claims["shell"].(string)
+	gecos, _ := claims["name"].(string)
+	return info.NewUser(loginName, home, sub, shell, gecos, nil), idClaims, nil
+}
+
+func mastersosDenial(message string, err error) error {
+	return &providerErrors.ForDisplayError{Message: message, Err: err}
+}
diff --git a/authd-oidc-brokers/internal/broker/mastersos_profile_export_test.go b/authd-oidc-brokers/internal/broker/mastersos_profile_export_test.go
