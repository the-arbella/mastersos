-// close frees the port at once: server.Close alone misses a listener that Serve has not picked up yet.
+// authCodeCloseGrace is how long a closed flow's server still lets a response go out (MastersOS, 0008).
+const authCodeCloseGrace = 2 * time.Second
+
+// close frees the port at once: server.Close alone misses a listener that Serve has not picked up yet. MastersOS (0008):
+// the server is then shut down gracefully, not with server.Close alone, which drops active connections. The waiting flow
+// closes it as soon as handleCallback hands over the code, before handleCallback has written the "Signed in" page, so
+// server.Close could cut the browser off and leave it on a connection error. Shutdown lets a response under way finish
+// for up to authCodeCloseGrace; the server.Close after it ends whatever is still open then (after a graceful shutdown
+// it has nothing left to close). Shutdown's error is not a signal: it can report the listener closed above.
 func (f *authCodeFlow) close() {
-	_ = f.server.Close()
 	_ = f.listener.Close()
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), authCodeCloseGrace)
+		defer cancel()
+		_ = f.server.Shutdown(ctx)
+		_ = f.server.Close()
+	}()
 }
 
