+++ b/authd-oidc-brokers/internal/broker/mastersos_closegrace_test.go
@@ -0,0 +1,58 @@
+package broker
+
+// MastersOS carried patch (image/patches/authd-oidc/0008-callback-page-and-refused-port.patch).
+
+import (
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The waiting flow closes the sign-in as soon as handleCallback hands over the code, which can be before handleCallback
+// has written its page: close must free the port at once but still let a response under way reach the browser.
+func TestMastersOSAuthCodeCloseFinishesResponseUnderWay(t *testing.T) {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	addr := l.Addr().String()
+	entered, proceed := make(chan struct{}), make(chan struct{})
+	release := sync.OnceFunc(func() { close(proceed) })
+	t.Cleanup(release) // a failed assertion below must not leave the handler blocked
+	f := &authCodeFlow{listener: l, server: &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		close(entered)
+		<-proceed
+		_, _ = w.Write([]byte(authCodeDonePage))
+	})}}
+	go func() { _ = f.server.Serve(l) }()
+
+	type reply struct {
+		body string
+		err  error
+	}
+	done := make(chan reply, 1)
+	go func() {
+		res, err := http.Get("http://" + addr + "/callback")
+		if err != nil {
+			done <- reply{err: err}
+			return
+		}
+		defer res.Body.Close()
+		b, err := io.ReadAll(res.Body)
+		done <- reply{body: string(b), err: err}
+	}()
+
+	<-entered
+	f.close()
+	if c, err := net.Dial("tcp", addr); err == nil {
+		_ = c.Close()
+		t.Fatal("the port must be free as soon as the flow is closed")
+	}
+	release()
+
+	r := <-done
+	require.NoError(t, r.err, "a response under way when the flow closes must still reach the browser")
+	require.Equal(t, authCodeDonePage, r.body)
+}
