== var/lib/mastersos-public/xdg/dbus-1/services/org.gnome.Settings.service 644
[D-BUS Service]
Name=org.gnome.Settings
Exec=/bin/false

$ dconf update
$ nsenter --mount=/proc/1/ns/mnt -- mount --bind <stub> /usr/bin/gnome-terminal.real
$ nsenter --mount=/proc/1/ns/mnt -- mount --bind <stub> /usr/libexec/gnome-terminal-server
$ nsenter --mount=/proc/1/ns/mnt -- mount --bind <stub> /usr/bin/nautilus
$ nsenter --mount=/proc/1/ns/mnt -- mount --bind <stub> /usr/bin/gnome-control-center
