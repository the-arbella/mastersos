== etc/dconf/db/mastersos.d/50-mastersos 644
# Generated by mastersos-agent from the settings bundle; do not edit.

[org/gnome/shell]
favorite-apps=['google-chrome.desktop', 'mastersos-web-0c9f34d3f3eb.desktop', 'mastersos-kiosk-nwea.desktop']
disabled-extensions=['ding@rastersoft.com']
disable-user-extensions=true
allow-extension-installation=false
enabled-extensions=['ubuntu-dock@ubuntu.com', 'ubuntu-appindicators@ubuntu.com', 'tiling-assistant@ubuntu.com', 'snapd-prompting@canonical.com', 'snapd-search-provider@canonical.com', 'web-search-provider@ubuntu.com', 'mastersos-managed@mastersos.org']

[org/gnome/desktop/screensaver]
lock-enabled=true

[org/gnome/desktop/lockdown]
disable-command-line=true
user-administration-disabled=true

[org/gnome/settings-daemon/plugins/media-keys]
terminal=['']
custom-keybindings=@as []

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=true
always-center-icons=true
dock-fixed=true
dash-max-icon-size=44
show-trash=false
show-mounts=false

